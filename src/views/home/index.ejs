<!-- alerta al ingresar a la subastas  -->
<script>
  function mostrarAlerta(remateId) {
    Swal.fire({
      title: `Remate N° ${String(remateId).padStart(4, '0')}`,
      text: "Solo se puede acceder si realizaste el previo pago y estas correctamente validado",
      showCancelButton: true,
      showDenyButton: true,
      confirmButtonText: 'Siguiente',
      denyButtonText: 'Depositar',
      cancelButtonText: 'Cancelar'
    }).then((result) => {
      if (result.isConfirmed) {
        // Intentar acceder a la subasta
        fetch(`/auctions/${remateId}`)
          .then(response => {
            if (response.redirected) {
              // Si la respuesta es una redirección, significa que el usuario no está autenticado
              Swal.fire({
                title: 'INICIO DE SESIÓN OBLIGATORIA',
                text: 'Debes iniciar sesión para poder acceder a esta página',
                showCancelButton: true,
                confirmButtonText: 'Iniciar Sesión',
                cancelButtonText: 'Retroceder'
              }).then((result) => {
                if (result.isConfirmed) {
                  window.location.href = '/auth/login';
                } else if (result.dismiss === Swal.DismissReason.cancel) {
                  mostrarAlerta(remateId);
                }
              });
            } else {
              // Verificar oportunidades
              fetch('/check-opportunities', {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json'
                },
                body: JSON.stringify({ auctionId: remateId })
              })
              .then(response => response.json())
              .then(data => {
                if (data.success) {
                  // Si la validación es exitosa, redirigir al usuario a la subasta
                  window.location.href = `/auctions/${remateId}`;
                } else {
                  // Si la validación falla, mostrar alerta
                  Swal.fire({
                    icon: "warning",
                    title: "Oops...",
                    text: `No estás validado para el Remate N° ${String(remateId).padStart(4, '0')}`,
                    showCancelButton: true,
                    confirmButtonText: 'Solicitar Acceso',
                    cancelButtonText: 'Retroceder',
                    footer: '<a target="_blank" href="https://wa.link/2tmvgy">Quiero ingresar al remate</a>'
                  }).then((result) => {
                    if (result.isConfirmed) {
                      document.getElementById('metodo-pago-container').style.display = 'block';
                      Swal.close(); // Cerrar la alerta
                    } else if (result.dismiss === Swal.DismissReason.cancel) {
                      mostrarAlerta(remateId);
                    }
                  });
                }
              });
            }
          });
      } else if (result.isDenied) {
        document.getElementById('metodo-pago-container').style.display = 'block';
        Swal.close(); // Cerrar la alerta
      }
    });
  }
  document.addEventListener('DOMContentLoaded', () => {
    const btnRetroceder = document.getElementById('retroceder');
    btnRetroceder.addEventListener('click', () => {
      document.getElementById('metodo-pago-container').style.display = 'none';
      mostrarAlerta(remateId); // Ver la SweetAlert otra vez
    });
  });
</script>

<!-- verificacion de me gusta  -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const botonesMeGusta = document.querySelectorAll('.casilla-de-verificacion-me-gusta');
    botonesMeGusta.forEach((boton) => {
      const remateId = boton.getAttribute('data-remate-id');
      boton.id = `casilla-me-gusta-${remateId}`;
      const label = boton.nextElementSibling;
      label.setAttribute('for', `casilla-me-gusta-${remateId}`);

      // Verificar si el usuario ya ha dado like
      const userAuthenticated = <%= userAuthenticated ? 'true' : 'false' %>;
      if (userAuthenticated) {
        fetch(`/check-like?remateId=${remateId}`, {
          method: 'GET',
          headers: {
            'Content-Type': 'application/json'
          }
        })
        .then(response => response.json())
        .then(data => {
          if (data.liked) {
            boton.checked = true;
            label.classList.add('liked');
          }
        })
        .catch(error => {
          console.error('Error al verificar like:', error);
        });
      }

      // Añadir evento de clic para cada botón
      boton.addEventListener('change', (event) => {
        const isChecked = event.target.checked;

        if (!userAuthenticated) {
          event.target.checked = false; // Desmarcar el checkbox
          Swal.fire({
            title: 'Inicia sesión para dar Me gusta',
            text: `Debes iniciar sesión para darle me gusta a el Remate N° ${String(remateId).padStart(4, '0')}`,
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Iniciar sesión',
            cancelButtonText: 'Cancelar'
          }).then((result) => {
            if (result.isConfirmed) {
              window.location.href = '/auth/login';
            }
          });
        } else {
          fetch('/toggle-like', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({ remateId })
          })
          .then(response => response.json())
          .then(data => {
            if (data.message === 'Like añadido') {
              label.classList.add('liked');
            } else {
              label.classList.remove('liked');
            }
          })
          .catch(error => {
            console.error('Error al manejar like:', error);
          });
        }
      });
    });
  });
</script>



