<section class="subastas" id="subastas">
  <div class="contenedor_card_subastas">
    <% remates.forEach(remate=> { %>
      <div class="carta" data-remate-id="<%= remate.id %>">
        <div class="imagen-contenedor">
          <% if (remate.imagen) { %>
            <a href="/auctions/<%= remate.id %>" style="text-decoration: none;">
              <img src="data:image/jpeg;base64,<%= Buffer.from(remate.imagen).toString('base64') %>"
                alt="Imagen del inmueble" class="imagen-propiedad">
            </a>
            <% } else { %>
              <img src="/img/casa2.jfif" alt="Imagen no disponible" class="imagen-propiedad">
              <% } %>
                <div class="botones-contenedor">
                  <a href="#" class="seguimiento-button">Seguimiento</a>
                  <a href="#" class="detalle-button">Detalle</a>
                  <a href="#" class="aviso-button"
                    data-aviso-url="<%= remate.anexos.length > 0 ? remate.anexos[0].papeles_inmuebles : '#' %>">Aviso</a>
                </div>
        </div>

        <a href="/auctions/<%= remate.id %>" style="text-decoration: none;">
          <div class="contenido">
            <div class="label">
              <%= remate.categoria %>
            </div>
            <h2 class="nombre_proyecto">Edificio los canarios</h2>
            <div class="label">Dirección</div>
            <p class="direccion">
              <%= remate.ubicacion %>
            </p>
            <div class="detalles">
              <div class="detalles-item">
                <div class="label">M2</div>
                <div class="detalles-valor">
                  <%= remate.tamaño_propiedad %>
                </div>
              </div>
              <div class="detalles-item">
                <div class="label">N° Pisos</div>
                <div class="detalles-valor">
                  <%= remate.pisos %>
                </div>
              </div>
              <div class="detalles-item">
                <div class="label">N° de cuartos</div>
                <div class="detalles-valor">
                  <%= remate.N_habitacion %>
                </div>
              </div>
            </div>
            <div class="label">Precio</div>
            <div class="precio">
              <%= remate.precios %>
            </div>
          </div>
        </a>
      </div>
      <% }) %>
  </div>
</section>

