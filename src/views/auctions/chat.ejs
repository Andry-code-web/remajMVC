<script type="module">
  import { io } from "https://cdn.socket.io/4.3.2/socket.io.esm.min.js";

  const socket = io();

  // Elementos del DOM
  const formBid = document.getElementById("form-bid");
  const inputBid = document.getElementById("input-bid");
  const messages = document.getElementById("messages");
  const timerDisplay = document.getElementById("timer-display");  // To display the countdown

  // Variables
  let highestAmount = 0;
  const auctionId = <%= auction.id %>;
  const userId = "<%= user?.id || '0' %>";
  const userName = "<%= user?.usuario || 'Anónimo' %>";

  // Unirse a la sala del remate
  socket.emit("join-auction", auctionId);

  // Cargar mensajes persistentes al unirse
  socket.on("load-messages", (loadedMessages) => {
    messages.innerHTML = "";
    loadedMessages.forEach(({ monto, usuario }) => {
      const isCurrentUser = usuario === userName;
      const messageClass = isCurrentUser ? "sent" : "received";
      const item = `<li class="${messageClass}"><strong>${usuario}:</strong> USD$${monto}</li>`;
      messages.insertAdjacentHTML("beforeend", item);

      if (monto > highestAmount) {
        highestAmount = monto;
        inputBid.value = highestAmount;
      }
    });
  });

  // Escuchar mensajes en tiempo real
  socket.on("chat-message", ({ monto, usuario, remates_id }) => {
    if (remates_id === auctionId) {
      const isCurrentUser = usuario === userName;
      const messageClass = isCurrentUser ? "sent" : "received";
      const item = `<li class="${messageClass}"><strong>${usuario}:</strong> USD$${monto}</li>`;
      messages.insertAdjacentHTML("beforeend", item);

      if (monto > highestAmount) {
        highestAmount = monto;
        inputBid.value = highestAmount;
      }
    }
  });

  // Mostrar alerta de error
  socket.on("error-message", (error) => alert(error));

  // Mostrar actualización del temporizador
  socket.on("timer-update", (countdown) => {
    timerDisplay.textContent = `Tiempo restante: ${countdown}s`;
  });

socket.on("start-aution-timer",(remates_id) => {
  
