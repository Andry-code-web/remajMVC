<header class="header" id="header">
  <div class="logo-container">
    <a href="#" class="logo">
      <img src="/img/logo_header.jpeg" alt="">
    </a>
  </div>

  <!-- boton en vivo -->
  <a class="boton-vivo" href="/en_vivo" id="botonEnVivo">
    <span class="eye">
      <span class="iris">
        <span class="pupil"></span>
      </span>
    </span>
    <span class="text">EN VIVO</span>
  </a>

  <nav class="nav">
    <a href="/">INICIO</a>
    <a href="/remates/index">REMATES</a>
    <a href="/vender">VENDER</a>
    <a href="/comprar">COMPRAR</a>
    <a href="/contacto">CONTACTO</a>
  </nav>


  <!-- área del botón iniciar sesión y menú desplegable -->
  <div class="contenedor_user_login">
    <% if (user) { %>
    <div class="session">
      <button class="user_button" id="btn_menu">
        <i class="bi bi-person-circle"></i>
        <span class="username"><%= user.usuario %></span>
        <i class="bi bi-chevron-down"></i>
      </button>
      <div class="menu_desplegable" id="menu_desplegable">
        <div class="menu_header">
          <h3>Remajud</h3>
          <button class="close_button" id="btn_close">
            <i class="bi bi-x-lg"></i>
          </button>
        </div>
        <div class="menu_content">
          <ul class="menu_list">
            <li>
              <a href="/">
                <i class="bi bi-heart"></i>
                <span>Me gusta</span>
              </a>
            </li>
            <li>
              <a href="/auth/edit-profile">
                <i class="bi bi-pencil"></i>
                <span>Editar usuario</span>
              </a>
            </li>
          </ul>
        </div>
        <div class="user_profile">
          <div class="profile_info">
            <i class="bi bi-person-circle"></i>
            <div class="user_details">
              <span class="user_type">Cliente</span>
              <span class="user_name"><%= user.usuario %></span>
            </div>
          </div>
          <a href="/auth/logout" class="logout_button">
            <i class="bi bi-box-arrow-right"></i>
            <span>Cerrar Sesión</span>
          </a>
        </div>
      </div>
    </div>
    <% } else { %>
    <a href="/auth/login" class="login_button">
      <i class="bi bi-box-arrow-in-right"></i>
      <span>INICIAR SESIÓN</span>
    </a>
    <% } %>
  </div>

</header>

<!-- ventana desplegable -->
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const btnMenu = document.getElementById("btn_menu");
    const menuDesplegable = document.getElementById("menu_desplegable");
    const btnClose = document.getElementById("btn_close");

    // Mostrar/Ocultar menú
    btnMenu.addEventListener("click", (e) => {
      e.stopPropagation();
      menuDesplegable.classList.toggle("active");
    });

    // Cerrar menú con botón de cierre
    btnClose.addEventListener("click", () => {
      menuDesplegable.classList.remove("active");
    });

    // Cerrar menú al hacer clic fuera
    document.addEventListener("click", (e) => {
      if (!menuDesplegable.contains(e.target) && !btnMenu.contains(e.target)) {
        menuDesplegable.classList.remove("active");
      }
    });

    // Prevenir cierre al hacer clic dentro del menú
    menuDesplegable.addEventListener("click", (e) => {
      e.stopPropagation();
    });
  });
</script>


<!-- script boton en vivo -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const buttons = document.querySelectorAll('.boton-vivo');

    buttons.forEach(button => {
      const eye = button.querySelector('.eye');
      const iris = eye.querySelector('.iris');

      document.addEventListener('mousemove', (e) => {
        const eyeRect = eye.getBoundingClientRect();
        const eyeCenterX = eyeRect.left + eyeRect.width / 2;
        const eyeCenterY = eyeRect.top + eyeRect.height / 2;

        // Calcular el ángulo y la distancia
        const deltaX = e.clientX - eyeCenterX;
        const deltaY = e.clientY - eyeCenterY;
        const angle = Math.atan2(deltaY, deltaX);

        // Aumentar el rango de movimiento
        const maxDistance = eyeRect.width / 3;
        const distance = Math.min(
          Math.sqrt(deltaX * deltaX + deltaY * deltaY) / 10,
          maxDistance
        );

        // Calcular la nueva posición
        const x = Math.cos(angle) * distance;
        const y = Math.sin(angle) * distance;

        // Aplicar la transformación con una transición más suave
        iris.style.transform = `translate(calc(-50% + ${x}px), calc(-50% + ${y}px))`;
      });
    });
  });
</script>

<script>
   // Validación de inicio de sesión
   const botonEnVivo = document.getElementById('botonEnVivo');
   botonEnVivo.addEventListener('click', (e) => {
     e.preventDefault();
     
     // Verificar si el usuario está logueado
     const isLoggedIn = <%- user ? 'true' : 'false' %>;
     
     if (!isLoggedIn) {
       Swal.fire({
         title: '¡Acceso Restringido!',
         text: 'Debes iniciar sesión para acceder a los remates en vivo',
         icon: 'warning',
         showCancelButton: true,
         confirmButtonColor: '#3085d6',
         cancelButtonColor: '#d33',
         confirmButtonText: 'Iniciar Sesión',
         cancelButtonText: 'Cancelar'
       }).then((result) => {
         if (result.isConfirmed) {
           window.location.href = '/auth/login';
         }
       });
     } else {
       // Si está logueado, redirigir a la página en vivo
       window.location.href = '/en_vivo';
     }
   });

</script>