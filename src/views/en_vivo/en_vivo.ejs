
<!-- en_vivo.ejs -->
<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Remates en Vivo</title>
  <!-- ESTILOS EN_VIVO -->
  <link rel="stylesheet" href="/css/en_vivo/en_vivo.css" />
 
  <!-- ICONOS -->
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/remixicon@4.5.0/fonts/remixicon.css" rel="stylesheet" />
 
  <!-- ESTILOS HEADER Y FOOTER  -->
  <link rel="stylesheet" href="/css/globales/globales.css" />
</head>

<body>

  <!-- HEADER -->
  <%- include('../partials/navbar.ejs') %>

  <!-- CANVAS -->
  <canvas id="background-canvas"></canvas>

  <!-- en_vivo.ejs -->
  <section class="property-container">
    <div class="auction-grid">
      <% if (enVivoData && enVivoData.length > 0) { %>
      <% enVivoData.forEach((auction) => { %>
      <div class="auction-card">
        <div class="auction-header">
          <span class="auction-number">Remate N° <%= auction.id %></span>
        </div>

        <div class="auction-image">
          <img src="data:image/jpeg;base64,<%= auction.imagen || '' %>" alt="Imagen de propiedad" class="property-image" />
        </div>

        <div class="auction-content">
          <div class="auction-details">
            <p class="tipo_remate"><strong>TIPO DE REMATE:</strong> Judicial</p>
            <p class="lugar"><strong>LUGAR:</strong> <%= auction.ubicacion %> Perú</p>
          </div>

          <div class="auction-info">
            <h3>Presentación de Ofertas</h3>
            <p class="hora_remate">
              <i class="ri-calendar-line"></i>
              <%= new Date(auction.fecha_remate).toLocaleDateString('es-PE', {
                day: '2-digit',
                month: '2-digit',
                year: 'numeric'
              }) %>
            </p>
            <p class="hora_remate">
              <i class="ri-time-line"></i>
              <%= auction.hora_remate %>
            </p>
          </div>

          <div class="description-section">
            <h6>Descripción</h6>
            <p class="description-text"><%= auction.descripcion %></p>
          </div>

          <div class="price-section">
            <span class="price-label">Precio Base:</span>
            <p class="price-value">USD$ <%= auction.precios %></p>
          </div>

          <div class="action-buttons">
            <a href="/en_vivo/seguimiento/<%= auction.id %>" class="action-btn seguimiento">
              <i class="fas fa-chart-line"></i> Seguimiento
            </a>
            <a href="/en_vivo/detalles/<%= auction.id %>" class="action-btn detalles">
              <i class="fas fa-info-circle"></i> Detalles
            </a>
            <a href="<%= auction.anexo || '#' %>" 
              class="action-btn aviso <%= auction.anexo ? '' : 'disabled' %>" 
              target="_blank">
               <i class="fas fa-building"></i> Aviso
           </a>        
          </div>
        </div>
      </div>
      <% }); %>
      <% } else { %>
      <div class="no-results">
        <p>No se encontraron subastas en vivo.</p>
      </div>
      <% } %>
    </div>
  </section>
  
  <!-- SCRIPT EN_VIVO -->
  <script src="/js/script_en_vivo.js"></script>

  <!-- SCRIPT CANVAS -->
  <script src="/js/componentes/uvcanvas_envivo.js"></script>
  
  <!-- SCRIPT HEADER SCROLL -->
  <script>
    let lastScrollTop = 0; // Última posición de scroll
    const header = document.getElementById("header"); // Selección del encabezado

    window.addEventListener("scroll", () => {
      const currentScrollTop =
        window.scrollY || document.documentElement.scrollTop;

      // Desaparece al hacer scroll hacia abajo
      if (currentScrollTop > lastScrollTop) {
        header.style.transform = "translateY(-100%)";
        header.style.opacity = "0";
      } else {
        // Aparece al hacer scroll hacia arriba
        header.style.transform = "translateY(0)";
        header.style.opacity = "1";
      }

      lastScrollTop = currentScrollTop <= 0 ? 0 : currentScrollTop; // Previene valores negativos
    });
  </script>


  <script>
    const avisoButtons = document.querySelectorAll('.aviso-button');

    avisoButtons.forEach(button => {
      button.addEventListener('click', function(event) {
        event.preventDefault();
        const avisoUrl = this.getAttribute('data-aviso-url');
        if (avisoUrl && avisoUrl !== '#') {
          window.open(avisoUrl, '_blank');
        } else {
          Swal.fire({
            icon: 'error',
            title: 'Oops...',
            text: 'No hay enlace disponible para este aviso.',
          });
        }
      });
    });
  </script>
</body>

</html>