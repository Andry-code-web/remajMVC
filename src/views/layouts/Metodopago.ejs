    <div class="security-badges">
        <small>Enviar tu comprobante de pago a:</small>
        <div>📧 remajud@remajud.com</div>
        <div class="botones-container">
            <button class="botonsalir" id="retroceder">Retroceder</button>
            <button class="boton-enviar-comprobante" id="enviarComprobanteBoton">Enviar comprobante</button>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    // Función para cambiar de pestaña
    const switchTab = (tab) => {
        document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        document.querySelectorAll('.form-section').forEach(section => section.classList.remove('active'));
        document.querySelector(tab.dataset.tab === 'card' ? '.card-section' : '.yape-section').classList.add('active');
    };

    // Event listener para cambiar de pestaña
    document.querySelectorAll('.tab').forEach(tab => {
        tab.addEventListener('click', () => switchTab(tab));
    });

    // Event listener para el botón "Enviar comprobante"
    document.getElementById('enviarComprobanteBoton').addEventListener('click', () => {
        Swal.fire({
            title: 'Escanea el siguiente QR para enviar tu comprobante',
            text: 'Serás redirigido con un asesor de la empresa para poder comprobar tu pago y se habilitará tu ingreso.',
            imageUrl: '/img/qr_metodo_pago.png',
            imageWidth: 300,
            imageHeight: 300,
            imageAlt: 'Código QR',
            showCancelButton: true,
            confirmButtonText: 'Continuar',
            cancelButtonText: 'Retroceder'
        }).then((result) => {
            if (result.isConfirmed) {
                window.location.href = 'https://wa.link/2tmvgy';
            }
        });
    });
</script>