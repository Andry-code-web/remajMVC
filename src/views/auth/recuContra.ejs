<div class="contenedor-general">
  <div class="contenedor-formulario">
    <!-- Panel izquierdo  -->
    <div class="left-panel">
      <div class="profile-section">
        <div class="header-content">
          <h2>Recuperación de Cuenta</h2>
          <p class="subtitle">Restablecer contraseña</p>
        </div>

        <div class="info-box">
          <i class="bi bi-shield-lock"></i>
          <h3>Proceso Seguro</h3>
          <p>Te enviaremos un correo con las instrucciones para recuperar tu cuenta de forma segura.</p>
        </div>

        <div class="steps-container">
          <div class="step">
            <i class="bi bi-envelope"></i>
            <p>1. Ingresa tu correo</p>
          </div>
          <div class="step">
            <i class="bi bi-check-circle"></i>
            <p>2. Verifica tu bandeja</p>
          </div>
          <div class="step">
            <i class="bi bi-key"></i>
            <p>3. Restablece tu contraseña</p>
          </div>
        </div>

        <div class="logo-container">
<!--           <img src="/img/logo.png" alt="Logo" class="logo">
 -->        </div>
      </div>
    </div>

    <!-- Panel derecho  -->
    <div class="right-panel">
      <div class="recovery-form">
        <div class="form-header">
          <h1 class="main-title">
            <i class="bi bi-arrow-counterclockwise"></i>
            Recuperar Contraseña
          </h1>
          <p class="description">Ingresa el correo electrónico asociado a tu cuenta para recibir las instrucciones de recuperación.</p>
        </div>

        <div id="verificarCorreo">
          <form id="recoveryForm" class="verificar-correo">
            <div class="form-group">
              <input type="email" id="email" name="email" required placeholder="Correo Electrónico" class="form-control">
            </div>
            <button type="submit" class="verify-button">
              <i class="bi bi-envelope-check"></i>
              Verificar Correo
            </button>
          </form>
        </div>

        <div class="contenedor-contraseña">
          <form id="resetPasswordForm" style="display: none;">
            <input type="hidden" id="resetEmail" name="email">
            <div class="form-group">
              <input type="password" id="password" name="password" required placeholder="Nueva Contraseña" class="form-control">
            </div>
            <div class="form-group">
              <input type="password" id="confirmPassword" name="confirmPassword" required placeholder="Confirmar Contraseña" class="form-control">
            </div>
            <button type="submit" class="verify-button-contra">
              <i class="bi bi-arrow-clockwise"></i>
              Restablecer Contraseña
            </button>
          </form>
        </div>

        <!-- area soporte -->
        <div class="help-section">
          <h4>¿Necesitas ayuda?</h4>
          <p>Si tienes problemas para recuperar tu cuenta, contáctanos:</p>
          <button class="support-button" id="boton_soporte" onclick="botonSoporte()">
            <i class="bi bi-headset"></i>
            Contactar Soporte
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- COMPONENTE FOOTER -->
<%- include('../partials/footer') %>

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<!-- SweetAlert2 -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<!-- ESTILOS RECUPERACION CONTRASEÑA -->
<link rel="stylesheet" href="/css/recuContra/recuContra.css">


<script>
  document.addEventListener('DOMContentLoaded', function() {
    const recoveryForm = document.getElementById('recoveryForm');
    const resetPasswordForm = document.getElementById('resetPasswordForm');
    const resetEmailInput = document.getElementById('resetEmail');
  
    // Manejar verificación de email
    recoveryForm.addEventListener('submit', async (e) => {
      e.preventDefault();
  
      const email = document.getElementById('email').value;
  
      try {
        const response = await fetch('/auth/forgot-password', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ email })
        });
  
        const result = await response.json();
  
        if (result.success) {
          resetEmailInput.value = email;
          recoveryForm.style.display = 'none';
          resetPasswordForm.style.display = 'block';
          Swal.fire({
            icon: 'success',
            title: '¡Email verificado!',
            text: 'Ahora puedes establecer tu nueva contraseña'
          });
        } else {
          Swal.fire({
            icon: 'error',
            title: 'Error',
            text: result.message
          });
        }
      } catch (error) {
        console.error('Error:', error);
        Swal.fire({
          icon: 'error',
          title: 'Error',
          text: 'Hubo un error al procesar tu solicitud'
        });
      }
    });
  
    // Manejar restablecimiento de contraseña
    resetPasswordForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const data = {
        email: resetEmailInput.value,
        password: document.getElementById('password').value,
        confirmPassword: document.getElementById('confirmPassword').value
      };
  
      try {
        const response = await fetch('/auth/reset-password', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(data)
        });
  
        const result = await response.json();
  
        if (result.success) {
          Swal.fire({
            icon: 'success',
            title: '¡Éxito!',
            text: 'Contraseña actualizada correctamente',
            confirmButtonText: 'Ir al login'
          }).then((result) => {
            if (result.isConfirmed) {
              window.location.href = '/auth/login';
            }
          });
        } else {
          Swal.fire({
            icon: 'error',
            title: 'Error',
            text: result.message
          });
        }
      } catch (error) {
        console.error('Error:', error);
        Swal.fire({
          icon: 'error',
          title: 'Error',
          text: 'Hubo un error al actualizar la contraseña'
        });
      }
    });
  });
  </script>
<!-- mostrar alerta de contactar soporte -->
<script>
  function botonSoporte() {
    Swal.fire({
      title: "Soporte al cliente",
      text: "Para validar si eres cliente, necesitamos los siguientes datos registrados en remajud (DNI, CORREO, CELULAR, FECHA DE NACIMIENTO) y enviarlos al correo soporte@remajud.sbs, con el asunto (recuperar cuenta).",
      icon: "info",
      confirmButtonColor: "#3085d6",
      confirmButtonText: "OK"
    });
  }
</script>

