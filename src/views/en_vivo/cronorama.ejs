<div class="cronograma-container">
  <div class="navigation-tabs">
    <a href="/en_vivo/detalles/<%= auctionId %>" class="tab-link">Detalles</a>
    <a href="/en_vivo/inmuebles/<%= auctionId %>" class="tab-link">Inmuebles</a>
    <a href="/en_vivo/cronograma/<%= auctionId %>" class="tab-link active"
      >Cronograma</a
    >
  </div>

  <div class="cronograma-table">
    <table>
      <thead>
        <tr>
          <th>Actividad</th>
          <th>Fecha</th>
          <th>Hora</th>
          <th>Estado</th>
        </tr>
      </thead>
      <tbody>
        <% if (cronogramas && cronogramas.length > 0) { %> <%
        cronogramas.forEach(cronograma => { %>
        <tr>
          <td><%= cronograma.actividad %></td>
          <td><%= cronograma.fecha_actividad %></td>
          <td><%= cronograma.hora_actividad %></td>
          <td><%= cronograma.estado %></td>
        </tr>
        <% }); %> <%
       } else { %>
        <p class="no-data">No hay cronogramas disponibles.</p>
        <% } %>
      </tbody>
    </table>
  </div>

  <a href="/en_vivo" class="back-button">Volver a Remates</a>
</div>
