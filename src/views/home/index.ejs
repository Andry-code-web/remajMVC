<script>
  document.addEventListener('DOMContentLoaded', function() {
    const seguimientoButtons = document.querySelectorAll('.seguimiento-button');
    const tarjetaSeguimientoSeguimiento = document.querySelector('.tarjeta_seguimiento_seguimiento');
    const nubladoSeguimiento = document.createElement('div');
    nubladoSeguimiento.classList.add('nublado');

    seguimientoButtons.forEach(button => {
      button.addEventListener('click', function(event) {
        event.preventDefault();
        const remateId = this.closest('.carta').dataset.remateId;
        fetch(`/remate/${remateId}`)
          .then(response => response.json())
          .then(data => {
            document.body.appendChild(nubladoSeguimiento);
            tarjetaSeguimientoSeguimiento.style.display = 'block';
            fillSeguimientoCard(data);
          })
          .catch(error => console.error('Error:', error));
      });
    });

    window.hideSeguimientoCard = function() {
      tarjetaSeguimientoSeguimiento.style.display = 'none';
      document.body.removeChild(nubladoSeguimiento);
    };

    const detalleButtons = document.querySelectorAll('.detalle-button');
    const tarjetaSeguimientoDetalle = document.querySelector('.tarjeta_seguimiento_detalle');
    const nubladoDetalle = document.createElement('div');
    nubladoDetalle.classList.add('nublado');

    detalleButtons.forEach(button => {
      button.addEventListener('click', function(event) {
        event.preventDefault();
        const remateId = this.closest('.carta').dataset.remateId;
        fetch(`/remate/${remateId}`)
          .then(response => response.json())
          .then(data => {
            document.body.appendChild(nubladoDetalle);
            tarjetaSeguimientoDetalle.style.display = 'block';
            fillDetailCard(data);
          })
          .catch(error => console.error('Error:', error));
      });
    });

    window.hideDetailCard = function() {
      tarjetaSeguimientoDetalle.style.display = 'none';
      document.body.removeChild(nubladoDetalle);
    };

    const avisoButtons = document.querySelectorAll('.aviso-button');

    avisoButtons.forEach(button => {
      button.addEventListener('click', function(event) {
        event.preventDefault();
        const avisoUrl = this.getAttribute('data-aviso-url');
        if (avisoUrl && avisoUrl !== '#') {
          window.open(avisoUrl, '_blank');
        } else {
          Swal.fire({
            icon: 'error',
            title: 'Oops...',
            text: 'No hay enlace disponible para este aviso.',
          });
        }
      });
    });

    function fillDetailCard(data) {
      const detalles = data.detalles;
      const inmuebles = data.inmuebles;
      const cronograma = data.cronograma;

      // Llenar la sección de remate
      document.getElementById('expediente').textContent = detalles.expediente || 'N/A';
      document.getElementById('distrito_judicial').textContent = detalles.distrito_judicial || 'N/A';
      document.getElementById('organo_jurisdiccional').textContent = detalles.organo_juridiccional || 'N/A';
      document.getElementById('instancia').textContent = detalles.instancia || 'N/A';
      document.getElementById('juez').textContent = detalles.juez || 'N/A';
      document.getElementById('especialista').textContent = detalles.especialista || 'N/A';
      document.getElementById('materia').textContent = detalles.materia || 'N/A';
      document.getElementById('resolucion').textContent = detalles.resolucion || 'N/A';
      document.getElementById('fecha_resolucion').textContent = detalles.fecha_resolucion || 'N/A';
      document.getElementById('archivo_link').textContent = detalles.archivo || 'N/A';
      document.getElementById('convocatoria').textContent = detalles.convocatoria || 'N/A';
      document.getElementById('tipo_cambio').textContent = detalles.tipo_cambio || 'N/A';
      document.getElementById('tasacion').textContent = detalles.tasacion || 'N/A';
      document.getElementById('precio_base').textContent = detalles.precio_base || 'N/A';
      document.getElementById('incremento_ofertas').textContent = detalles.incremento_ofertas || 'N/A';
      document.getElementById('arancel').textContent = detalles.arancel || 'N/A';
      document.getElementById('oblaje').textContent = detalles.oblaje || 'N/A';
      document.getElementById('descripcion').textContent = detalles.descripcion || 'N/A';
      document.getElementById('numero_inscritos').textContent = detalles.n_inscritos || 'N/A';

      // Llenar la sección de inmuebles
      const inmueblesTableBody = document.getElementById('inmuebles_tbody');
      inmueblesTableBody.innerHTML = '';
      inmuebles.forEach(inmueble => {
        const row = document.createElement('tr');
        row.innerHTML = `
      <td>${inmueble.partida_registral}</td>
      <td>${inmueble.tipo_inmueble}</td>
      <td>${inmueble.direccion}</td>
      <td>${inmueble.carga_ogravamen}</td>
      <td>${inmueble.porcentaje_rematar}</td>
    `;
        inmueblesTableBody.appendChild(row);
      });

      // Llenar la sección de cronograma
      const cronogramaTableBody = document.getElementById('cronograma_tbody');
      cronogramaTableBody.innerHTML = '';
      cronograma.forEach((actividad, index) => {
        const row = document.createElement('tr');
        row.innerHTML = `
      <td>${index + 1}</td>
      <td>${actividad.actividad}</td>
      <td>${actividad.fecha_actividad}</td>
      <td>${actividad.fecha_actividad}</td>
    `;
        cronogramaTableBody.appendChild(row);
      });
    }

    function fillSeguimientoCard(data) {
      const seguimiento = data.seguimiento;

      // Llenar la sección de seguimiento
      document.getElementById('expediente_seguimiento').textContent = seguimiento.expediente || 'N/A';
      document.getElementById('instancia_seguimiento').textContent = seguimiento.instancia || 'N/A';
      document.getElementById('distrito_judicial_seguimiento').textContent = seguimiento.distrito_judicial || 'N/A';
      document.getElementById('organo_jurisdiccional_seguimiento').textContent = seguimiento.organo_juridiccional || 'N/A';
      document.getElementById('especialidad_seguimiento').textContent = seguimiento.especialidad || 'N/A';
      document.getElementById('convocatoria_seguimiento').textContent = seguimiento.nro_convocatoria || 'N/A';
      document.getElementById('fase_convocatoria_seguimiento').textContent = seguimiento.fase_convocatoria || 'N/A';
      document.getElementById('fecha_registro_seguimiento').textContent = seguimiento.fecha_registro || 'N/A';
      document.getElementById('estado_convocatoria_seguimiento').textContent = seguimiento.estado_convocatoria || 'N/A';
      document.getElementById('procesado_por_seguimiento').textContent = seguimiento.procesado_por || 'N/A';
      document.getElementById('reanudado_seguimiento').textContent = seguimiento.reanudado || 'N/A';
    }
  });

  function switchTab(tabId) {
    // Remove active classes
    document.querySelectorAll('.tab-button-z4521').forEach(tab => {
      tab.classList.remove('active-tab-w8901');
    });
    document.querySelectorAll('.content-panel-j3267').forEach(panel => {
      panel.classList.remove('active-panel-k5432');
    });

    // Add active class to selected tab and panel
    document.querySelector(`button[onclick="switchTab('${tabId}')"]`).classList.add('active-tab-w8901');
    document.getElementById(tabId).classList.add('active-panel-k5432');
  }
</script>

