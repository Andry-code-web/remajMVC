<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://unpkg.com/lucide@latest"></script>
<div class="contenedor-sistema-pagos-electronico">
    <div class="navegacion-metodos-transaccion">
        <div class="elemento-navegacion-activo" data-identificador-metodo="tarjeta">
            <i data-lucide="credit-card"></i>
            Tarjeta débito/crédito
        </div>
        <div class="elemento-navegacion-secundario" data-identificador-metodo="yape">
            <i data-lucide="smartphone"></i>
            Yape
        </div>
    </div>

    <div class="contenedor-principal-formularios">
        <div class="seccion-formulario-tarjeta-bancaria elemento-visible">
            <h3><i data-lucide="info"></i> Información de Cuentas</h3>
            <div class="contenedor-informacion-bancaria">
                <div class="elemento-cuenta-interbancaria">
                    <h4><i data-lucide="landmark"></i> BCP</h4>
                    <p><i data-lucide="hash"></i> CCI: 00219400212345678901</p>
                </div>
                <div class="elemento-cuenta-interbancaria">
                    <h4><i data-lucide="landmark"></i> Interbank</h4>
                    <p><i data-lucide="hash"></i> CCI: 00319400212345678902</p>
                </div>
                <div class="elemento-cuenta-interbancaria">
                    <h4><i data-lucide="landmark"></i> BBVA</h4>
                    <p><i data-lucide="hash"></i> CCI: 00119400212345678903</p>
                </div>
                <div class="elemento-cuenta-interbancaria">
                    <h4><i data-lucide="landmark"></i> Scotiabank</h4>
                    <p><i data-lucide="hash"></i> CCI: 00919400212345678904</p>
                </div>
            </div>
        </div>

        <div class="seccion-formulario-yape">
            <h3><i data-lucide="qr-code"></i> Escanea el código QR</h3>
            <div class="contenedor-codigo-qr-yape">
                <img class="visualizacion-codigo-qr" src="/img/qr_metodo_pago.png" alt="Código QR de Yape">
            </div>
            <p><i data-lucide="user"></i> Yape a: Montano Quispe Cleofer</p>
            <p><i data-lucide="dollar-sign"></i> Monto: $ 5000.00</p>
        </div>
    </div>

    <div class="seccion-seguridad-verificacion">
        <small><i data-lucide="send"></i> Enviar tu comprobante de pago a:</small>
        <div><i data-lucide="mail"></i> remajud@remajud.com</div>
        <div class="contenedor-botones-accion">
            <button class="boton-navegacion-retroceso" id="botonRetroceder">
                <i data-lucide="arrow-left"></i> Retroceder
            </button>
            <button class="boton-confirmacion-transaccion" id="botonEnviarComprobante">
                <i data-lucide="send"></i> Enviar comprobante
            </button>
        </div>
    </div>
</div>
<script>
    document.addEventListener('DOMContentLoaded', () => {
        lucide.createIcons();

        const alternarVisualizacionFormulario = (elementoNavegacion) => {
            document.querySelectorAll('.elemento-navegacion-activo, .elemento-navegacion-secundario')
                .forEach(elemento => elemento.classList.remove('elemento-navegacion-activo'));

            elementoNavegacion.classList.add('elemento-navegacion-activo');

            const identificadorMetodo = elementoNavegacion.dataset.identificadorMetodo;
            document.querySelectorAll('.seccion-formulario-tarjeta-bancaria, .seccion-formulario-yape')
                .forEach(seccion => seccion.classList.remove('elemento-visible'));

            const seccionMostrar = identificadorMetodo === 'tarjeta'
                ? '.seccion-formulario-tarjeta-bancaria'
                : '.seccion-formulario-yape';
            document.querySelector(seccionMostrar).classList.add('elemento-visible');
        };

        document.querySelectorAll('.elemento-navegacion-activo, .elemento-navegacion-secundario')
            .forEach(elementoNavegacion => {
                elementoNavegacion.addEventListener('click', () => {
                    alternarVisualizacionFormulario(elementoNavegacion);
                });
            });

        document.getElementById('botonEnviarComprobante').addEventListener('click', () => {
            Swal.fire({
                title: 'Escanea el siguiente QR para enviar tu comprobante',
                text: 'Serás redirigido con un asesor de la empresa para poder comprobar tu pago y se habilitará tu ingreso.',
                imageUrl: '/img/qr_metodo_pago.png',
                imageWidth: 300,
                imageHeight: 300,
                imageAlt: 'Código QR',
                showCancelButton: true,
                confirmButtonText: 'Continuar',
                cancelButtonText: 'Retroceder'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = 'https://wa.link/2tmvgy';
                }
            });
        });
    });
</script>