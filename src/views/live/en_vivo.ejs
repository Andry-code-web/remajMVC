<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Remates en Vivo</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/script_live.js"></script>
  <style>
     seguimiento-id {
      position: absolute;
      top: 10px;
      left: 10px;
      background-color: rgba(255, 255, 255, 0.8);
      padding: 5px 10px;
      border-radius: 5px;
    }
  </style>
</head>

<body>

  <section class="property-container container mt-4">
    <% liveData.forEach seguimiento => { %>
    <div class="card mb-3" style="max-width: 540px;">
      <div class="row g-0">
        <div class="col-md-4 position-relative">
          <img src="/img/casa2.jfif" class="img-fluid rounded-start" alt="Imagen de propiedad">
          <div class= seguimiento-id">
            <span class="fw-bold">Remate N°</span>
            <span><%= seguimiento.id %></span>
          </div>
        </div>
        <div class="col-md-8">
          <div class="card-body">
            <div class="mb-2">
              <span class="badge bg-primary">Primera Convocatoria</span>
              <span class="badge bg-secondary">Remate Simple</span>
            </div>
            <h5 class="card-title">
              <i class="fas fa-map-marker-alt text-danger"></i>
              <%= seguimiento.ubicacion %>
            </h5>
            <p class="card-text">
              <i class="fas fa-calendar text-info"></i>
              Presentación de ofertas: <%= seguimiento.fechaOfertas %>
            </p>
            <p class="card-text">
              <i class="fas fa-clock text-warning"></i>
              <%= seguimiento.hora %>
            </p>
            <h6>Descripción</h6>
            <p class="card-text"><%= seguimiento.descripcion %></p>
            <div class="mt-3">
              <strong>Precio Base:</strong>
              <p class="h4 text-primary">
                USD$ <%=  seguimiento.precioBase ?? 0).toLocaleString() %>
              </p>
            </div>
            <div class="mt-3">
              <a href="/en_vivo/seguimiento/<%= seguimiento.id %>" class="btn btn-primary card-button">Seguimiento</a>
              <a href="/en_vivo/detalles/<%= seguimiento.id %>" class="btn btn-secondary card-button" data-bs-toggle="modal" data-bs-target="#detailsModal" data-id="<%= seguimiento.id %>">Detalles</a>
              <a href="/en_vivo/pdf/<%= seguimiento.id %>" class="btn btn-success card-button">Aviso</a>
            </div>
          </div>
        </div>
      </div>
    </div>
    <% }) %>
  </section>

  <!-- Modal Seguimiento -->
<div class="modal fade" id="trackingModal" tabindex="-1" aria-labelledby="trackingModalLabel" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="trackingModalLabel">Seguimiento del Remate</h5>
          <button type="button" class="btn-close close-button" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div><strong>N° expediente:</strong> <%= seguimiento.expediente %></div>
          <div><strong>Distrito judicial:</strong> <%= seguimiento.distritoJudicial %></div>
          <div><strong>Instancia:</strong> <%= seguimiento.instancia %></div>
          <div><strong>Especialidad:</strong> <%= seguimiento.especialidad %></div>
          <div><strong>N° Convocatoria:</strong> <%= seguimiento.numeroConvocatoria %></div>
          <div><strong>Fecha de registro:</strong> <%= seguimiento.fechaRegistro %></div>
          <div><strong>Procesado por:</strong> <%= seguimiento.procesadoPor %></div>
          <div><strong>Fase convocatoria:</strong> <%= seguimiento.faseConvocatoria %></div>
          <div><strong>Estado convocatoria:</strong> <%= seguimiento.estadoConvocatoria %></div>
          <div><strong>¿Reanudado?:</strong> <%= seguimiento.reanudado %></div>
        </div>
      </div>
    </div>
  </div>
  

  <!-- Modal Detalles/Inmuebles/Cronograma -->
  <div class="modal fade" id="detailsModal" tabindex="-1" aria-labelledby="detailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="detailsModalLabel">Detalles del Remate</h5>
          <button type="button" class="btn-close close-button" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">

          <!-- botones, detalles, inmuebles, cronograma -->
          <ul class="nav nav-tabs" id="myTab" role="tablist">
            <li class="nav-item" role="presentation">
              <a href="/en_vivo/detalles/<%= seguimiento.id %>" class="nav-link active tab-button" id="detalles-tab" data-bs-toggle="tab" data-bs-target="#detalles" type="button" role="tab" aria-controls="detalles" aria-selected="true">Detalles</a>
            </li>
            <li class="nav-item" role="presentation">
              <a href="/en_vivo/inmuebles/<%= seguimiento.id %>" class="nav-link tab-button" id="inmuebles-tab" data-bs-toggle="tab" data-bs-target="#inmuebles" type="button" role="tab" aria-controls="inmuebles" aria-selected="false">Inmuebles</a>
            </li>
            <li class="nav-item" role="presentation">
              <a href="/en_vivo/cronograma/<%= seguimiento.id %>" class="nav-link tab-button" id="cronograma-tab" data-bs-toggle="tab" data-bs-target="#cronograma" type="button" role="tab" aria-controls="cronograma" aria-selected="false">Cronograma</a>
            </li>
          </ul>

          <!-- area detalles -->
          <div class="tab-content" id="myTabContent">
            <div class="tab-pane fade show active" id="detalles" role="tabpanel" aria-labelledby="detalles-tab">
              <table class="table table-striped">
                <caption>Detalles del Remate</caption>
                <tbody>
                  <tr>
                    <th>Expediente:</th>
                    <td><%= seguimiento.expediente %></td>
                  </tr>
                  <tr>
                    <th>Distrito Judicial:</th>
                    <td><%= seguimiento.distritoJudicial %></td>
                  </tr>
                  <tr>
                    <th>Órgano Jurisdiccional:</th>
                    <td><%= seguimiento.organoJurisdiccional %></td>
                  </tr>
                  <tr>
                    <th>Instancia:</th>
                    <td><%= seguimiento.instancia %></td>
                  </tr>
                  <tr>
                    <th>Juez:</th>
                    <td><%= seguimiento.juez %></td>
                  </tr>
                  <tr>
                    <th>Especialista:</th>
                    <td><%= seguimiento.especialista %></td>
                  </tr>
                  <tr>
                    <th>Materia:</th>
                    <td><%= seguimiento.materia %></td>
                  </tr>
                  <tr>
                    <th>Resolución:</th>
                    <td><%= seguimiento.resolucion %></td>
                  </tr>
                  <tr>
                    <th>Fecha Resolución:</th>
                    <td><%= seguimiento.fechaResolucion %></td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>


          <!-- area inmuebles -->
          <div class="tab-pane fade" id="inmuebles" role="tabpanel" aria-labelledby="inmuebles-tab">
            <table class="table table-striped">
              <caption>Inmuebles del Remate</caption>
              <thead>
                <tr>
                  <th>Partida Registral</th>
                  <th>Tipo Inmueble</th>
                  <th>Dirección</th>
                  <th>Carga y/o Gravamen</th>
                  <th>Porcentaje a Rematar</th>
                </tr>
              </thead>
              <tbody>
                <% seguimiento.inmuebles.forEach(inmueble => { %>
                <tr>
                  <td><%= inmueble.partidaRegistral %></td>
                  <td><%= inmueble.tipoInmueble %></td>
                  <td><%= inmueble.direccion %></td>
                  <td><%= inmueble.cargaGravamen %></td>
                  <td><%= inmueble.porcentajeRematar %></td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>

          <!-- area cronograma -->
          <div class="tab-pane fade" id="cronograma" role="tabpanel" aria-labelledby="cronograma-tab">
            <table class="table table-striped">
              <caption>Cronograma del Remate</caption>
              <thead>
                <tr>
                  <th>N°</th>
                  <th>Fase</th>
                  <th>Fecha Inicio</th>
                  <th>Fecha Fin</th>
                </tr>
              </thead>
              <tbody>
                <% seguimiento.cronograma.forEach(cronograma => { %>
                <tr>
                  <td><%= cronograma.numero %></td>
                  <td><%= cronograma.fase %></td>
                  <td><%= cronograma.fechaInicio %></td>
                  <td><%= cronograma.fechaFin %></td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
  </div>

</body>

</html>