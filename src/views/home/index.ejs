<script>
  document.addEventListener('DOMContentLoaded', function () {
    const seguimientoButtons = document.querySelectorAll('.seguimiento-button');
    const tarjetaSeguimientoSeguimiento = document.querySelector('.tarjeta_seguimiento_seguimiento');
    const nubladoSeguimiento = document.createElement('div');
    nubladoSeguimiento.classList.add('nublado');

    seguimientoButtons.forEach(button => {
      button.addEventListener('click', function (event) {
        event.preventDefault();
        document.body.appendChild(nubladoSeguimiento);
        tarjetaSeguimientoSeguimiento.style.display = 'block';
      });
    });

    window.hideSeguimientoCard = function () {
      tarjetaSeguimientoSeguimiento.style.display = 'none';
      document.body.removeChild(nubladoSeguimiento);
    };

    const detalleButtons = document.querySelectorAll('.detalle-button');
    const tarjetaSeguimientoDetalle = document.querySelector('.tarjeta_seguimiento_detalle');
    const nubladoDetalle = document.createElement('div');
    nubladoDetalle.classList.add('nublado');

    detalleButtons.forEach(button => {
      button.addEventListener('click', function (event) {
        event.preventDefault();
        document.body.appendChild(nubladoDetalle);
        tarjetaSeguimientoDetalle.style.display = 'block';
      });
    });

    window.hideDetailCard = function () {
      tarjetaSeguimientoDetalle.style.display = 'none';
      document.body.removeChild(nubladoDetalle);
    };
  });

  function switchTab(tabId) {
    // Remove active classes
    document.querySelectorAll('.tab-button-z4521').forEach(tab => {
      tab.classList.remove('active-tab-w8901');
    });
    document.querySelectorAll('.content-panel-j3267').forEach(panel => {
      panel.classList.remove('active-panel-k5432');
    });

    // Add active class to selected tab and panel
    document.querySelector(`button[onclick="switchTab('${tabId}')"]`).classList.add('active-tab-w8901');
    document.getElementById(tabId).classList.add('active-panel-k5432');
  }
</script>