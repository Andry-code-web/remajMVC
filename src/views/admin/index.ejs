

<link rel="stylesheet" href="/css/admin/admin.css">

<link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">

<!-- GRAFICOS CLIENTES -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<!-- CDN DE ICONOS REMIX -->
<link href="https://cdn.jsdelivr.net/npm/remixicon@4.5.0/fonts/remixicon.css" rel="stylesheet" />


<link rel="stylesheet" href="/css/adminhf/adminhf.css">

<div class="container">
  <header class="dashboard-header">
    <div class="header-content">
      <div>
        <h1 class="dashboard-title">Gestión de Remates</h1>
        <p class="dashboard-subtitle">Sistema de administración de propiedades</p>
      </div>
      <button onclick="abrirModalNuevoRemate()" class="btn-add-remate">
        <i class="bi bi-plus-circle"></i>
        Nuevo Remate
      </button>
    </div>
  </header>

  <div class="metrics-container">
    <div class="metric-card">
      <div class="metric-icon">
        <i class="bi bi-house-door"></i>
      </div>
      <div class="metric-info">
        <div class="metric-value" id="totalRemates">0</div>
        <div class="metric-label">Total de remates</div>
      </div>
    </div>
    <div class="metric-card">
      <div class="metric-icon">
        <i class="bi bi-graph-up"></i>
      </div>
      <div class="metric-info">
        <div class="metric-value" id="rematesActivos">0</div>
        <div class="metric-label">Remates en Curso</div>
      </div>
    </div>
    <div class="metric-card">
      <div class="metric-icon">
        <i class="bi bi-currency-dollar"></i>
      </div>
      <div class="metric-info">
        <div class="metric-value" id="montoTotal">$0</div>
        <div class="metric-label">Monto total</div>
      </div>
    </div>
  </div>



  <div class="properties-grid" id="rematesGrid">
    <% remates.forEach(function(remate) { %>
    <div class="property-card" data-id="">
      <div class="auction-number-container">
        <span class="auction-number">Remate N° </span>
      </div>

      <div class="property-image-container">
        <% if (remate.imagen) { %>
        <img src="data:image/jpeg;base64,<%= remate.imagen %>" alt="Propiedad" class="property-image">
        <% } else { %>
        <img src="/img/casa2.jfif" alt="Propiedad" class="property-image">
        <% } %>
        <span class="property-status <%= remate.estado === 'en_curso' ? 'status-active' : 'status-inactive' %>">
          <%= remate.estado %>
        </span>
      </div>
      <div class="property-buttons">
        <button class="property-button" onclick="abrirModalSegimiento(<%= remate.id %>)">Seguimiento</button>
        <button class="property-button" onclick="abrirModalDetalles(<%= remate.id %>)">Detalles</button>
        <button class="property-button" onclick="abrirModalInmuebles(<%= remate.id %>)">Inmuebles</button>
        <button class="property-button" data-remate-id="<%= remate.id %>" onclick="abrirModalcronograma(<%= remate.id %>)">
          Cronograma
          <div class="progress" style="width: 100%;">
            <div id="progress-bar-<%= remate.id %>" class="progress-bar" role="progressbar" style="width: 0%;" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
          </div>

          <div class="search-container">
            <i class="bi bi-search search-icon"></i>
            <input type="text" id="buscador" class="search-input"
              placeholder="Buscar por ubicación, precio o categoría..." onkeyup="buscarRemate()">
          </div>

          <div class="properties-grid" id="rematesGrid">
            <% remates.forEach(function(remate) { %>
              <div class="property-card" data-id="">
                <div class="auction-number-container">
                  <span class="auction-number">Remate N°  <%= remate.id %></span>
                </div>

                <div class="property-image-container">
                  <% if (remate.imagen) { %>
                    <img src="data:image/jpeg;base64,<%= remate.imagen %>" alt="Propiedad" class="property-image">
                    <% } else { %>
                      <img src="/img/casa2.jfif" alt="Propiedad" class="property-image">
                      <% } %>
                        <span
                          class="property-status <%= remate.estado === 'en_curso' ? 'status-active' : 'status-inactive' %>">
                          <%= remate.estado %>
                        </span>
                </div>
                <div class="property-buttons">
                  <button class="property-button" onclick="abrirModalSegimiento(<%= remate.id %>)">Seguimiento</button>
                  <button class="property-button" onclick="abrirModalDetalles(<%= remate.id %>)">Detalles</button>
                  <button class="property-button" onclick="abrirModalInmuebles(<%= remate.id %>)">Inmuebles</button>
                  <button class="property-button" data-remate-id="<%= remate.id %>"
                    onclick="abrirModalcronograma(<%= remate.id %>)">
                    Cronograma
                    <div class="progress" style="width: 100%;">
                      <div id="progress-bar-<%= remate.id %>" class="progress-bar" role="progressbar" style="width: 0%;"
                        aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                  </button>


      </div>
      <div class="property-content">
        <h3 class="property-title">
          <%= remate.ubicacion %>
        </h3>
        <div class="property-price">$<%= remate.precios %>
        </div>
        <div class="property-details">
          <div class="detail-item">
            <i class="bi bi-building"></i>
            <%= remate.categoria %>
          </div>
          <div class="detail-item">
            <i class="bi bi-door-closed"></i>
            <%= remate.N_habitacion %> hab.
          </div>
          <div class="detail-item">
            <i class="bi bi-droplet"></i>
            <%= remate.N_banos %> baños
          </div>
          <div class="detail-item">
            <i class="bi bi-calendar"></i>
            <%= new Date(remate.fecha_remate).toLocaleDateString() %>
          </div>
        </div>
        <p class="property-description">
          <%= remate.descripcion %>
        </p>
        <div class="property-actions">
          <button class="action-button" onclick="abrirModalEditar()">
            <i class="bi bi-pencil"></i>
            Editar
          </button>
          <button class="action-button" onclick="eliminarRemate(, '<%= remate.ubicacion %>')">
            <i class="bi bi-trash"></i>
            Eliminar
          </button>
        </div>
      </div>
    </div>
    <% }); %>
  </div>

</div>

<!-- añadir nuevo remate -->
<%- include('formNuevoremate') %>

<!-- Modal de edición -->
<%- include('editarRemate') %>

<!-- modal seguimiento -->
<%- include('formSeguimiento') %>

<!-- Modal de Detalles -->
<%- include('formDetalles') %>

<!-- Modal de Inmuebles -->
<%- include('forminmuebles') %>

<!-- MODAL CRONOGRAMA -->
<%- include('formCronograma') %>

<script>
  // Funciones de utilidad
  const formatPrice = (price) => Number(String(price).replace(/[^0-9.-]+/g, '')) || 0;

  // Gestión de métricas
  function actualizarMetricas() {
    const remates = document.querySelectorAll('.property-card');
    const totalRemates = remates.length;
    let rematesActivos = 0;
    let montoTotal = 0;

    remates.forEach(remate => {
      if (remate.querySelector('.status-active')) {
        rematesActivos++;
      }
      const precioTexto = remate.querySelector('.property-price').textContent;
      montoTotal += formatPrice(precioTexto);
    });

    document.getElementById('totalRemates').textContent = totalRemates;
    document.getElementById('rematesActivos').textContent = rematesActivos;
    document.getElementById('montoTotal').textContent = `$${montoTotal.toLocaleString()}`;
  }

  // Gestión de búsqueda
  function buscarRemate() {
    const input = document.getElementById('buscador').value.toLowerCase();
    const remates = document.querySelectorAll('.property-card');

    remates.forEach(remate => {
      const texto = remate.textContent.toLowerCase();
      remate.style.display = texto.includes(input) ? 'block' : 'none';
    });

    actualizarMetricas();
  }

  // Gestión de eliminación
  function eliminarRemate(id) {
    Swal.fire({
      title: '¿Estás seguro?',
      text: `¿Quieres eliminar el remate con ID ${id}?`,
      icon: 'warning',
      showCancelButton: true,
      confirmButtonColor: '#3085d6',
      cancelButtonColor: '#d33',
      confirmButtonText: 'Sí, eliminar',
      cancelButtonText: 'Cancelar'
    }).then((result) => {
      if (result.isConfirmed) {
        fetch(`/admin/eliminar-remate?deleteId=${id}`, {
            method: 'DELETE'
          })
          .then(response => response.json())
          .then(data => {
            if (data.success) {
              document.querySelector(`.property-card[data-id="${id}"]`).remove();
              actualizarMetricas();
              Swal.fire('Eliminado', 'El remate ha sido eliminado', 'success');
            } else {
              throw new Error(data.error || 'Error al eliminar el remate');
            }
          })
          .catch(error => {
            console.error('Error:', error);
            Swal.fire('Error', error.message, 'error');
          });
      }
    });
  }

  // Gestión de nuevo remate
  function abrirModalNuevoRemate() {
    // Mostrar el modal
    document.getElementById('modalNuevoRemate').style.display = 'block';

    // Deshabilitar el scroll del cuerpo
    document.body.classList.add('body-no-scroll');
  }

  function cerrarModalNuevoRemate() {
    // Ocultar el modal
    document.getElementById('modalNuevoRemate').style.display = 'none';

    // Limpiar el formulario y el contenedor de previsualización de imágenes
    document.getElementById('formNuevoRemate').reset();
    document.getElementById('image-preview-container').innerHTML = '';

    // Reactivar el scroll del cuerpo
    document.body.classList.remove('body-no-scroll');
  }

  // Gestión de edición de remate no funciona cerra fuera modal
  function abrirModalEditar(id) {
    fetch(`/admin/editar-remate/${id}`)
      .then(response => response.json())
      .then(data => {
        // Asignar valores a los campos del formulario
        document.getElementById('editId').value = data.id;
        document.getElementById('editUbicacion').value = data.ubicacion;
        document.getElementById('editPrecio').value = data.precios;
        document.getElementById('editCategoria').value = data.categoria;
        document.getElementById('editHabitaciones').value = data.N_habitacion;
        document.getElementById('editBanos').value = data.N_banos;
        document.getElementById('editPisos').value = data.pisos;
        document.getElementById('editFechaRemate').value = data.fecha_remate.split('T')[0];
        document.getElementById('editHoraRemate').value = data.hora_remate;
        document.getElementById('editEstado').value = data.estado;
        document.getElementById('editTamañoPropiedad').value = data.tamano_propiedad;
        document.getElementById('editPisina').value = data.pisina;
        document.getElementById('editPatio').value = data.patio;
        document.getElementById('editCocina').value = data.cocina;
        document.getElementById('editCochera').value = data.cochera;
        document.getElementById('editBalcon').value = data.balcon;
        document.getElementById('editJardin').value = data.jardin;
        document.getElementById('editComedor').value = data.comedor;
        document.getElementById('editSalaStart').value = data.sala_start;
        document.getElementById('editStudio').value = data.studio;
        document.getElementById('editLavanderia').value = data.lavanderia;
        document.getElementById('editDescripcion').value = data.descripcion;

        // Mostrar el modal
        document.getElementById('editModal').style.display = 'block';

        // Deshabilitar el scroll del cuerpo
        document.body.classList.add('body-no-scroll');
      })
      .catch(error => {
        console.error('Error:', error);
        Swal.fire('Error', 'Error al cargar los datos del remate', 'error');
      });
  }

  function cerrarModalEditar() {
    // Ocultar el modal
    document.getElementById('editModal').style.display = 'none';

    // Reactivar el scroll del cuerpo
    document.body.classList.remove('body-no-scroll');
  }

  async function guardarCambios(event) {
    event.preventDefault();

    const formData = new FormData(event.target);
    const id = document.getElementById('editId').value;

    try {
      const response = await fetch(`/admin/editar-remate/${id}`, {
        method: 'POST',
        body: formData,
      });

      const data = await response.json();

      if (data.success) {
        Swal.fire({
          title: '¡Éxito!',
          text: 'Remate actualizado correctamente',
          icon: 'success',
        }).then(() => {
          window.location.reload();
        });
      } else {
        throw new Error(data.message || 'Error al actualizar el remate');
      }
    } catch (error) {
      console.error('Error:', error);
      Swal.fire({
        title: 'Error',
        text: error.message,
        icon: 'error',
      });
    }
  }

  // Event Listeners falta cerrar fuera
  document.addEventListener('DOMContentLoaded', () => {
    actualizarMetricas();

    // Manejador para cerrar modales al hacer clic fuera
    window.onclick = function(event) {
      const modalNuevo = document.getElementById('modalNuevoRemate');
      const modalEditar = document.getElementById('editModal');

      if (event.target === modalNuevo) {
        cerrarModalNuevoRemate();
      }

      if (event.target === modalEditar) {
        cerrarModalEditar();
      }
    };

    // Manejador para la carga de imágenes
    document.getElementById('file-upload').addEventListener('change', function(event) {
      const files = event.target.files;
      const minFiles = 1;
      const maxFiles = 10;

      if (files.length < minFiles || files.length > maxFiles) {
        Swal.fire({
          icon: 'error',
          title: 'Error',
          text: `Debes subir entre ${minFiles} y ${maxFiles} fotos.`,
        });
        event.target.value = "";
        return;
      }

      const imagePreviewContainer = document.getElementById('image-preview-container');
      imagePreviewContainer.innerHTML = "";

      for (let i = 0; i < files.length; i++) {
        const file = files[i];
        const reader = new FileReader();

        reader.onload = function(e) {
          const img = document.createElement('img');
          img.src = e.target.result;
          img.className = 'preview-img';
          imagePreviewContainer.appendChild(img);
        };

        reader.readAsDataURL(file);
      }
    });

    // Obtener parámetros de URL
    const urlParams = new URLSearchParams(window.location.search);
    const success = urlParams.get('success');

    // Mostrar la alerta si la variable de éxito está presente
    if (success === 'true') {
      Swal.fire({
        title: '¡Éxito!',
        text: 'Remate creado exitosamente',
        icon: 'success'
      });
    } else if (success === 'false') {
      Swal.fire({
        title: 'Error',
        text: 'Hubo un problema al crear el remate',
        icon: 'error'
      });
    }

    // Botón de cerrar sesión admin
    document.getElementById('logout-button').addEventListener('click', function() {
      window.location.href = '/admin/logout';
    });

    // Botón de cancelar en el modal de edición
    document.querySelector('.boton_cancelar_formulario_editar').addEventListener('click', cerrarModalEditar);
  });



  // Abrir modales
  document.addEventListener('DOMContentLoaded', function() {
    const buttons = document.querySelectorAll('.property-button');
    const tarjetaDetalles = document.getElementById('tarjetaDetalles');
    const tarjetaInmuebles = document.getElementById('tarjetaInmuebles');

    const overlay = document.createElement('div');
    overlay.className = 'modal-overlay';
    document.body.appendChild(overlay);

    let activeModal = null;

    const modalMap = {
      'Detalles': tarjetaDetalles,
      'Inmuebles': tarjetaInmuebles,
    };

    function openModal(modal) {
      if (activeModal) {
        closeModal(activeModal);
      }
      modal.style.display = 'block';
      overlay.style.display = 'block';
      activeModal = modal;
      document.body.style.overflow = 'hidden';
    }

    function closeModal(modal) {
      if (modal) {
        modal.style.display = 'none';
        overlay.style.display = 'none';
        document.body.style.overflow = '';
        activeModal = null;
      }
    }

    buttons.forEach(button => {
      button.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        const buttonText = this.textContent.trim();
        const modal = modalMap[buttonText];

        if (modal) {
          openModal(modal);
        }
      });
    });

    overlay.addEventListener('click', function() {
      closeModal(activeModal);
    });

    const cancelButtons = document.querySelectorAll([
      '.boton_cancelar_formulario_detalles',
      '.boton_cancelar_formulario_inmuebles',
      '.boton_cancelar_formulario_cronograma'
    ].join(','));

    cancelButtons.forEach(button => {
      button.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        closeModal(activeModal);
      });
    });

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && activeModal) {
        closeModal(activeModal);
      }
    });

    [tarjetaDetalles, tarjetaInmuebles].forEach(modal => {
      if (modal) {
        modal.addEventListener('click', function(e) {
          e.stopPropagation();
        });
      }
    });
  });

  // Funcionalidad para el modal de Detalles
  function abrirModalDetalles(remateId) {
    const modal = document.getElementById(`tarjetaDetalles${remateId}`);
    if (!modal) return;

    // Centrar el modal
    modal.style.display = 'block';
    modal.style.position = 'fixed';
    modal.style.top = '50%';
    modal.style.left = '50%';
    modal.style.transform = 'translate(-50%, -50%)';

    // Agregar evento para cerrar el modal al hacer clic fuera
    window.addEventListener('click', cerrarModalDetallesAlHacerClickFuera);

    // Cargar datos si existe el ID
    if (remateId) {
      fetch(`/admin/detalles/${remateId}`)
        .then(response => response.json())
        .then(data => {
          // Llenar los campos del formulario con los datos
          document.getElementById(`expediente${remateId}`).value = data.expediente || '';
          document.getElementById(`distrito_judicial${remateId}`).value = data.distrito_judicial || '';
          document.getElementById(`organo_juridiccional${remateId}`).value = data.organo_juridiccional || '';
          document.getElementById(`instancia${remateId}`).value = data.instancia || '';
          document.getElementById(`juez${remateId}`).value = data.juez || '';
          document.getElementById(`especialista${remateId}`).value = data.especialista || '';
          document.getElementById(`materia${remateId}`).value = data.materia || '';
          document.getElementById(`resolucion${remateId}`).value = data.resolucion || '';
          document.getElementById(`fecha_resolucion${remateId}`).value = data.fecha_resolucion || '';
          document.getElementById(`nro_convocatoria${remateId}`).value = data.nro_convocatoria || '';
          document.getElementById(`tipo_cambio${remateId}`).value = data.tipo_cambio || '';
          document.getElementById(`tasacion${remateId}`).value = data.tasacion || '';
          document.getElementById(`precio_base${remateId}`).value = data.precio_base || '';
          document.getElementById(`incremento_ofertas${remateId}`).value = data.incremento_ofertas || '';
          document.getElementById(`arancel${remateId}`).value = data.arancel || '';
          document.getElementById(`oblaje${remateId}`).value = data.oblaje || '';
          document.getElementById(`descripcion${remateId}`).value = data.descripcion || '';
        })
        .catch(error => console.error('Error:', error));
    }
  }

  function cerrarModalDetalles() {
    const modal = document.getElementById(`tarjetaDetalles${remateId}`);
    if (modal) {
      modal.style.display = 'none';
    }

    // Quitar el evento de clic fuera
    window.removeEventListener('click', cerrarModalDetallesAlHacerClickFuera);
  }

  function cerrarModalDetallesAlHacerClickFuera(event) {
    const modal = document.getElementById(`tarjetaDetalles${remateId}`);
    if (!modal) return;

    // Verificar si el clic ocurrió fuera del contenido del modal
    if (!modal.contains(event.target) && event.target !== modal) {
      cerrarModalDetalles();
    }
  }
  // Event listeners
  document.addEventListener('DOMContentLoaded', () => {
    // Botón cancelar
    const btnCancelar = document.querySelector('.boton_cancelar_formulario_detalles');
    if (btnCancelar) {
      btnCancelar.addEventListener('click', cerrarModalDetalles);
    }

    // Cerrar al hacer click fuera del modal
    window.addEventListener('click', (e) => {
      const modal = document.getElementById(`tarjetaDetalles${remateId}`);
      if (e.target === modal) {
        cerrarModalDetalles();
      }
    });

    // Manejar el envío del formulario
    const form = document.getElementById(`formulario_detalles${remateId}`);
    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const formData = new FormData(form);

        try {
          const response = await fetch('/admin/editar-detalles', {
            method: 'POST',
            body: formData
          });

          const data = await response.json();
          if (data.success) {
            alert('Detalles guardados correctamente');
            cerrarModalDetalles();
          } else {
            throw new Error(data.message || 'Error al guardar los detalles');
          }
        } catch (error) {
          console.error('Error:', error);
          alert('Error al guardar los detalles');
        }
      });
    }
  });

  // Funcionalidad para el modal de Inmuebles
  function abrirModalInmuebles(remateId) {
    const modal = document.getElementById(`tarjetaInmuebles${remateId}`);
    if (!modal) return;

    // Centrar el modal
    modal.style.display = 'block';
    modal.style.position = 'fixed';
    modal.style.top = '50%';
    modal.style.left = '50%';
    modal.style.transform = 'translate(-50%, -50%)';

    // Agregar evento para cerrar el modal al hacer clic fuera
    window.addEventListener('click', cerrarModalInmueblesAlHacerClickFuera);

    // Cargar datos si existe el ID
    if (remateId) {
      fetch(`/admin/inmuebles/${remateId}`)
        .then(response => response.json())
        .then(data => {
          // Llenar los campos del formulario con los datos
          document.getElementById(`partida_registral${remateId}`).value = data.partida_registral || '';
          document.getElementById(`tipo_inmueble${remateId}`).value = data.tipo_inmueble || '';
          document.getElementById(`direccion${remateId}`).value = data.direccion || '';
          document.getElementById(`carga_ogravamen${remateId}`).value = data.carga_ogravamen || '';
          document.getElementById(`porcentaje_rematar${remateId}`).value = data.porcentaje_rematar || '';
        })
        .catch(error => console.error('Error:', error));
    }
  }

  function cerrarModalInmuebles() {
    const modal = document.getElementById(`tarjetaInmuebles${remateId}`);
    if (modal) {
      modal.style.display = 'none';
    }

    // Quitar el evento de clic fuera
    window.removeEventListener('click', cerrarModalInmueblesAlHacerClickFuera);
  }

  function cerrarModalInmueblesAlHacerClickFuera(event) {
    const modal = document.getElementById(`tarjetaInmuebles${remateId}`);
    if (!modal) return;

    // Verificar si el clic ocurrió fuera del contenido del modal
    if (!modal.contains(event.target) && event.target !== modal) {
      cerrarModalInmuebles();
    }
  }
  // Event listeners
  document.addEventListener('DOMContentLoaded', () => {
    // Botón cancelar
    const btnCancelar = document.querySelector('.boton_cancelar_formulario_inmuebles');
    if (btnCancelar) {
      btnCancelar.addEventListener('click', cerrarModalInmuebles);
    }

    // Cerrar al hacer click fuera del modal
    window.addEventListener('click', (e) => {
      const modal = document.getElementById(`tarjetaInmuebles${remateId}`);
      if (e.target === modal) {
        cerrarModalInmuebles();
      }
    });

    // Manejar el envío del formulario
    const form = document.getElementById(`formulario_inmuebles${remateId}`);
    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const formData = new FormData(form);

        try {
          const response = await fetch('/admin/editar-inmuebles', {
            method: 'POST',
            body: formData
          });

          const data = await response.json();
          if (data.success) {
            alert('Inmuebles guardados correctamente');
            cerrarModalInmuebles();
          } else {
            throw new Error(data.message || 'Error al guardar los inmuebles');
          }
        } catch (error) {
          console.error('Error:', error);
          alert('Error al guardar los inmuebles');
        }
      });
    }
  });
</script>

<!-- sweat alert cronograma  -->

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('formularioCronograma');

    form.addEventListener('submit', function(event) {
      event.preventDefault();

      const remateId = document.getElementById('remate_id').value;
      const fase = document.getElementById('nombre').value;
      const fechaInicio = document.getElementById('fecha_inicio').value;
      const fechaFin = document.getElementById('fecha_fin').value;

      const mensaje = `
                  ID del Remate: ${remateId}<br>
                  Fase: ${fase}<br>
                  Fecha Inicio: ${fechaInicio}<br>
                  Fecha Fin: ${fechaFin}
                `;

      Swal.fire({
        title: 'Se subirán los siguientes cambios:',
        html: mensaje,
        showCancelButton: true,
        showDenyButton: true,
        confirmButtonText: 'Aceptar',
        denyButtonText: 'Retroceder',
        cancelButtonText: 'Cancelar',
        allowOutsideClick: false,
        allowEscapeKey: false,
        allowEnterKey: false
      }).then((result) => {
        if (result.isConfirmed) {
          fetch('/admin/guardar-cronograma', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json'
              },
              body: JSON.stringify({
                remates_id: remateId,
                nombre: fase,
                fecha_inicio: fechaInicio,
                fecha_fin: fechaFin
              })
            })
            .then(response => response.json())
            .then(data => {
              if (data.message === "Cronograma guardado exitosamente") {
                actualizarProgreso(remateId);
                cerrarModalCronograma();
              } else {
                Swal.fire('Error', data.message, 'error');
              }
            })
            .catch(error => {
              console.error('Error:', error);
              Swal.fire('Error', 'Hubo un problema al guardar el cronograma', 'error');
            });
        } else if (result.isDenied) {
          // No hacer nada, el usuario quiere retroceder
        } else if (result.dismiss === Swal.DismissReason.cancel) {
          cerrarModalCronograma();
        }
      });
    });

    // Obtener el estado actual del cronograma al cargar la página
    document.querySelectorAll('.property-button').forEach(button => {
      const remateId = button.getAttribute('data-remate-id');
      fetch(`/admin/obtener-cronograma?remates_id=${remateId}`)
        .then(response => response.json())
        .then(cronograma => {
          if (cronograma.length > 0) {
            actualizarProgreso(remateId);
          }
        })
        .catch(error => {
          console.error('Error al obtener el cronograma:', error);
        });
    });
  });

  function abrirModalcronograma(remateId) {
    const overlay = document.createElement('div');
    overlay.className = 'overlay_sistema_remates';
    document.body.appendChild(overlay);

    const modal = document.getElementById('tarjetaCronograma');
    const remateIdInput = document.getElementById('remate_id');
    remateIdInput.value = remateId;
    modal.style.display = 'block';

    // Obtener el cronograma actual y filtrar las opciones del menú desplegable
    fetch(`/admin/obtener-cronograma?remates_id=${remateId}`)
      .then(response => response.json())
      .then(cronograma => {
        const select = document.getElementById('nombre');
        const options = select.options;

        for (let i = 0; i < options.length; i++) {
          if (cronograma.includes(options[i].value)) {
            options[i].style.display = 'none';
          } else {
            options[i].style.display = 'block';
          }
        }
      })
      .catch(error => {
        console.error('Error al obtener el cronograma:', error);
      });

    overlay.addEventListener('click', cerrarModalCronograma);
  }

  function cerrarModalCronograma() {
    const modal = document.getElementById('tarjetaCronograma');
    const overlay = document.querySelector('.overlay_sistema_remates');

    modal.style.display = 'none';
    if (overlay) {
      overlay.remove();
    }
  }

  function actualizarProgreso(remateId) {
    fetch(`/admin/obtener-cronograma?remates_id=${remateId}`)
      .then(response => response.json())
      .then(cronograma => {
        const progressBar = document.getElementById(`progress-bar-${remateId}`);
        let progress = 0;

        if (cronograma.includes('Publicación e Inscripción')) {
          progress = 20;
          progressBar.style.backgroundColor = 'red';
        }
        if (cronograma.includes('Validación de Inscripción')) {
          progress = 40;
          progressBar.style.backgroundColor = 'orange';
        }
        if (cronograma.includes('Presentación de Ofertas')) {
          progress = 60;
          progressBar.style.backgroundColor = 'yellow';
        }
        if (cronograma.includes('Pago Saldo')) {
          progress = 80;
          progressBar.style.backgroundColor = 'lightgreen';
        }
        if (cronograma.includes('Validación del Saldo')) {
          progress = 100;
          progressBar.style.backgroundColor = 'green';
        }

        progressBar.style.width = `${progress}%`;
        progressBar.setAttribute('aria-valuenow', progress);
      })
      .catch(error => {
        console.error('Error al obtener el cronograma:', error);
      });
  }
</script>