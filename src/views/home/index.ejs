  <main class="listaSubastasDisponibles">
    <nav aria-label="Navegación de remates">
      <ul class="pagination justify-content-end">
        <li class="page-item <%= !pagination.hasPrevPage ? 'disabled' : '' %>">
          <a class="page-link" href="?page=<%= pagination.prevPage %>" <%= !pagination.hasPrevPage ? 'tabindex="-1" aria-disabled="true"' : '' %>>
            <span aria-hidden="true">&laquo;</span>
          </a>
        </li>
        <% for(let i = 1; i <= pagination.totalPages; i++) { %>
        <li class="page-item <%= pagination.currentPage === i ? 'active' : '' %>">
          <a class="page-link" href="?page=<%= i %>"><%= i %></a>
        </li>
        <% } %>
        <li class="page-item <%= !pagination.hasNextPage ? 'disabled' : '' %>">
          <a class="page-link" href="?page=<%= pagination.nextPage %>" <%= !pagination.hasNextPage ? 'tabindex="-1" aria-disabled="true"' : '' %>>
            <span aria-hidden="true">&raquo;</span>
          </a>
        </li>
      </ul>
    </nav>
    <% remates.forEach(remate => { %>
    <div class="carta elementoSubastaIndividual">
      <div class="imagenPropiedadSubasta">
        <div class="contenedor_image">
          <% if (remate.imagen) { %>
            <a href="javascript:void(0);" style="text-decoration: none;" onclick="mostrarAlerta(<%= remate.id %>)">
            <img src="data:image/jpeg;base64,<%= remate.imagen %>" alt="Imagen del inmueble" class="imagen-propiedad">
          </a>
          <% } else { %>
          <img src="/img/casa2.jfif" alt="Imagen no disponible" class="imagen-propiedad">
          <% } %>
        </div>
      </div>
      <div class="contenidoInformativoSubasta">
        <div class="detallesEspecificosSubasta">
          <a id="informacion_general_subasta" href="javascript:void(0);" class="informacionGeneralSubasta" onclick="mostrarAlerta(<%= remate.id %>)">

            <h2>Remate N° <%= String(remate.id).padStart(4, '0') %></h2>
            <p class="tipo_remate"><strong>TIPO DE REMATE:</strong> Judicial</p>
            <p class="lugar"><strong>LUGAR:</strong>
              <%= remate.ubicacion %> Perú
            </p>
            <h3>Presentación de Ofertas</h3>
            <p class="hora_remate">
              <i class="ri-calendar-line"></i>
              <%= new Date(remate.fecha_remate).toLocaleDateString('es-PE', {
                day: '2-digit',
                month: '2-digit',
                year: 'numeric'
              }) %>
            </p>
            <p class="hora_remate">
              <i class="ri-time-line"></i></i>
              <%= remate.hora_remate %>
            </p>
            <p class="descripcion_remate"><%= remate.descripcion %></p>
          </a>
          <%
            const estados = {
              finalizado: {
                clase: '',
                texto: 'Remate Adjudicado'
              },
              en_curso: {
                clase: 'bg-success',
                texto: 'Publicacion e Inscripcion'
              }
            }
            const estadoActual = estados[remate.estado];
          %>
          <% if (estadoActual) { %>
          <div class="estadoActualSubasta <%= estadoActual.clase %> text-light">
            <p class="text-uppercase fs-5"><strong><%= remate.estado %></strong></p>
            <p><%= estadoActual.texto %></p>
          </div>
          <% } %>
          <!-- boton me gusta -->
          <input type="checkbox" id="casilla-me-gusta-<%= remate.id %>" class="casilla-de-verificacion-me-gusta" data-remate-id="<%= remate.id %>">
          <label for="casilla-me-gusta-<%= remate.id %>" class="contenedor-boton-me-gusta">
              <span class="icono-corazon-me-gusta">&#10084;</span>
          </label>
          <!-- cierre de boton me gusta -->
        </div>
        <div class="contenedorBotonesAccion">
          <div class="precio_remate">

            <p>Precio base:<i class="fa-solid fa-gavel fa-beat icono-precio"></i>
            </p>
            <p>
              S/ <%= remate.precios %>
            </p>
          </div>
          <div class="btn_acciones">
            <a href="#" class="botonAccionSubasta seguimiento-button" data-remate-id="<%= remate.id %>"><i class="fas fa-chart-line"></i> Seguimiento</a>
            <a href="#" class="botonAccionSubasta detalle-button" data-remate-id="<%= remate.id %>"> <i class="fas fa-info-circle"></i> Detalles </a>
            <a href="#" class="botonAccionSubasta aviso-button" target="_blank" data-aviso-url="<%= remate.anexos && remate.anexos.length > 0 ? remate.anexos[0].papeles_inmuebles : '#' %>">
              <i class="fas fa-building"></i> Aviso </a>
          </div>
        </div>
      </div>
    </div>
    <% }) %>
    <nav aria-label="Navegación de remates">
      <ul class="pagination justify-content-end">
        <li class="page-item <%= !pagination.hasPrevPage ? 'disabled' : '' %>">
          <a class="page-link" href="?page=<%= pagination.prevPage %>" <%= !pagination.hasPrevPage ? 'tabindex="-1" aria-disabled="true"' : '' %>>
            <span aria-hidden="true">&laquo;</span>
          </a>
        </li>
        <% for(let i = 1; i <= pagination.totalPages; i++) { %>
        <li class="page-item <%= pagination.currentPage === i ? 'active' : '' %>">
          <a class="page-link" href="?page=<%= i %>"><%= i %></a>
        </li>
        <% } %>
        <li class="page-item <%= !pagination.hasNextPage ? 'disabled' : '' %>">
          <a class="page-link" href="?page=<%= pagination.nextPage %>" <%= !pagination.hasNextPage ? 'tabindex="-1" aria-disabled="true"' : '' %>>
            <span aria-hidden="true">&raquo;</span>
          </a>
        </li>
      </ul>
    </nav>
  </main>
</div>

