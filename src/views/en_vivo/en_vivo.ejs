<!-- en_vivo.ejs -->
<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Remates en Vivo</title>
  <!-- ESTILOS EN_VIVO -->
  <link rel="stylesheet" href="/css/en_vivo/en_vivo.css" />

  <!-- ICONOS -->
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/remixicon@4.5.0/fonts/remixicon.css" rel="stylesheet" />

  <!-- ESTILOS HEADER Y FOOTER  -->
  <link rel="stylesheet" href="/css/globales/globales.css" />
</head>

<body>

  <!-- HEADER -->
  <%- include('../partials/navbar.ejs') %>

  <!-- CANVAS -->
<!--   <canvas id="background-canvas"></canvas>
 -->
  <!-- en_vivo.ejs -->
  <section class="property-container">
    <div class="auction-grid ">
      <% if (enVivoData && enVivoData.length > 0) { %>
      <% enVivoData.forEach((auction) => { %>

      <div class="parent">
        <div class="div1 content_imagen_megusta">

          <div class="auction-image">
            <p class="auction-number">Remate N° <%= auction.id %></p>
            <img src="data:image/jpeg;base64,<%= auction.imagen || '' %>" alt="Imagen no disponible" class="property-image" />
          </div>
        </div>
        <div class="div2 content_info_megusta">
          <div class="auction-content">
            <div class="auction-details">
              <p class="tipo_remate"><strong>TIPO DE REMATE:</strong> Judicial</p>
              <p class="lugar"><strong>LUGAR:</strong> <%= auction.ubicacion %> Perú</p>
            </div>

            <div class="auction-info">
              <h3>Presentación de Ofertas</h3>
              <p class="hora_remate">
                <i class="ri-calendar-line"></i>
                <%= new Date(auction.fecha_remate).toLocaleDateString('es-PE', {
                  day: '2-digit',
                  month: '2-digit',
                  year: 'numeric'
                }) %>
              </p>
              <p class="hora_remate">
                <i class="ri-time-line"></i>
                <%= auction.hora_remate %>
              </p>
            </div>

            <div class="description-section">
              <h6>Descripción</h6>
              <p class="description-text"><%= auction.descripcion %></p>
            </div>

            <div class="price-section">
              <span class="price-label">Precio Base:</span>
              <p class="price-value">USD$ <%= auction.precios %></p>
            </div>
          </div>
        </div>

        <div class="div3 content_estado_megusta">
          <!-- estado actual -->
          <% if (auction.estado == 'finalizado')  { %>
          <div class="contenedor-estado" style="background-color: red; color:white;">
            <div class="estadoActualSubasta <%= auction.clase %> text-light">
              <p class="text-uppercase fs-5"><strong><%= auction.estado %></strong></p>
              <p><%= auction.texto %></p>
            </div>
          </div>
          <% } else { %>
          <div class="contenedor-estado" style="background-color: green; color:white;">
            <div class="estadoActualSubasta <%= auction.clase %> text-light">
              <p class="text-uppercase fs-5"><strong><%= auction.estado %></strong></p>
              <p><%= auction.texto %></p>
            </div>
          </div>
          <% } %>
          <!-- estado fin -->

          <!-- boton de entrada a chat de remate -->
          <div class="content_btn_chat">
            <a href="/auctions/<%= auction.id %>" class="btn-chat">
              CHAT
            </a>
          </div>
        </div>

        <div class="div4 content_btn_seguimiento">
          <a href="/en_vivo/seguimiento/<%= auction.id %>" class="action-btn seguimiento">
            <i class="fas fa-chart-line"></i> Bases de remate
          </a>
        </div>
        <div class="div5 content_btn_detalles">
          <a href="/en_vivo/detalles/<%= auction.id %>" class="action-btn detalles">
            <i class="fas fa-info-circle"></i> Detalles
          </a>
        </div>
        <div class="div6 content_btn_aviso">
          <a href="<%= auction.anexo || '#' %>" class="action-btn aviso <%= auction.anexo ? '' : 'disabled' %>" target="_blank">
            <i class="fas fa-building"></i> Aviso
          </a>
        </div>
      </div>


      <% }); %>
      <% } else { %>
      <div class="no-results">
        <p>No se encontraron subastas en vivo.</p>
      </div>
      <% } %>
    </div>
  </section>


  <!-- SCRIPT EN_VIVO -->
  <script src="/js/script_en_vivo.js"></script>

  <!-- SCRIPT CANVAS -->
  <script src="/js/componentes/uvcanvas_envivo.js"></script>

  <!-- SCRIPT HEADER SCROLL -->
  <script>
    let lastScrollTop = 0; // Última posición de scroll
    const header = document.getElementById("header");

    window.addEventListener("scroll", () => {
      const currentScrollTop =
        window.scrollY || document.documentElement.scrollTop;

      // Desaparece al hacer scroll hacia abajo
      if (currentScrollTop > lastScrollTop) {
        header.style.transform = "translateY(-100%)";
        header.style.opacity = "0";
      } else {
        // Aparece al hacer scroll hacia arriba
        header.style.transform = "translateY(0)";
        header.style.opacity = "1";
      }

      lastScrollTop = currentScrollTop <= 0 ? 0 : currentScrollTop;
    });
  </script>


  <script>
    const avisoButtons = document.querySelectorAll('.aviso-button');

    avisoButtons.forEach(button => {
      button.addEventListener('click', function(event) {
        event.preventDefault();
        const avisoUrl = this.getAttribute('data-aviso-url');
        if (avisoUrl && avisoUrl !== '#') {
          window.open(avisoUrl, '_blank');
        } else {
          Swal.fire({
            icon: 'error',
            title: 'Oops...',
            text: 'No hay enlace disponible para este aviso.',
          });
        }
      });
    });
  </script>
</body>

</html>