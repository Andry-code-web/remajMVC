<!-- ICONOS -->
<link href="https://cdn.jsdelivr.net/npm/remixicon@4.5.0/fonts/remixicon.css" rel="stylesheet" />

<!-- ESTILOS HEADER Y FOOTER -->
<link rel="stylesheet" href="/css/globales/globales.css" />

<!-- ESTILOS TAGS -->
<link rel="stylesheet" href="/css/tags/tags.css">

<!-- HEADER -->
<%- include('../partials/navbar.ejs') %>

<!-- CANVAS -->
<!-- <canvas id="background-canvas"></canvas>
 -->
<main class="main-wrapper">
  <div class="seguimiento-container">
    <!-- Bloque de Detalle de Expediente -->
    <div class="section-block">
      <h2 class="section-title">DETALLE DE EXPEDIENTE</h2>
      <div class="seguimiento-table">
        <table>
          <thead>
            <tr>
              <th>N° Expediente</th>
              <th>Distrito Judicial</th>
              <th>Especialidad</th>
              <th>Instancia</th>
              <th>Órgano Jurisdiccional</th>
            </tr>
          </thead>
          <tbody>
            <% if (seguimientos && seguimientos.length > 0) { %>
              <% seguimientos.forEach(seguimiento => { %>
                <tr>
                  <td><%= seguimiento.expediente %></td>
                  <td><%= seguimiento.distrito_judicial %></td>
                  <td><%= seguimiento.especialidad %></td>
                  <td><%= seguimiento.instancia %></td>
                  <td><%= seguimiento.organo_juridiccional %></td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  
    <!-- Bloque de Detalle de Seguimiento -->
    <div class="section-block">
      <h2 class="section-title">DETALLE DE SEGUIMIENTO</h2>
      <div class="seguimiento-table">
        <table>
          <thead>
            <tr>
              <th>N° Convocatoria</th>
              <th>Fecha Registro</th>
              <th>Procesado por</th>
              <th>Reanudado</th>
              <th>Fase Convocatoria</th>
              <th>Estado Convocatoria</th>
            </tr>
          </thead>
          <tbody>
            <% if (seguimientos && seguimientos.length > 0) { %>
              <% seguimientos.forEach(seguimiento => { %>
                <tr>
                  <td><%= seguimiento.nro_convocatoria %></td>
                  <td><%= seguimiento.fecha_registro %></td>
                  <td><%= seguimiento.procesado_por %></td>
                  <td><%= seguimiento.reanudado %></td>
                  <td><%= seguimiento.fase_convocatoria %></td>
                  <td><%= seguimiento.estado_convocatoria %></td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="6" class="no-data">No hay seguimientos disponibles</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  
    <a href="/" class="back-button">Volver a Remates</a>
  </div>
</main>

  <!-- COMPONENTE FOOTER -->
  <%- include('../partials/footer') %>

  <!-- SCRIPT CANVAS -->
  <script src="/js/componentes/uvcanvas_envivo.js"></script>

  <!-- SCRIPT HEADER SCROLL -->
    <script>
      let lastScrollTop = 0;
      const header = document.getElementById("header");
      const seguimientoContainer = document.querySelector(".seguimiento-container");

      window.addEventListener("scroll", () => {
        const currentScrollTop =
          window.scrollY || document.documentElement.scrollTop;

        if (
          currentScrollTop > lastScrollTop &&
          currentScrollTop > seguimientoContainer.offsetTop
        ) {
          header.style.transform = "translateY(-100%)";
          header.style.opacity = "0";
        } else {
          header.style.transform = "translateY(0)";
          header.style.opacity = "1";
        }

        lastScrollTop = currentScrollTop <= 0 ? 0 : currentScrollTop;
      });
    </script>