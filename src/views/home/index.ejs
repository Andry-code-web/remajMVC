<div class="contenidoPrincipalPagina">
  <aside class="barraLateralFiltros">
    <h4>FILTROS</h4>
    <hr>
    <form action="/filtrar/" method="post" class="form_filtro">
      <div>
        <label for="numeroIdentificacionRemate">Número de Remate</label>
        <input type="text" id="numeroIdentificacionRemate" name="id">
      </div>
      <div>
        <label for="numeroExpedienteJudicial">Partida registral</label>
        <input type="text" id="numeroExpedienteJudicial" name="partida_registral">
      </div>
      <div>
        <label for="valorBasePropiedad">Precio Base</label>
        <input type="text" id="valorBasePropiedad" name="precio">
      </div>
      <div>
        <label for="ubicacionGeograficaPropiedad">Ubicación</label>
        <input type="text" id="ubicacionGeograficaPropiedad" name="ubicacion">
      </div>
      <div>
        <label for="categoria">Categoría</label>
        <input type="text" id="categoria" name="categoria">
      </div>
      <button type="submit" class="btn_filtrar">Buscar</button>
    </form>

  </aside>
  <main class="listaSubastasDisponibles">

    <nav aria-label="Navegación de remates">
      <ul class="pagination justify-content-end">
        <li class="page-item <%= !pagination.hasPrevPage ? 'disabled' : '' %>">
          <a class="page-link" href="?page=<%= pagination.prevPage %>" <%= !pagination.hasPrevPage ? 'tabindex="-1" aria-disabled="true"' : '' %>>
            <span aria-hidden="true">&laquo;</span>
          </a>
        </li>

        <% for(let i = 1; i <= pagination.totalPages; i++) { %>
        <li class="page-item <%= pagination.currentPage === i ? 'active' : '' %>">
          <a class="page-link" href="?page=<%= i %>"><%= i %></a>
        </li>
        <% } %>

        <li class="page-item <%= !pagination.hasNextPage ? 'disabled' : '' %>">
          <a class="page-link" href="?page=<%= pagination.nextPage %>" <%= !pagination.hasNextPage ? 'tabindex="-1" aria-disabled="true"' : '' %>>
            <span aria-hidden="true">&raquo;</span>
          </a>
        </li>
      </ul>
    </nav>

    <% remates.forEach(remate=> { %>
    <div class="carta elementoSubastaIndividual">
      <div class="imagenPropiedadSubasta">
        <div class="contenedor_image">
          <% if (remate.imagen) { %>
          <a href="/auctions/<%= remate.id %>" style="text-decoration: none;">
            <img src="data:image/jpeg;base64,<%= remate.imagen %>" alt="Imagen del inmueble" class="imagen-propiedad">
          </a>
          <% } else { %>
          <img src="/img/casa2.jfif" alt="Imagen no disponible" class="imagen-propiedad">
          <% } %>
        </div>
      </div>
      <div class="contenidoInformativoSubasta">
        <div class="detallesEspecificosSubasta">
          <a href="/auctions/<%= remate.id %>" class="informacionGeneralSubasta">
            <h2>Remate N°12345 - CONVOCATORIA</h2>
            <p class="tipo_remate"><strong>TIPO DE REMATE:</strong> Judicial</p>
            <p class="lugar"><strong>LUGAR:</strong>
              <%= remate.ubicacion %> Perú
            </p>
            <h3>Presentación de Ofertas</h3>
            <p class="hora_remate">
              <i class="ri-calendar-line"></i>
              <%= new Date(remate.fecha_remate).toLocaleDateString('es-PE', { 
                day: '2-digit', 
                month: '2-digit', 
                year: 'numeric' 
            }) %>

            </p>
            <p class="hora_remate">
              <i class="ri-time-line"></i></i>
              <%= remate.hora_remate %>
            </p>
            <p class="descripcion_remate"><%= remate.descripcion %></p>
          </a>

          <% 
            const estados = {
              finalizado: {
                clase: '',
                texto: 'Remate Adjudicado'
              },
              activo: {
                clase: 'bg-secondary',
                texto: 'Publicacion e Inscripcion'
              },
              en_curso: {
                clase: 'bg-success',
                texto: 'Publicacion e Inscripcion'
              }
            }

            const estadoActual = estados[remate.estado];
          %>

          <% if (estadoActual) { %>
          <div class="estadoActualSubasta <%= estadoActual.clase %> text-light">
            <p class="text-uppercase fs-5"><strong><%= remate.estado %></strong></p>
            <p><%= estadoActual.texto %></p>
          </div>
          <% } %>



        </div>
        <div class="contenedorBotonesAccion">
          <div class="precio_remate">
            <p>Precio base:</p>
            <p>
              S/ <%= remate.precios %>
            </p>
          </div>

          <div class="btn_acciones">
            <a href="#" class="botonAccionSubasta seguimiento-button">Seguimiento</a>
            <a href="#" class="botonAccionSubasta detalle-button">Detalle</a>
            <a href="#" class="botonAccionSubasta aviso-button" data-aviso-url="<%= remate.anexos && remate.anexos.length > 0 ? remate.anexos[0].papeles_inmuebles : '#' %>">
              Aviso
            </a>
          </div>
        </div>
      </div>
    </div>
    <% }) %>

    <nav aria-label="Navegación de remates">
      <ul class="pagination justify-content-end">
        <li class="page-item <%= !pagination.hasPrevPage ? 'disabled' : '' %>">
          <a class="page-link" href="?page=<%= pagination.prevPage %>" <%= !pagination.hasPrevPage ? 'tabindex="-1" aria-disabled="true"' : '' %>>
            <span aria-hidden="true">&laquo;</span>
          </a>
        </li>

        <% for(let i = 1; i <= pagination.totalPages; i++) { %>
        <li class="page-item <%= pagination.currentPage === i ? 'active' : '' %>">
          <a class="page-link" href="?page=<%= i %>"><%= i %></a>
        </li>
        <% } %>

        <li class="page-item <%= !pagination.hasNextPage ? 'disabled' : '' %>">
          <a class="page-link" href="?page=<%= pagination.nextPage %>" <%= !pagination.hasNextPage ? 'tabindex="-1" aria-disabled="true"' : '' %>>
            <span aria-hidden="true">&raquo;</span>
          </a>
        </li>
      </ul>
    </nav>
  </main>
</div>

