<!-- vistas/remates/filtrados.ejs -->

<div class="banner_remates2" id="banner_remates">
    <div id="banner" class="overlay">
      <h1>REMATES</h1>
    </div>
  </div>
  
  <div class="prueva1">
    <!-- Iteramos sobre los remates para renderizar cada tarjeta -->
    <% remates.forEach(remate => { %>
      <div class="card">
        <div class="image-container">
          <!-- Imagen del remate -->
          <img class="foto_casa" src="<%= remate.imagen %>" alt="<%= remate.titulo %>">
          
          <!-- Enlace para más información -->
          <a href="/remates/<%= remate.id %>" class="etiqueta_imagen">más información</a>
          
          <!-- Imagen de estado de la propiedad -->
          <img class="info_img" src="/img/imagen_pequeña_casa.png" alt="Info">
          <h6 class="info_img_tex"><%= remate.estado %></h6>
        </div>
        <a class="enlaces_carta" href="/remates/<%= remate.id %>">
          <div class="card-content">
            <!-- Título y descripción del remate -->
            <h2><%= remate.titulo %></h2>
            <p class="address"><%= remate.direccion %></p>
            <p class="price">$<%= remate.precio %></p>
            <p class="details"><%= remate.habitaciones %> habitaciones | <%= remate.banos %> baños | <%= remate.area %> metros</p>
          </div>
        </a>
      </div>
    <% }) %>
  </div>
  