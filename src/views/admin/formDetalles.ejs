<% remates.forEach(function(remate) { %>
  <div id="tarjetaDetalles" class="tarjeta_formulario_detalles" style="display: none">
    <h2 class="titulo_formulario_detalles">Detalles de Remate</h2>
    <form method="post" action="/admin/crear-detalles" id="formulario_detalles">
      <input name="remate_id" value="<%= remate.id %>">
  
  
      <!-- N_partida_registral -->
      <div class="fila_campos_formulario_detalles">
        <div class="columna_campo_formulario_detalles">
          <div class="grupo_campo_formulario_detalles">
            <label for="N_de_partida_registral" class="etiqueta_campo_formulario_detalles">N° partida Registral</label>
            <input type="text" id="N_de_partida_registral" name="N_de_partida_registral" class="entrada_texto_formulario_detalles" required>
          </div>
        </div>
  
      <!-- Distrito Judicial -->
        <div class="columna_campo_formulario_detalles">
          <div class="grupo_campo_formulario_detalles">
            <label for="distrito_judicial" class="etiqueta_campo_formulario_detalles">Distrito Judicial</label>
            <input type="text" id="distrito_judicial" name="distrito_judicial" class="entrada_texto_formulario_detalles" required>
          </div>
        </div>
      </div>
  
      
      <!-- Distrito -->
      <div class="fila_campos_formulario_detalles">
        <div class="columna_campo_formulario_detalles">
          <div class="grupo_campo_formulario_detalles">
            <label for="distrito" class="etiqueta_campo_formulario_detalles">Distrito</label>
            <input type="text" id="distrito" name="distrito" class="entrada_texto_formulario_detalles" required>
          </div>
        </div>
  
  
      <!-- Gravámenes -->
        <div class="columna_campo_formulario_detalles">
          <div class="grupo_campo_formulario_detalles">
            <label for="gravámenes" class="etiqueta_campo_formulario_detalles">Gravámenes</label>
            <input type="text" id="gravámenes" name="gravámenes" class="entrada_texto_formulario_detalles" required>
          </div>
        </div>
      </div>
  
  
      <!-- Convocatoria -->
      <div class="fila_campos_formulario_detalles">
        <div class="columna_campo_formulario_detalles">
          <div class="grupo_campo_formulario_detalles">
            <label for="convocatoria" class="etiqueta_campo_formulario_detalles">Convocatoria</label>
            <input type="text" id="convocatoria" name="convocatoria" class="entrada_texto_formulario_detalles" required>
          </div>
        </div>
  
  
      <!-- Garantía -->
        <div class="columna_campo_formulario_detalles">
          <div class="grupo_campo_formulario_detalles">
            <label for="garantía" class="etiqueta_campo_formulario_detalles">Garantía</label>
            <input type="number" id="garantía" name="garantía" class="entrada_texto_formulario_detalles" required>
          </div>
        </div>
      </div>
  
      <!-- Tasación -->
      <div class="fila_campos_formulario_detalles">
        <div class="columna_campo_formulario_detalles">
          <div class="grupo_campo_formulario_detalles">
            <label for="tasacion" class="etiqueta_campo_formulario_detalles">Tasación</label>
            <input type="number" id="tasacion" name="tasacion" step="0.01" class="entrada_numero_formulario_detalles" required>
          </div>
        </div>
  
      <!-- Precio Base -->
        <div class="columna_campo_formulario_detalles">
          <div class="grupo_campo_formulario_detalles">
            <label for="precio_base" class="etiqueta_campo_formulario_detalles">Precio Base</label>
            <input type="number" id="precio_base" name="precio_base" step="0.01" class="entrada_numero_formulario_detalles" required>
          </div>
        </div>
      </div>
  
      <!-- Incremento entre Ofertas -->
      <div class="fila_campos_formulario_detalles">
        <div class="columna_campo_formulario_detalles">
          <div class="grupo_campo_formulario_detalles">
            <label for="incremento_ofertas" class="etiqueta_campo_formulario_detalles">Incremento entre ofertas</label>
            <input type="number" id="incremento_ofertas" name="incremento_ofertas" step="0.01" class="entrada_numero_formulario_detalles" required>
          </div>
        </div>
  
      <!-- Remate -->
        <div class="columna_campo_formulario_detalles">
          <div class="grupo_campo_formulario_detalles">
            <label for="remate" class="etiqueta_campo_formulario_detalles">Remate</label>
            <input type="text" id="remate" name="remate" class="entrada_texto_formulario_detalles" required>
          </div>
        </div>
      </div>
  
  
      <!-- Tamaño de propiedad -->
      <div class="fila_campos_formulario_detalles">
        <div class="columna_campo_formulario_detalles">
          <div class="grupo_campo_formulario_detalles">
            <label for="tamano_propiedad" class="etiqueta_campo_formulario_detalles">Tamaño de propiedad</label>
            <input type="number" id="tamano_propiedad" name="tamano_propiedad" class="entrada_numero_formulario_detalles" required>
          </div>
        </div>
  
      <!-- N inscritos -->
        <div class="columna_campo_formulario_detalles">
          <div class="grupo_campo_formulario_detalles">
            <label for="n_inscritos" class="etiqueta_campo_formulario_detalles">N inscritos</label>
            <input type="number" id="n_inscritos" name="n_inscritos" class="entrada_numero_formulario_detalles" disabled>
          </div>
        </div>
      </div>
  
  
      <!-- Descripción de Detalles -->
      <div class="fila_campos_formulario_detalles">
        <div class="columna_campo_formulario_detalles">
          <div class="grupo_campo_formulario_detalles">
            <label for="descripcion_de_detalles" class="etiqueta_campo_formulario_detalles">Descripción de Detalles</label>
            <textarea id="descripcion_de_detalles" name="descripcion_de_detalles" class="entrada_texto_formulario_detalles" required></textarea>
          </div>
        </div>
      </div>
  
      <!-- Botones -->
      <div class="contenedor_botones_formulario_detalles">
        <button type="button" class="boton_formulario_detalles boton_cancelar_formulario_detalles" onclick="cerrarModales()">Cancelar Registro</button>
        <button type="submit" class="boton_formulario_detalles boton_guardar_formulario_detalles">Guardar Detalles</button>
      </div>
    </form>
  </div>
  <% }); %>
  
  