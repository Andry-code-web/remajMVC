<!-- Contenedor para el modal de método de pago -->
<div class="payment-modal-overlay" id="paymentModalOverlay">
  <div class="payment-modal-content">
    <%- include('../layouts/Metodopago') %>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const btnUnirse = document.getElementById('unirse');
    const chat = document.getElementById('auction-chat');
    const enCurso = document.getElementById('en_curso');
    const paymentModalOverlay = document.getElementById('paymentModalOverlay');
    const tabs = document.querySelectorAll('.active-tab');
    const contentSections = document.querySelectorAll('.active-content-section');

    function showDepositAlert() {
      return Swal.fire({
        title: 'Depósito requerido',
        text: 'Debes depositar 500 dólares para participar en 10 subastas.',
        showCancelButton: true,
        confirmButtonText: 'Ya deposité',
        cancelButtonText: 'No deposité',
        allowOutsideClick: false,
        allowEscapeKey: false,
      });
    }

    function checkOpportunities() {
      return fetch('/auctions/check-opportunities', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            auctionId: '<%= auction.id %>'
          }),
        }).then(response => response.json())
        .catch(error => {
          console.error('Error al verificar validación:', error);
          Swal.fire({
            title: 'Error',
            text: 'Error al verificar validación',
            icon: 'error',
            allowOutsideClick: false,
            allowEscapeKey: false,
          });
        });
    }

    function handleDepositConfirmation(result) {
      if (result.isConfirmed) {
        checkOpportunities().then(data => {
          if (data.success) {
            enCurso.style.display = 'none';
            chat.style.display = 'block';
          } else {
            Swal.fire({
              title: 'Error',
              text: data.message,
              icon: 'error',
              allowOutsideClick: false,
              allowEscapeKey: false,
            }).then(() => {
              if (data.message === 'No estás validado para este remate') {
                paymentModalOverlay.style.display = 'flex';
              }
            });
          }
        });
      } else if (result.dismiss === Swal.DismissReason.cancel) {
        paymentModalOverlay.style.display = 'flex';
      }
    }

    btnUnirse.addEventListener('click', () => {
      Swal.fire({
        title: 'Términos y condiciones',
        html: `
          <input type="checkbox" id="termsCheckbox">
          <label for="termsCheckbox">He leído y acepto los términos y condiciones</label>
        `,
        showCancelButton: true,
        confirmButtonText: 'Continuar',
        cancelButtonText: 'Cancelar',
        allowOutsideClick: false,
        allowEscapeKey: false,
        preConfirm: () => {
          const termsCheckbox = document.getElementById('termsCheckbox');
          if (!termsCheckbox.checked) {
            Swal.showValidationMessage('Debes marcar la casilla de los términos y condiciones');
            return false;
          }
          return true;
        }
      }).then((result) => {
        if (result.isConfirmed) {
          showDepositAlert().then(handleDepositConfirmation);
        }
      });
    });

    const btnRetroceder = document.getElementById('retroceder');
    btnRetroceder.addEventListener('click', () => {
      paymentModalOverlay.style.display = 'none';
      Swal.fire({
        title: 'Términos y condiciones',
        html: `
          <input type="checkbox" id="termsCheckbox">
          <label for="termsCheckbox">He leído y acepto los términos y condiciones</label>
        `,
        showCancelButton: true,
        confirmButtonText: 'Continuar',
        cancelButtonText: 'Cancelar',
        allowOutsideClick: false,
        allowEscapeKey: false,
        preConfirm: () => {
          const termsCheckbox = document.getElementById('termsCheckbox');
          if (!termsCheckbox.checked) {
            Swal.showValidationMessage('Debes marcar la casilla de los términos y condiciones');
            return false;
          }
          return true;
        }
      }).then((result) => {
        if (result.isConfirmed) {
          showDepositAlert().then(handleDepositConfirmation);
        }
      });
    });

    function closePaymentModal() {
      paymentModalOverlay.style.display = 'none';
    }

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const tabId = tab.getAttribute('data-tab');
        tabs.forEach(t => t.classList.remove('active'));
        contentSections.forEach(cs => cs.classList.remove('active'));
        tab.classList.add('active');
        document.getElementById(tabId).classList.add('active');
      });
    });

    // Fetch top bids and update the classification table
    const auctionId = '<%= auction.id %>';
    fetch(`/auctions/${auctionId}/top-bids`)
      .then(response => response.json())
      .then(data => {
        const bidsTableBody = document.getElementById('bids-table-body');
        bidsTableBody.innerHTML = '';
        data.forEach((bid, index) => {
          const row = document.createElement('tr');
          let positionEmoji = '';
          if (index === 0) {
            positionEmoji = '👑';
          } else if (index === 1) {
            positionEmoji = '🥈';
          } else if (index === 2) {
            positionEmoji = '🥉';
          } else {
            positionEmoji = `${index + 1}`;
          }
          row.innerHTML = `
            <td class="position">${positionEmoji}</td>
            <td>${bid.usuario}</td>
            <td class="amount">USD$ ${bid.monto}</td>
          `;
          bidsTableBody.appendChild(row);
        });
      })
      .catch(error => {
        console.error('Error al obtener las mejores ofertas:', error);
      });
  });
</script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.1/moment.min.js"></script>



<script type="module">
  import { io } from "https://cdn.socket.io/4.3.2/socket.io.esm.min.js";

  const socket = io();
  const timerDisplay = document.getElementById("countdown-timer");
  const formBid = document.getElementById("form-bid");
  const inputBid = document.getElementById("input-bid");
  const recommendedBid = document.getElementById("recommended-bid");
  const recommendedSubmitBtn = document.getElementById("recommended-submit-btn");
  const messages = document.getElementById("messages");

  let highestAmount = 0;
  let basePrice = 0;
  const auctionId = <%- auction.id %>;
  const userId = "<%- user?.id || '0' %>";
  const userName = "<%- user?.usuario || 'Anónimo' %>";

  // Función para obtener el precio base desde la base de datos
  async function getBasePrice() {
    try {
      const response = await fetch(`db/remates/precios/${auctionId}`);
      const data = await response.json();

      if (data.success) {
        basePrice = parseInt(data.precios, 10); // Asegurarse de que el precio base sea un entero
        // Actualiza el precio base en el DOM
        const priceDisplay = document.querySelector("#chat p:first-of-type");
        priceDisplay.textContent = `Precio base: S/${basePrice.toLocaleString()}`;
      } else {
        throw new Error(data.message || "No se pudo obtener el precio base.");
      }
    } catch (error) {
      console.error("Error al obtener el precio base:", error);
      Swal.fire({
        title: "Error",
        text: "Ocurrió un problema al obtener el precio base.",
        icon: "error",
        confirmButtonColor: "#3085d6",
        confirmButtonText: "Entendido",
      });
    }
  }

  socket.emit("join-auction", auctionId);

  socket.on("load-messages", (loadedMessages) => {
    messages.innerHTML = "";
    loadedMessages.forEach(({ monto, usuario }) => {
      addMessageToDOM(usuario, monto);
    });
    scrollToBottom();
  });

  socket.on("chat-message", ({ monto, usuario, remates_id }) => {
    if (remates_id === auctionId) {
      addMessageToDOM(usuario, monto);
      scrollToBottom();
    }
  });

  socket.on("timer-update", (remaining) => {
  const auctionChat = document.getElementById("auction-chat1");
  const timerDisplay = document.getElementById("countdown-timer");

  const hours = Math.floor(remaining / 3600);
  const minutes = Math.floor((remaining % 3600) / 60);
  const seconds = remaining % 60;

  timerDisplay.textContent = `${hours.toString().padStart(2, "0")}:${minutes.toString().padStart(2, "0")}:${seconds.toString().padStart(2, "0")}`;

  // Si el tiempo restante es 0, el chat está inhabilitado
  if (remaining <= 0) {
    timerDisplay.style.color = "red"; // Color rojo cuando el chat está inhabilitado
  } else {
    timerDisplay.style.color = "black"; // Color negro cuando el chat está habilitado
  }

  // Si el tiempo restante es mayor o igual a 0, mostrar el chat
  if (remaining >= 0) {
    auctionChat.style.display = "block";
  }
});

  socket.on("alert-auction-ended", ({ message }) => {
    Swal.fire({
      title: "Subasta finalizada",
      text: message,
      icon: "success",
      confirmButtonColor: "#3085d6",
      confirmButtonText: "Aceptar",
    }).then(() => {
      window.location.reload("index");
    });
  });

  formBid.addEventListener("submit", async (e) => {
    e.preventDefault();
    const amount = parseInt(inputBid.value.replace(/,/g, ''), 10); // Asegurarse de que el monto sea un entero

    // Validar que el monto sea un número válido
    if (isNaN(amount) || amount <= 0) {
      showError("Entrada inválida", "Por favor, ingresa un monto válido.");
      return;
    }

    // Validar que el monto ingresado manualmente sea mayor al último monto enviado
    if (amount <= highestAmount) {
      showError("Oferta inválida", `La oferta debe ser mayor a USD$${highestAmount.toLocaleString()}.`);
      return;
    }

    // Calcular la oferta recomendada
    const recommendedAmount = highestAmount + 100;

    // Determinar el monto final a enviar
    let finalAmount = amount;
    if (amount <= recommendedAmount) {
      finalAmount = recommendedAmount;
    }

    // Validar que el monto final sea mayor al monto más alto y al precio base
    const minAmount = Math.max(highestAmount, basePrice);
    if (finalAmount <= minAmount) {
      showError("Oferta inválida", `La oferta debe ser mayor a USD$${minAmount.toLocaleString()}.`);
      return;
    }

    // Confirmación antes de enviar la oferta
    Swal.fire({
      title: "¿Estás seguro?",
      text: `Estás a punto de ofertar USD$${finalAmount.toLocaleString()}.`,
      icon: "warning",
      showCancelButton: true,
      confirmButtonColor: "#3085d6",
      cancelButtonColor: "#d33",
      confirmButtonText: "Sí, ofertar",
      cancelButtonText: "Cancelar",
    }).then((result) => {
      if (result.isConfirmed) {
        socket.emit("chat-message", {
          monto: finalAmount,
          usuarios_id: userId,
          remates_id: auctionId,
        });
        inputBid.value = finalAmount; // Actualizar el campo de entrada con el monto final
        updateInputDisplay(finalAmount); // Actualizar la visualización del input
      }
    });
  });

  // Manejar el botón de oferta sugerida
  recommendedSubmitBtn.addEventListener("click", async () => {
    const recommendedAmount = highestAmount + 100;

    // Validar que el monto final sea mayor al monto más alto y al precio base
    const minAmount = Math.max(highestAmount, basePrice);
    if (recommendedAmount <= minAmount) {
      showError("Oferta inválida", `La oferta debe ser mayor a USD$${minAmount.toLocaleString()}.`);
      return;
    }

    // Confirmación antes de enviar la oferta
    Swal.fire({
      title: "¿Estás seguro?",
      text: `Estás a punto de ofertar USD$${recommendedAmount.toLocaleString()}.`,
      icon: "warning",
      showCancelButton: true,
      confirmButtonColor: "#3085d6",
      cancelButtonColor: "#d33",
      confirmButtonText: "Sí, ofertar",
      cancelButtonText: "Cancelar",
    }).then((result) => {
      if (result.isConfirmed) {
        socket.emit("chat-message", {
          monto: recommendedAmount,
          usuarios_id: userId,
          remates_id: auctionId,
        });
        inputBid.value = recommendedAmount; // Actualizar el campo de entrada con el monto final
        updateInputDisplay(recommendedAmount); // Actualizar la visualización del input
        recommendedBid.value = `USD$${recommendedAmount.toLocaleString()}`; // Actualizar el campo de entrada recomendado
      }
    });
  });

  // Función para mostrar mensajes de error
  function showError(title, text) {
    Swal.fire({
      title,
      text,
      icon: "error",
      confirmButtonColor: "#3085d6",
      confirmButtonText: "Entendido",
    });
  }

  // Función para agregar mensajes al DOM
  function addMessageToDOM(usuario, monto) {
    const isCurrentUser = usuario === userName;
    const messageClass = isCurrentUser ? "sent" : "received";
    messages.insertAdjacentHTML(
      "beforeend",
      `<li class="${messageClass}"><strong>${usuario}:</strong> USD$${monto.toLocaleString()}</li>`
    );
    if (monto > highestAmount) {
      highestAmount = monto;
      inputBid.value = (highestAmount + 100); // Actualizar el valor del input con el monto más alto + 100
      updateInputDisplay(highestAmount + 100); // Actualizar la visualización del input
      recommendedBid.value = `USD$${(highestAmount + 100).toLocaleString()}`; // Actualizar el campo de entrada recomendado
      highlightHighestAmount();
    }
  }

  // Resaltar el monto más alto
  function highlightHighestAmount() {
    inputBid.classList.add("highlight");
    setTimeout(() => inputBid.classList.remove("highlight"), 1000);
  }

  // Función para desplazarse al último mensaje
  function scrollToBottom() {
    messages.scrollTop = messages.scrollHeight;
  }

  // Manejo de errores de conexión con Socket.io
  socket.on("connect_error", (error) => {
    console.error("Socket error:", error);
    showError("Error de conexión", "Ocurrió un problema con la conexión al servidor.");
  });

  // Asegurarse de que el input solo acepte números y mantenga el formato de miles
  inputBid.addEventListener("input", (e) => {
    let value = e.target.value.replace(/[^0-9]/g, ''); // Eliminar cualquier carácter que no sea un número
    if (value) {
      value = parseInt(value, 10); // Convertir a número entero
      e.target.value = value; // Mantener el valor interno como un número
      updateInputDisplay(value); // Actualizar la visualización del input
    } else {
      e.target.value = ''; // Si el valor es vacío, dejar el input vacío
    }
  });

  // Función para actualizar la visualización del input con formato de miles
  function updateInputDisplay(value) {
    inputBid.setAttribute('data-value', value.toLocaleString());
  }

</script>









