                            <script>
                              // Funciones de utilidad
                              const formatPrice = (price) => Number(String(price).replace(/[^0-9.-]+/g, '')) || 0;

                              // Gestión de métricas
                              function actualizarMetricas() {
                                const remates = document.querySelectorAll('.property-card');
                                const totalRemates = remates.length;
                                let rematesActivos = 0;
                                let montoTotal = 0;

                                remates.forEach(remate => {
                                  if (remate.querySelector('.status-active')) {
                                    rematesActivos++;
                                  }
                                  const precioTexto = remate.querySelector('.property-price').textContent;
                                  montoTotal += formatPrice(precioTexto);
                                });

                                document.getElementById('totalRemates').textContent = totalRemates;
                                document.getElementById('rematesActivos').textContent = rematesActivos;
                                document.getElementById('montoTotal').textContent = `$${montoTotal.toLocaleString()}`;
                              }

                              // Gestión de búsqueda
                              function buscarRemate() {
                                const input = document.getElementById('buscador').value.toLowerCase();
                                const remates = document.querySelectorAll('.property-card');

                                remates.forEach(remate => {
                                  const texto = remate.textContent.toLowerCase();
                                  remate.style.display = texto.includes(input) ? 'block' : 'none';
                                });

                                actualizarMetricas();
                              }

                              // Gestión de eliminación
                              function eliminarRemate(id) {
                                Swal.fire({
                                  title: '¿Estás seguro?',
                                  text: `¿Quieres eliminar el remate con ID ${id}?`,
                                  icon: 'warning',
                                  showCancelButton: true,
                                  confirmButtonColor: '#3085d6',
                                  cancelButtonColor: '#d33',
                                  confirmButtonText: 'Sí, eliminar',
                                  cancelButtonText: 'Cancelar'
                                }).then((result) => {
                                  if (result.isConfirmed) {
                                    fetch(`/admin/eliminar-remate?deleteId=${id}`, {
                                      method: 'DELETE'
                                    })
                                      .then(response => response.json())
                                      .then(data => {
                                        if (data.success) {
                                          document.querySelector(`.property-card[data-id="${id}"]`).remove();
                                          actualizarMetricas();
                                          Swal.fire('Eliminado', 'El remate ha sido eliminado', 'success');
                                        } else {
                                          throw new Error(data.error || 'Error al eliminar el remate');
                                        }
                                      })
                                      .catch(error => {
                                        console.error('Error:', error);
                                        Swal.fire('Error', error.message, 'error');
                                      });
                                  }
                                });
                              }

                              // Gestión de nuevo remate
                              function abrirModalNuevoRemate() {
                                document.getElementById('modalNuevoRemate').style.display = 'block';
                              }

                              function cerrarModalNuevoRemate() {
                                document.getElementById('modalNuevoRemate').style.display = 'none';
                                document.getElementById('formNuevoRemate').reset();
                                document.getElementById('image-preview-container').innerHTML = '';
                              }

                              // Gestión de edición de remate
                              function abrirModalEditar(id) {
                                fetch(`/admin/editar-remate/${id}`)
                                  .then(response => response.json())
                                  .then(data => {
                                    document.getElementById('editId').value = data.id;
                                    document.getElementById('editUbicacion').value = data.ubicacion;
                                    document.getElementById('editPrecio').value = data.precios;
                                    document.getElementById('editCategoria').value = data.categoria;
                                    document.getElementById('editHabitaciones').value = data.N_habitacion;
                                    document.getElementById('editBanos').value = data.N_banos;
                                    document.getElementById('editPisos').value = data.pisos;
                                    document.getElementById('editFechaRemate').value = data.fecha_remate.split('T')[0];
                                    document.getElementById('editHoraRemate').value = data.hora_remate;
                                    document.getElementById('editEstado').value = data.estado;
                                    document.getElementById('editTamañoPropiedad').value = data.tamano_propiedad;
                                    document.getElementById('editPisina').value = data.pisina;
                                    document.getElementById('editPatio').value = data.patio;
                                    document.getElementById('editCocina').value = data.cocina;
                                    document.getElementById('editCochera').value = data.cochera;
                                    document.getElementById('editBalcon').value = data.balcon;
                                    document.getElementById('editJardin').value = data.jardin;
                                    document.getElementById('editComedor').value = data.comedor;
                                    document.getElementById('editSalaStart').value = data.sala_start;
                                    document.getElementById('editStudio').value = data.studio;
                                    document.getElementById('editLavanderia').value = data.lavanderia;
                                    document.getElementById('editDescripcion').value = data.descripcion;

                                    document.getElementById('editModal').style.display = 'block';
                                  })
                                  .catch(error => {
                                    console.error('Error:', error);
                                    Swal.fire('Error', 'Error al cargar los datos del remate', 'error');
                                  });
                              }

                              function cerrarModalEditar() {
                                document.getElementById('editModal').style.display = 'none';
                              }

                              async function guardarCambios(event) {
                                event.preventDefault();

                                const formData = new FormData(event.target);
                                const id = document.getElementById('editId').value;

                                try {
                                  const response = await fetch(`/admin/editar-remate/${id}`, {
                                    method: 'POST',
                                    body: formData
                                  });

                                  const data = await response.json();

                                  if (data.success) {
                                    Swal.fire({
                                      title: '¡Éxito!',
                                      text: 'Remate actualizado correctamente',
                                      icon: 'success'
                                    }).then(() => {
                                      window.location.reload();
                                    });
                                  } else {
                                    throw new Error(data.message || 'Error al actualizar el remate');
                                  }
                                } catch (error) {
                                  console.error('Error:', error);
                                  Swal.fire({
                                    title: 'Error',
                                    text: error.message,
                                    icon: 'error'
                                  });
                                }
                              }

                              // Event Listeners
                              document.addEventListener('DOMContentLoaded', () => {
                                actualizarMetricas();

                                // Manejador para cerrar modales al hacer clic fuera
                                window.onclick = function (event) {
                                  const modalNuevo = document.getElementById('modalNuevoRemate');
                                  const modalEditar = document.getElementById('editModal');

                                  if (event.target === modalNuevo) {
                                    cerrarModalNuevoRemate();
                                  }

                                  if (event.target === modalEditar) {
                                    cerrarModalEditar();
                                  }
                                };

                                // Manejador para la carga de imágenes
                                document.getElementById('file-upload').addEventListener('change', function (event) {
                                  const files = event.target.files;
                                  const minFiles = 1;
                                  const maxFiles = 10;

                                  if (files.length < minFiles || files.length > maxFiles) {
                                    Swal.fire({
                                      icon: 'error',
                                      title: 'Error',
                                      text: `Debes subir entre ${minFiles} y ${maxFiles} fotos.`,
                                    });
                                    event.target.value = "";
                                    return;
                                  }

                                  const imagePreviewContainer = document.getElementById('image-preview-container');
                                  imagePreviewContainer.innerHTML = "";

                                  for (let i = 0; i < files.length; i++) {
                                    const file = files[i];
                                    const reader = new FileReader();

                                    reader.onload = function (e) {
                                      const img = document.createElement('img');
                                      img.src = e.target.result;
                                      img.className = 'preview-img';
                                      imagePreviewContainer.appendChild(img);
                                    };

                                    reader.readAsDataURL(file);
                                  }
                                });

                                // Obtener parámetros de URL
                                const urlParams = new URLSearchParams(window.location.search);
                                const success = urlParams.get('success');

                                // Mostrar la alerta si la variable de éxito está presente
                                if (success === 'true') {
                                  Swal.fire({
                                    title: '¡Éxito!',
                                    text: 'Remate creado exitosamente',
                                    icon: 'success'
                                  });
                                } else if (success === 'false') {
                                  Swal.fire({
                                    title: 'Error',
                                    text: 'Hubo un problema al crear el remate',
                                    icon: 'error'
                                  });
                                }

                                // Botón de cerrar sesión admin
                                document.getElementById('logout-button').addEventListener('click', function () {
                                  window.location.href = '/admin/logout';
                                });

                                // Botón de cancelar en el modal de edición
                                document.querySelector('.boton_cancelar_formulario_editar').addEventListener('click', cerrarModalEditar);
                              });

                              function abrirModalcronograma(remateId) {
                                const tarjetaCronograma = document.getElementById('tarjetaCronograma');
                                const identificadorRemateAsociado = document.getElementById('identificador_remate_asociado');

                                // Llenar el campo ID REMATE con el ID del remate
                                identificadorRemateAsociado.value = remateId;

                                // Mostrar la tarjeta del cronograma
                                tarjetaCronograma.style.display = 'block';
                              }

                              document.addEventListener('DOMContentLoaded', function () {
                                const tarjetaCronograma = document.getElementById('tarjetaCronograma');

                                // Cerrar la tarjeta al hacer clic fuera de ella
                                window.addEventListener('click', function (event) {
                                  if (event.target === tarjetaCronograma) {
                                    tarjetaCronograma.style.display = 'none';
                                  }
                                });

                                // Cerrar la tarjeta al hacer clic en el botón de cancelar
                                document.querySelector('.boton_cancelar_formulario_cronograma').addEventListener('click', function () {
                                  tarjetaCronograma.style.display = 'none';
                                });
                              });

                              // Abrir modales
                              document.addEventListener('DOMContentLoaded', function () {
                                const buttons = document.querySelectorAll('.property-button');
                                const tarjetaDetalles = document.getElementById('tarjetaDetalles');
                                const tarjetaInmuebles = document.getElementById('tarjetaInmuebles');
                                const tarjetaCronograma = document.getElementById('tarjetaCronograma');

                                const overlay = document.createElement('div');
                                overlay.className = 'modal-overlay';
                                document.body.appendChild(overlay);

                                let activeModal = null;

                                const modalMap = {
                                  'Detalles': tarjetaDetalles,
                                  'Inmuebles': tarjetaInmuebles,
                                  'Cronograma': tarjetaCronograma
                                };

                                function openModal(modal) {
                                  if (activeModal) {
                                    closeModal(activeModal);
                                  }
                                  modal.style.display = 'block';
                                  overlay.style.display = 'block';
                                  activeModal = modal;
                                  document.body.style.overflow = 'hidden';
                                }

                                function closeModal(modal) {
                                  if (modal) {
                                    modal.style.display = 'none';
                                    overlay.style.display = 'none';
                                    document.body.style.overflow = '';
                                    activeModal = null;
                                  }
                                }

                                buttons.forEach(button => {
                                  button.addEventListener('click', function (e) {
                                    e.preventDefault();
                                    e.stopPropagation();
                                    const buttonText = this.textContent.trim();
                                    const modal = modalMap[buttonText];

                                    if (modal) {
                                      openModal(modal);
                                    }
                                  });
                                });

                                overlay.addEventListener('click', function () {
                                  closeModal(activeModal);
                                });

                                const cancelButtons = document.querySelectorAll([
                                  '.boton_cancelar_formulario_detalles',
                                  '.boton_cancelar_formulario_inmuebles',
                                  '.boton_cancelar_formulario_cronograma'
                                ].join(','));

                                cancelButtons.forEach(button => {
                                  button.addEventListener('click', function (e) {
                                    e.preventDefault();
                                    e.stopPropagation();
                                    closeModal(activeModal);
                                  });
                                });

                                document.addEventListener('keydown', function (e) {
                                  if (e.key === 'Escape' && activeModal) {
                                    closeModal(activeModal);
                                  }
                                });

                                [tarjetaDetalles, tarjetaInmuebles, tarjetaCronograma].forEach(modal => {
                                  if (modal) {
                                    modal.addEventListener('click', function (e) {
                                      e.stopPropagation();
                                    });
                                  }
                                });
                              });

                              function abrirModalSegimiento(id) {
                                const modal = document.getElementById('seguimientoModal');

                                if (!modal) {
                                  console.error('El modal con id "seguimientoModal" no existe.');
                                  return;
                                }

                                modal.style.display = 'block'; // Asegúrate de que tu modal esté visible.

                                if (id) {
                                  fetch(`/getSeguimiento/${id}`)
                                    .then(response => {
                                      if (!response.ok) throw new Error('Error al cargar los datos.');
                                      return response.json();
                                    })
                                    .then(data => {
                                      document.getElementById('seguimientoId').value = data.id || '';
                                      document.getElementById('editExpediente').value = data.expediente || '';
                                      document.getElementById('editDistritoJudicial').value = data.distrito_judicial || '';
                                      document.getElementById('editInstancia').value = data.instancia || '';
                                      document.getElementById('editOrganoJuridico').value = data.organo_juridico || '';
                                      document.getElementById('editEspecialidad').value = data.especialidad || '';
                                      document.getElementById('editNroConvocatoria').value = data.nro_convocatoria || '';
                                      document.getElementById('editFechaRegistro').value = data.fecha_registro || '';
                                      document.getElementById('editProcesadoPor').value = data.procesado_por || '';
                                      document.getElementById('editReanudado').value = data.reanudado || '';
                                      document.getElementById('editFaseConvocatoria').value = data.fase_convocatoria || '';
                                      document.getElementById('editEstadoConvocatoria').value = data.estado_convocatoria || '';
                                      document.getElementById('editRematesId').value = data.remates_id || '';
                                    })
                                    .catch(error => {
                                      console.error('Error al cargar los datos del seguimiento:', error);
                                    });
                                } else {
                                  document.getElementById('seguimientoForm').reset();
                                }
                              }

                              function guardarCambios(event) {
                                event.preventDefault();

                                const form = document.getElementById('seguimientoForm');
                                if (!form) {
                                  console.error('El formulario "seguimientoForm" no existe.');
                                  return;
                                }

                                const formData = new FormData(form);

                                const dataToSend = {};
                                formData.forEach((value, key) => {
                                  dataToSend[key] = value;
                                });

                                fetch('/updateSeguimiento', {
                                  method: 'POST',
                                  body: JSON.stringify(dataToSend),
                                  headers: {
                                    'Content-Type': 'application/json',
                                  },
                                })
                                  .then(response => {
                                    if (!response.ok) throw new Error('Error al guardar los cambios.');
                                    return response.json();
                                  })
                                  .then(data => {
                                    alert('Los cambios se guardaron correctamente.');
                                    cerrarModal();
                                  })
                                  .catch(error => {
                                    console.error('Error al guardar los cambios:', error);
                                    alert('No se pudieron guardar los cambios.');
                                  });
                              }

                              function cerrarModal() {
                                const modal = document.getElementById('seguimientoModal');
                                if (!modal) {
                                  console.error('El modal con id "seguimientoModal" no existe.');
                                  return;
                                }

                                modal.style.display = 'none';
                                document.getElementById('seguimientoForm').reset();
                              }

                              // Funcionalidad para el modal de Detalles
                              function abrirModalDetalles(remateId) {
                                const modal = document.getElementById('tarjetaDetalles');
                                if (!modal) return;

                                // Centrar el modal
                                modal.style.display = 'block';
                                modal.style.position = 'fixed';
                                modal.style.top = '50%';
                                modal.style.left = '50%';
                                modal.style.transform = 'translate(-50%, -50%)';

                                // Cargar datos si existe el ID
                                if (remateId) {
                                  fetch(`/admin/detalles/${remateId}`)
                                    .then(response => response.json())
                                    .then(data => {
                                      // Llenar los campos del formulario con los datos
                                      document.getElementById('expediente').value = data.expediente || '';
                                      document.getElementById('distrito_judicial').value = data.distrito_judicial || '';
                                      document.getElementById('organo_juridiccional').value = data.organo_juridiccional || '';
                                      document.getElementById('instancia').value = data.instancia || '';
                                      document.getElementById('juez').value = data.juez || '';
                                      document.getElementById('especialista').value = data.especialista || '';
                                      document.getElementById('materia').value = data.materia || '';
                                      document.getElementById('resolucion').value = data.resolucion || '';
                                      document.getElementById('fecha_resolucion').value = data.fecha_resolucion || '';
                                      document.getElementById('nro_convocatoria').value = data.nro_convocatoria || '';
                                      document.getElementById('tipo_cambio').value = data.tipo_cambio || '';
                                      document.getElementById('tasacion').value = data.tasacion || '';
                                      document.getElementById('precio_base').value = data.precio_base || '';
                                      document.getElementById('incremento_ofertas').value = data.incremento_ofertas || '';
                                      document.getElementById('arancel').value = data.arancel || '';
                                      document.getElementById('oblaje').value = data.oblaje || '';
                                      document.getElementById('descripcion').value = data.descripcion || '';
                                    })
                                    .catch(error => console.error('Error:', error));
                                }
                              }

                              function cerrarModalDetalles() {
                                const modal = document.getElementById('tarjetaDetalles');
                                if (modal) {
                                  modal.style.display = 'none';
                                }
                              }

                              // Event listeners
                              document.addEventListener('DOMContentLoaded', () => {
                                // Botón cancelar
                                const btnCancelar = document.querySelector('.boton_cancelar_formulario_detalles');
                                if (btnCancelar) {
                                  btnCancelar.addEventListener('click', cerrarModalDetalles);
                                }

                                // Cerrar al hacer click fuera del modal
                                window.addEventListener('click', (e) => {
                                  const modal = document.getElementById('tarjetaDetalles');
                                  if (e.target === modal) {
                                    cerrarModalDetalles();
                                  }
                                });

                                // Manejar el envío del formulario
                                const form = document.getElementById('formulario_detalles');
                                if (form) {
                                  form.addEventListener('submit', async (e) => {
                                    e.preventDefault();
                                    const formData = new FormData(form);

                                    try {
                                      const response = await fetch('/admin/editar-detalles', {
                                        method: 'POST',
                                        body: formData
                                      });

                                      const data = await response.json();
                                      if (data.success) {
                                        alert('Detalles guardados correctamente');
                                        cerrarModalDetalles();
                                      } else {
                                        throw new Error(data.message || 'Error al guardar los detalles');
                                      }
                                    } catch (error) {
                                      console.error('Error:', error);
                                      alert('Error al guardar los detalles');
                                    }
                                  });
                                }
                              });

