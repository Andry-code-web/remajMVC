
<link href="https://cdn.jsdelivr.net/npm/remixicon@4.5.0/fonts/remixicon.css" rel="stylesheet"/>
<link rel="stylesheet" href="/css/globales/globales.css" />
<%- include('../partials/navbar.ejs') %>


<link rel="stylesheet" href="/css/tags/tags.css">
<div class="cronograma-container">
  <div class="navigation-tabs">
    <a href="/en_vivo/detalles/<%= auctionId %>" class="tab-link">Detalles</a>
    <a href="/en_vivo/inmuebles/<%= auctionId %>" class="tab-link">Inmuebles</a>
    <a href="/en_vivo/cronograma/<%= auctionId %>" class="tab-link active">Cronograma</a>
  </div>

  <div class="cronograma-table">
    <table>
      <thead>
        <tr>
          <th>ACTIVIDAD</th>
          <th>FECHA INICIO</th>
          <th>FECHA FIN</th>
        </tr>
      </thead>
      <tbody>
        <% if (cronograma && cronograma.length > 0) { %> <%
        cronograma.forEach(cronogramas => { %>
        <tr>
          <td><%= cronogramas.actividad %></td>
          <td><%= cronogramas.fecha_actividad %></td>
          <td><%= cronogramas.fecha_actividad %></td>
        </tr>
        <% }); %> <%
       } else { %>
        <p class="no-data">No hay cronogramas disponibles.</p>
        <% } %>
      </tbody>
    </table>
  </div>

  <a href="/en_vivo" class="back-button">Volver a Remates</a>
</div>
  <!-- COMPONENTE FOOTER -->
  <%- include('../partials/footer') %>

  <script>
    let lastScrollTop = 0;
    const header = document.getElementById("header");
    const cronogramaTable = document.querySelector(".cronograma-table");
  
    window.addEventListener("scroll", () => {
      const currentScrollTop =
        window.scrollY || document.documentElement.scrollTop;
  
      if (
        currentScrollTop > lastScrollTop &&
        currentScrollTop > cronogramaTable.offsetTop
      ) {
        header.style.transform = "translateY(-100%)";
        header.style.opacity = "0";
      } else {
        header.style.transform = "translateY(0)";
        header.style.opacity = "1";
      }
  
      lastScrollTop = currentScrollTop <= 0 ? 0 : currentScrollTop;
    });
  </script>
  