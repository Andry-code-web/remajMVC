 

 <!-- contenedor general -->
 <div class="contenedor">
  <!-- Contenedor principal -->
  <div class="imagen-contenedor slideInleft">
    <!-- contenedor-letras -->
    <div class="contenedor-titulo">
      <h1 class="tittle-frase">Inicia Sesión y Encuentra Tu Oportunidad Perfecta</h1>
      <p class="parrafo">hola que hace, hola que hace,hola que hace,hola que hace,hola que hace,hola que hace,hola que hace,hola que hace,hola que hace,hola que hace,hola que hace,</p>
     </div>
<!-- Imagen de fondo -->
    <img class="imagen_fondo" src="/img/llave.png" width="100%" height="100%"> 
  </div>

  <div class="fondo">
    <!-- Sección de fondo -->
    <div class="contenedor_form">
      
      <h2>Inicio de sesión</h2> 
      <form class="slideInLeft" method="POST" id="loginForm">

        <!-- Formulario de inicio de sesión -->
        <label for="usuario">Usuario</label> 
        <input type="text" name="usuario" id="usuario" placeholder="Ingresa tu Usuario" required> 

        <!-- Campo de entrada para el usuario -->
        <div class="contenedor_contraseña">

          <!-- Contenedor para el campo de contraseña -->
          <label for="contraseña">Contraseña</label>
          <div class="input-container">

            <!-- Contenedor para el input de contraseña-->
            <input type="password" name="contrasena" id="contrasena" placeholder="Ingresa tu Contraseña" required> 
            <a href="/auth/forgot-password" class="olvide">Olvide mi contraseña</a>
          </div>
        </div>

        <!-- Añadido: Div para el captcha -->
        <!-- <div class="mt-1 mx-2">
          <div class="g-recaptcha" data-sitekey="6LdPuLoqAAAAACCaJURWz8HVYuzYbGVrmsegdg8t"></div> 
        </div> -->

         <!-- Botón para enviar el formulario -->
        <button type="submit">Iniciar sesión</button> 
        <!-- Enlace para registrarse -->
        <a class="registrar" href="/auth/register">Regístrate</a> 

      </form>
      <!-- contactos -->
      <p class="contactos">Si tienes problemas al iniciar sesion, contáctanos aqui:</p>
      <button class="botonSoporte" id="boton_soporte" onclick="botonSoporte()">Soporte Remajud</button>
    </div>
    </div>
    </div>


    <!-- Importar reCAPTCHA y SweetAlert2 -->
<script src="https://www.google.com/recaptcha/api.js" async defer></script>

<link rel="stylesheet" href="/css/login/login.css">

<!-- sweet alert  -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    
    <!-- sweetAlert -->
    <script>
      function botonSoporte() {
        Swal.fire({
          title: "Soporte al cliente",
          text: "Para validar si eres cliente, necesitamos los siguientes datos registrados en remajud (DNI, CORREO, CELULAR, FECHA DE NACIMIENTO) y enviarlos al correo soporte@remajud.sbs, con el asunto (recuperar cuenta).",
          icon: "info",
          confirmButtonColor: "#3085d6",
          confirmButtonText: "OK"
        }
          )}
          
    </script>
