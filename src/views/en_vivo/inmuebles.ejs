<link href="https://cdn.jsdelivr.net/npm/remixicon@4.5.0/fonts/remixicon.css" rel="stylesheet" />
<link rel="stylesheet" href="/css/globales/globales.css" />
<link rel="stylesheet" href="/css/tags/tags.css" />

<%- include('../partials/navbar.ejs') %>
<canvas id="background-canvas"></canvas>
<main class="main-wrapper">
  <div class="inmuebles-container">
    <div class="navigation-tabs">
      <a href="/en_vivo/detalles/<%= auctionId %>" class="tab-link">Detalles</a>
      <a href="/en_vivo/inmuebles/<%= auctionId %>" class="tab-link active">Inmuebles</a>
      <a href="/en_vivo/cronograma/<%= auctionId %>" class="tab-link">Cronograma</a>
    </div>

    <div class="inmuebles-table">
      <% if (inmuebles && inmuebles.length> 0) { %>
      <table>
        <thead>
          <tr>
            <th>Partida Registral</th>
            <th>Tipo Inmueble</th>
            <th>Dirección</th>
            <th>Carga y/o Gravamen</th>
            <th>Porcentaje a Rematar</th>
            <th class="imagen-column">Imagenes inmuebles</th>
          </tr>
        </thead>

        <tbody>

          <% inmuebles.forEach(inmueble=> { %>
          <tr>
            <td><%= inmueble.partida_registral %></td>
            <td><%= inmueble.tipo_inmueble %></td>
            <td class="direccion-cell"><%= inmueble.direccion %></td>
            <td class="gravamen-cell"><%= inmueble.carga_ogravamen %></td>
            <td class="porcentaje-cell"><%= inmueble.porcentaje_rematar %></td>
            <td  class="imagen-cell">
              <% if (inmueble.img_inmueble) { %>
              <img src="data:image/jpeg;base64,<%= inmueble.img_inmueble %>" alt="Imagen Inmueble" style="width: 100px; height: auto; cursor: pointer;" onclick="showImageModal('data:image/jpeg;base64,<%= inmueble.img_inmueble %>')">
              <% } else { %>
              <span>No disponible</span>
              <% } %>
            </td>


          </tr>
          <% }); %>
        </tbody>

      </table>
      <% } else { %>
      <p class="no-data">No hay inmuebles disponibles.</p>
      <% } %>
    </div>

    <!-- Modal para mostrar la imagen -->
<div id="imageModal" class="image-modal" onclick="closeImageModal()" style="display: none;">
  <span class="close" onclick="closeImageModal()">&times;</span>
  <img id="modalImage" src="" alt="Imagen Inmueble">
</div>
    <a href="/en_vivo" class="back-button">Volver a Remates</a>
  </div>
</main>

<!-- COMPONENTE FOOTER -->
<%- include('../partials/footer') %>
<script src="/js/componentes/uvcanvas_envivo.js"></script>

<script>
  let lastScrollTop = 0;
  const header = document.getElementById("header");
  const inmueblesTable = document.querySelector(".inmuebles-table");

  window.addEventListener("scroll", () => {
    const currentScrollTop =
      window.scrollY || document.documentElement.scrollTop;

    if (
      currentScrollTop > lastScrollTop &&
      currentScrollTop > inmueblesTable.offsetTop
    ) {
      header.style.transform = "translateY(-100%)";
      header.style.opacity = "0";
    } else {
      header.style.transform = "translateY(0)";
      header.style.opacity = "1";
    }

    lastScrollTop = currentScrollTop <= 0 ? 0 : currentScrollTop;
  });
</script>

<script>
  function showImageModal(imageSrc) {
    const modal = document.getElementById('imageModal');
    const modalImg = document.getElementById('modalImage');
    modalImg.src = imageSrc;
    modal.style.display = 'flex';
  }

  function closeImageModal() {
    const modal = document.getElementById('imageModal');
    modal.style.display = 'none';
  }
</script>
