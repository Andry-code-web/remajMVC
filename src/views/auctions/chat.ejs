</script>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const tabs = document.querySelectorAll('.active-tab');
    const contentSections = document.querySelectorAll('.active-content-section');
    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const tabId = tab.getAttribute('data-tab');
        tabs.forEach(t => t.classList.remove('active'));
        contentSections.forEach(cs => cs.classList.remove('active'));
        tab.classList.add('active');
        document.getElementById(tabId).classList.add('active');
      });
    });

    // Fetch top bids and update the classification table
    const auctionId = '<%= auction.id %>';
    fetch(`/auctions/${auctionId}/top-bids`)
      .then(response => response.json())
      .then(data => {
        const bidsTableBody = document.getElementById('bids-table-body');
        bidsTableBody.innerHTML = '';
        data.forEach((bid, index) => {
          const row = document.createElement('tr');
          let positionEmoji = '';
          if (index === 0) {
            positionEmoji = '👑';
          } else if (index === 1) {
            positionEmoji = '🥈';
          } else if (index === 2) {
            positionEmoji = '🥉';
          } else {
            positionEmoji = `${index + 1}`;
          }
          row.innerHTML = `
            <td class="position">${positionEmoji}</td>
            <td>${bid.usuario}</td>
            <td class="amount">USD$ ${bid.monto}</td>
          `;
          bidsTableBody.appendChild(row);
        });
      })
      .catch(error => {
        console.error('Error al obtener las mejores ofertas:', error);
      });
  });
</script>

<script>
  // Variables Globales
  var tiempo = {}; 
  var clock = null; // Fecha y hora original, que será enviada desde el servidor
  var intervalo = null; // Variable para almacenar el intervalo
  var started = false; // Indicador de si el cronómetro ya comenzó
  
  // Cuando el cliente se conecta al socket, recibir la fecha y hora original
  socket.on('auction-start-time', function(data) {
    clock = new Date(data.startTime); // Asignamos la fecha recibida desde el servidor
    console.log('Fecha y hora de inicio de la subasta: ', clock);
  
    // Comenzamos a verificar si el cronómetro debe iniciarse
    window.setInterval(mostrar_hora, 1000); // Verifica cada segundo
  });
  
  function mostrar_hora() {
    var now = new Date();
    
    // Verificar si la hora actual coincide con la hora original
    if (!started && now.getTime() >= clock.getTime()) {
      // Iniciar el cronómetro solo cuando la fecha y hora coincidan
      started = true;
      intervalo = window.setInterval(actualizar_cronometro, 1000); // Inicia la actualización cada segundo
    }
  }
  
  function actualizar_cronometro() {
    var now = new Date();
    var diferencia = clock - now; // Diferencia en milisegundos
  
    // Calculamos las horas, minutos y segundos restantes
    var horasRestantes = Math.floor(diferencia / (1000 * 60 * 60));
    var minutosRestantes = Math.floor((diferencia % (1000 * 60 * 60)) / (1000 * 60));
    var segundosRestantes = Math.floor((diferencia % (1000 * 60)) / 1000);
  
    // Inserta la hora restante en el span con id hora
    tiempo.horas = document.getElementById('hora');
    tiempo.horas.innerHTML = horasRestantes < 10 ? '0' + horasRestantes : horasRestantes;
  
    // Inserta los minutos restantes en el span con id minuto
    tiempo.minuto = document.getElementById('minuto');
    tiempo.minuto.innerHTML = minutosRestantes < 10 ? '0' + minutosRestantes : minutosRestantes;
  
    // Inserta los segundos restantes en el span con id segundo
    tiempo.segundos = document.getElementById('segundo');
    tiempo.segundos.innerHTML = segundosRestantes < 10 ? '0' + segundosRestantes : segundosRestantes;
  
    // Si el cronómetro llega a cero, detener el intervalo
    if (diferencia <= 0) {
      clearInterval(intervalo);
      console.log("⏰ El cronómetro ha finalizado.");
    }
  }
  </script>
  