<div class="contenidoPrincipalPagina">
  <aside class="barraLateralFiltros">
    <div>
      <label for="numeroIdentificacionRemate">Numero de Remate</label>
      <input type="text" id="numeroIdentificacionRemate" name="numeroIdentificacionRemate">
    </div>
    <div>
      <label for="numeroExpedienteJudicial">Numero de Expediente</label>
      <input type="text" id="numeroExpedienteJudicial" name="numeroExpedienteJudicial">
    </div>
    <div>
      <label for="valorBasePropiedad">Precio Base</label>
      <input type="text" id="valorBasePropiedad" name="valorBasePropiedad">
    </div>
    <div>
      <label for="ubicacionGeograficaPropiedad">Ubicación</label>
      <input type="text" id="ubicacionGeograficaPropiedad" name="ubicacionGeograficaPropiedad">
    </div>
  </aside>
  <main class="listaSubastasDisponibles">
    <% remates.forEach(remate=> { %>
      <div class="elementoSubastaIndividual">
        <div class="imagenPropiedadSubasta">
          <div class="contenedor_image">
            <% if (remate.imagen) { %>
              <a href="/auctions/<%= remate.id %>" style="text-decoration: none;">
                <img src="data:image/jpeg;base64,<%= Buffer.from(remate.imagen).toString('base64') %>"
                  alt="Imagen del inmueble" class="imagen-propiedad">
              </a>
              <% } else { %>
                <img src="/img/casa2.jfif" alt="Imagen no disponible" class="imagen-propiedad">
                <% } %>
          </div>
        </div>
        <div class="contenidoInformativoSubasta">
          <div class="detallesEspecificosSubasta">
            <div class="informacionGeneralSubasta">
              <h2>Remate N°12345 - CONVOCATORIA</h2>
              <p><strong>TIPO DE REMATE:</strong> Judicial</p>
              <p><strong>LUGAR:</strong>
                <%= remates.ubicacion %> Perú
              </p>
              <h3>OFERTAS</h3>
              <p>10:00 AM</p>
              <p><strong>Precio Base:</strong> S/ <%= remates.precios %>
              </p>
            </div>
            <div class="estadoActualSubasta">
              <p><strong>En proceso</strong></p>
              <p>Publicación e inscripción</p>
            </div>
          </div>
          <div class="contenedorBotonesAccion">
            <button class="botonAccionSubasta">Detalle</button>
            <button class="botonAccionSubasta">Seguimiento</button>
            <button class="botonAccionSubasta">Aviso</button>
          </div>
        </div>
      </div>
      <% }) %>
  </main>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
