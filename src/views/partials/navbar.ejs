<header class="header" id="header">
  <div class="logo-container">
      <a href="#" class="logo">
        <img src="/img/logo_header.jpeg" alt="">
      </a>
  </div>

  <!-- boton en vivo -->
  <a class="boton-vivo" href="/en_vivo">
    <span class="eye">
      <span class="iris">
        <span class="pupil"></span>
      </span>
    </span>
    <span class="text">EN VIVO</span>
  </a>

  <nav class="nav">
      <a href="/">INICIO</a>
      <a href="/remates/index">REMATES</a>
      <a href="/vender">VENDER</a>
      <a href="/comprar">COMPRAR</a>
      <a href="/contacto">CONTACTO</a>
  </nav>


  <!-- area del boton iniciar sesion ,el area desplegable -->
  <div class="contenedor_user_login">
    <% if (user) { %>
      <!-- Menú desplegable al estar logueado -->
      <div class="session">
        <p class="d-flex align-items-center">
          <span><%= user.usuario %></span>
          <button class="btn_menu ms-1" id="btn_menu">
            <i class="bi bi-list"></i>
          </button>
        </p>
        <div class="menu_desplegable d-none flex-column justify-content-between" id="menu_desplegable">
          <div>
            <div class="cabezera_menu d-flex justify-content-between">
              <h3>Subastas</h3>
              <button id="btn_close">
                <i class="bi bi-x-lg"></i>
              </button>
            </div>
            <ul>
              <li><a href="#">Me gusta</a></li>
              <li><a href="/editar_user/44">Editar usuario</a></li>
            </ul>
          </div>
          <div class="perfil_user">
            <div class="d-flex flex-row">
              <i class="bi bi-person-bounding-box" style="font-size: 2.5rem; color: #fff; margin-right: 1rem;"></i>
              <div class="d-flex flex-column">
                <strong>Cliente</strong>
                <small><%= user.usuario %></small>
                <a href="/auth/logout" class="btn btn-danger btn-sm ms-2">Cerrar Sesión</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    <% } else { %>
      <!-- Botón de inicio de sesión -->
      <a href="/auth/login" title="Iniciar sesión" class="login-btn">
        INICIAR SESIÓN
      </a>
    <% } %>
  </div>
  
</header>

<!-- ventana desplegable -->
 <script>
  document.addEventListener("DOMContentLoaded", () => {
    const btnMenu = document.getElementById("btn_menu");
    const menuDesplegable = document.getElementById("menu_desplegable");
    const btnClose = document.getElementById("btn_close");
  
    // Mostrar/Ocultar menú al hacer clic en el botón
    btnMenu.addEventListener("click", () => {
      menuDesplegable.classList.toggle("d-none");
    });
  
    // Cerrar el menú al hacer clic en el botón de cerrar
    btnClose.addEventListener("click", () => {
      menuDesplegable.classList.add("d-none");
    });
  });
  
 </script>


<!-- script boton en vivo -->
 <script>
  document.addEventListener('DOMContentLoaded', () => {
    const buttons = document.querySelectorAll('.boton-vivo');
    
    buttons.forEach(button => {
      const eye = button.querySelector('.eye');
      const iris = eye.querySelector('.iris');
      
      document.addEventListener('mousemove', (e) => {
        const eyeRect = eye.getBoundingClientRect();
        const eyeCenterX = eyeRect.left + eyeRect.width / 2;
        const eyeCenterY = eyeRect.top + eyeRect.height / 2;
        
        // Calcular el ángulo y la distancia
        const deltaX = e.clientX - eyeCenterX;
        const deltaY = e.clientY - eyeCenterY;
        const angle = Math.atan2(deltaY, deltaX);
        
        // Aumentar el rango de movimiento
        const maxDistance = eyeRect.width / 3;
        const distance = Math.min(
          Math.sqrt(deltaX * deltaX + deltaY * deltaY) / 10,
          maxDistance
        );
        
        // Calcular la nueva posición
        const x = Math.cos(angle) * distance;
        const y = Math.sin(angle) * distance;
        
        // Aplicar la transformación con una transición más suave
        iris.style.transform = `translate(calc(-50% + ${x}px), calc(-50% + ${y}px))`;
      });
    });
  });
 </script>
  