<link rel="stylesheet" href="/css/comprar/comprar.css">
<div class="contenedor_principal_pagina_comercial">
    <div class="espacio_cabecera_personalizada">
        <!-- Header será agregado después -->
    </div>

    <!-- Sección Hero -->
    <section class="seccion_principal_destacada_comercial">
        <div class="contenedor_texto_principal_destacado">
            <h1 class="titulo_principal_destacado_comercial">¿Cómo vender con nosotros?</h1>
            <h2 class="subtitulo_destacado_comercial_naranja">Practicidad y retorno rápido</h2>
            <p class="descripcion_principal_comercial">
                Nuestra consultoría altamente especializada identifica el mejor modelo de venta para sus activos y
                se responsabiliza de todo el proceso – desde la digitalización de productos hasta el retiro de los
                activos.
            </p>
            <a href="/contacto" class="boton_contacto_principal_destacado">Entrar en contacto</a>
        </div>
    </section>

    <!-- Sección Estadísticas -->
    <section class="seccion_estadisticas_empresariales">
        <h2 class="titulo_estadisticas_empresariales">Nuestra Empresa</h2>
        <div class="contenedor_numeros_estadisticas_flex">
            <div class="item_estadistica_empresarial">
                <div class="numero_estadistica_destacado">+20</div>
                <p>años de experiencia</p>
            </div>
            <div class="item_estadistica_empresarial">
                <div class="numero_estadistica_destacado">+50</div>
                <p>eventos por día</p>
            </div>
            <div class="item_estadistica_empresarial">
                <div class="numero_estadistica_destacado">+10.000</div>
                <p>clientes satisfechos</p>
            </div>
            <div class="item_estadistica_empresarial">
                <div class="numero_estadistica_destacado">+100</div>
                <p>Inmuebles por día</p>
            </div>
        </div>
    </section>

    <!-- Sección Ventajas -->
    <section class="contenedor_beneficios_principales_area">
        <h2 class="titulo_beneficios_destacados">Ventajas de trabajar con nosotros</h2>
        <div class="distribucion_beneficios_grid">
            <div class="elemento_beneficio_individual">
                <div class="circulo_icono_beneficio">
                    <svg viewBox="0 0 24 24" width="32" height="32" stroke="currentColor" stroke-width="2" fill="none">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                    </svg>
                </div>
                <h3 class="titulo_beneficio_individual">Procesos auditados</h3>
                <p class="descripcion_beneficio_detallada">
                    Imparcialidad en las negociaciones – desde el contacto con los potenciales compradores hasta el
                    retiro de los activos después del pago y documentación solicitada. Los procesos son
                    transparentes y auditables, obedeciendo las mejores prácticas de compliance y gobernanza.
                </p>
            </div>
            <div class="elemento_beneficio_individual">
                <div class="circulo_icono_beneficio">
                    <svg viewBox="0 0 24 24" width="32" height="32" stroke="currentColor" stroke-width="2" fill="none">
                        <circle cx="11" cy="11" r="8" />
                        <path d="M21 21l-4.35-4.35" />
                    </svg>
                </div>
                <h3 class="titulo_beneficio_individual">Enfoque personalizado</h3>
                <p class="descripcion_beneficio_detallada">
                    Contamos con soluciones que optimizarán los procesos y costos de su empresa, dedicándonos
                    totalmente a su negocio.
                </p>
            </div>
            <div class="elemento_beneficio_individual">
                <div class="circulo_icono_beneficio">
                    <svg viewBox="0 0 24 24" width="32" height="32" stroke="currentColor" stroke-width="2" fill="none">
                        <path d="M21 21H3v-2l8-8 4 4 6-6v12z" />
                    </svg>
                </div>
                <h3 class="titulo_beneficio_individual">Resultados garantizados</h3>
                <p class="descripcion_beneficio_detallada">
                    Recuperación de capital para la empresa con los mejores resultados del mercado. Amplia base de
                    conocimiento en diversas categorías de activos y eficiencia comprobada, con grandes casos de
                    éxito
                </p>
            </div>
        </div>
    </section>

    <!-- Sección Formulario -->
    <section class="seccion_formulario_contacto_empresarial">
        <div class="formulario_contacto_empresarial_container">
            <h2>¡Envía tus datos!</h2>
            <form>
                <select class="campo_formulario_personalizado_empresarial">
                    <option>Tipo de Cliente</option>
                </select>
                <input type="text" placeholder="Nombre*" class="campo_formulario_personalizado_empresarial">
                <input type="text" placeholder="Apellido*" class="campo_formulario_personalizado_empresarial">
                <input type="tel" placeholder="Teléfono" class="campo_formulario_personalizado_empresarial">
                <input type="email" placeholder="Correo electrónico*"
                    class="campo_formulario_personalizado_empresarial">
                <select class="campo_formulario_personalizado_empresarial">
                    <option>Departamento</option>
                </select>
                <input type="text" placeholder="Ciudad" class="campo_formulario_personalizado_empresarial">
                <textarea placeholder="Describe los productos que te interesan"
                    class="campo_formulario_personalizado_empresarial" rows="4"></textarea>
                <button type="submit" class="boton_enviar_formulario_morado">Enviar</button>
            </form>
        </div>
    </section>
</div>