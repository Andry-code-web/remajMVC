<link rel="stylesheet" href="/css/clientesAdmin/clientesAdmin.css">

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<div class="container">
  <div id="dashboardContent">
    <div class="stats-container">
      <button class="stat-box" id="btn_totalClientes">
        <div class="stat-icon">👥</div>
        <div class="stat-info">
          <h3>Total Clientes</h3>
          <p id="totalClientes">
            <%= numeroClientes %>
          </p>
        </div>
      </button>

      <!-- <div class="stat-box" id="clientesActivosBox">
        <div class="stat-icon">✅</div>
        <div class="stat-info">
          <h3>Clientes Activos</h3>
          <p id="clientesActivos">2</p>
        </div>
      </div> -->

      <button class="stat-box" id="btn_nuevosClientes">
        <div class="stat-icon">📅</div>
        <div class="stat-info">
          <h3>Nuevos este mes</h3>
          <p id="clientesNuevos">
            <%= nuevosClientesES %>
          </p>
        </div>
      </button>
    </div>

    <!--     <div class="search-container">
      <input type="text" id="searchInput" placeholder="Buscar por nombre, email o ID..." class="search-input">
    </div> -->

    <div class="table-container" id="total_cliente">
      <table class="clients-table">
        <thead>
          <tr>
            <th>CLIENTE</th>
            <th>CONTACTO</th>
            <th>COMPRAS</th>
            <th>ID REMATE VALID</th>
          </tr>
        </thead>
        <tbody id="clientesTableBody">
          <% if (clientes && clientes.length > 0) { %>
          <% clientes.forEach((cliente) => { %>
          <tr>
            <td>
              <div class="client-info">
                <img src="/img/admin.png" alt="" class="client-avatar">
                <div>
                  <div class="client-id">ID: <%= cliente.id %></div>
                  <div class="client-name"><%= cliente.nombres_apellidos %></div>
                </div>
              </div>
            </td>
            <td>
              <div><%= cliente.correo %></div>
              <div style="color: #6b7280"><%= cliente.celular %></div>
            </td>
            <td>
              <div><%= cliente.comprasTotal %> compras</div>
              <div style="color: #6b7280">Última: <%= cliente.ultimaCompra %></div>
            </td>
            <td>
              <div class="opportunities-badge validar">
                <span class="opportunities-count">
                  <% if (cliente.remates_validos && cliente.remates_validos.length > 0) { %>
                  <%= cliente.remates_validos.join(', ') %>
                  <% } else { %>
                  0
                  <% } %>
                </span>
                <div class="btn-group">

                  <button type="button" class="btn btn-primary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                    Validar Cliente
                  </button>
                  <ul class="dropdown-menu">
                    <!-- Agrega este log para verificar el objeto cliente -->

                    <div class="InputContainer">
                      <input placeholder="Search" id="input" class="input" name="text" type="text" />

                      <label class="labelforsearch" for="input">
                        <svg class="searchIcon" viewBox="0 0 512 512">
                          <path d="M416 208c0 45.9-14.9 88.3-40 122.7L502.6 457.4c12.5 12.5 12.5 32.8 0 45.3s-32.8 12.5-45.3 0L330.7 376c-34.4 25.2-76.8 40-122.7 40C93.1 416 0 322.9 0 208S93.1 0 208 0S416 93.1 416 208zM208 352a144 144 0 1 0 0-288 144 144 0 1 0 0 288z"></path>
                        </svg>
                      </label>
                    </div>
                    <% id_remate.forEach(id => { %>
                    <li>
                      <a class="dropdown-item <%= cliente.remates_validos.includes(id) ? 'text-danger' : '' %>" href="#" data-cliente-id="<%= cliente.id %>" data-remate-id="<%= id %>">
                        Remate ID: <%= id %>
                      </a>
                    </li>
                    <% }) %>

                  </ul>

                </div>
            </td>
          </tr>
          <% }); %>
          <% } else { %>
          <tr>
            <td colspan="4">No hay clientes disponibles.</td>
          </tr>
          <% } %>
        </tbody>


      </table>
    </div>

    <div id="nuevos_clintes" class="nuevos_clintes">
      <form id="filtroEstadisticas" method="GET" action="/admin/usuarios">
        <label for="anio">Año:</label>
        <select id="anio" name="anio">
          <% for (let year = 2020; year <= new Date().getFullYear(); year++) { %>
          <option value="<%= year %>" <%= anio == year ? 'selected' : '' %>><%= year %></option>
          <% } %>
        </select>

        <label for="mes">Mes:</label>
        <select id="mes" name="mes">
          <% const meses = ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre']; %>
          <% for (let i = 0; i < meses.length; i++) { %>
          <option value="<%= i + 1 %>" <%= mes == (i + 1) ? 'selected' : '' %>><%= meses[i] %></option>
          <% } %>
        </select>

        <button type="submit">Filtrar</button>
      </form>

      <!-- Mostrar el mensaje de alerta si no hay datos -->
      <% if (noDataMessage) { %>
      <div class="alert alert-warning">
        <%= noDataMessage %>
      </div>
      <% } else { %>
      <!-- Mostrar los datos en el gráfico si hay registros -->
      <canvas id="myChart" width="400" height="200"></canvas>
      <% } %>
    </div>

  </div>


</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
 document.addEventListener("click", (event) => {
  if (event.target.classList.contains("dropdown-item")) {
    const clienteId = event.target.dataset.clienteId;
    const remateId = event.target.dataset.remateId;

    fetch("/admin/validar-cliente", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
      },
      body: JSON.stringify({
        clienteId,
        remateId,
      }),
    })
      .then((response) => response.json())
      .then((data) => {
        if (data.message) {
          /* alert(data.message); */ // Mejora con SweetAlert2 si lo prefieres
          Swal.fire({
            icon: 'success',
            title: 'Cliente validado',
            text: data.message,
          }).then(() => {
            location.reload(); // Recargar la página
          });
          event.target.classList.toggle("text-danger"); // Cambia la clase visualmente
        }
      })
      .catch((error) => {
        console.error("Error:", error);
      });
  }
});

</script>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const totalCliente = document.getElementById('total_cliente');
    const nuevosClientes = document.getElementById('nuevos_clintes');
    const btnTotalClientes = document.getElementById('btn_totalClientes');
    const btnNuevosClientes = document.getElementById('btn_nuevosClientes');
    const myChart = document.getElementById('myChart');

    // Datos del gráfico
    const registrosPorDia = <%- JSON.stringify(registrosPorDia) %>;
    const diasSemana = ['Domingo', 'Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado'];
    const registros = Array(7).fill(0);

    // Procesar los registros por día
    registrosPorDia.forEach(({
      dia_semana,
      total
    }) => {
      registros[dia_semana - 1] = total; // MySQL: 1 = Domingo
    });

    // Inicialmente, al cargar la página, mostrar solo total_cliente y ocultar nuevos_clintes
    totalCliente.style.display = 'block';
    nuevosClientes.style.display = 'none';

    // Mostrar los datos de totalCliente y ocultar los de nuevosClientes
    if (btnTotalClientes) {
      btnTotalClientes.addEventListener('click', () => {
        totalCliente.style.display = 'block';
        nuevosClientes.style.display = 'none';
      });
    }

    // Mostrar u ocultar nuevosClientes al hacer clic
    if (btnNuevosClientes) {
      btnNuevosClientes.addEventListener('click', () => {
        totalCliente.style.display = 'none'; // Ocultar totalCliente
        nuevosClientes.style.display = 'block'; // Mostrar nuevosClientes

        // Si el div de nuevosClientes es visible, crear el gráfico
        if (nuevosClientes.style.display === 'block') {
          const ctx = myChart.getContext('2d');

          // Obtener el último mes y el año actual
          const today = new Date();
          const lastMonth = today.getMonth(); // El mes actual (0 = enero, 11 = diciembre)
          const currentYear = today.getFullYear(); // Año actual

          // Actualiza el gráfico con los datos correspondientes al último mes
          new Chart(ctx, {
            type: 'line',
            data: {
              labels: diasSemana,
              datasets: [{
                label: `Clientes nuevos en ${diasSemana[lastMonth]} ${currentYear}`,
                data: registros, // Puedes ajustar este dato para el último mes si tienes más registros
                backgroundColor: 'rgba(75, 192, 192, 0.2)',
                borderColor: 'rgba(75, 192, 192, 1)',
                borderWidth: 1
              }]
            },
            options: {
              responsive: true,
              animations: {
                tension: {
                  duration: 1000,
                  easing: 'easeInQuad',
                  from: 1,
                  to: 0,
                  loop: true
                }
              },
              scales: {
                y: {
                  beginAtZero: true
                }
              }
            }
          });
        }
      });
    }
  });
</script>