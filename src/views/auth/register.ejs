<!-- Contenedor general del registro -->
<div class="contenedor-general">
  <!-- Wrapper principal que divide la pantalla en dos -->
  <div class="form-wrapper">
    <!-- Lado izquierdo - Imagen de fondo con overlay -->
    <div class="left-side">
      <!-- Overlay para dar efecto de color sobre la imagen -->
      <div class="overlay"></div>

      <!-- contenedor-letras -->
       <div class="contenedor-titulo">
        <h1 class="tittle-frase">Inicia Sesión y Encuentra Tu Oportunidad Perfecta</h1>
        <p class="parrafo">hola que hace, hola que hace,hola que hace,hola que hace,hola que hace,hola que hace,hola que hace,hola que hace,hola que hace,hola que hace,hola que hace,</p>
       </div>
      <!-- imagen cambiante -->
        <img class="imagen-secundaria" src="/img/llave.png" alt="">
    </div>

    <!-- Lado derecho - Contenedor del formulario -->
    <div class="right-side">
      <!-- Barra de progreso -->
      <div class="contenedor-progreso">
        <div class="progress-bar">
          <!-- Línea de progreso que se llena gradualmente -->
          <div class="progress-line"></div>
          <!-- Contenedor de los pasos del progreso -->
          <div class="progress-steps">
            <!-- Paso 1: Registro Personal -->
            <div class="step active" data-step="1">
              <div class="step-circle">
                <!-- Icono para datos personales -->
                <i class="bi bi-person-lines-fill"></i>
              </div>
            </div>
            <!-- Paso 2: Ubicación -->
            <div class="step" data-step="2">
              <div class="step-circle">
                <!-- Icono para ubicación/dirección -->
                <i class="bi bi-geo-alt-fill"></i>
              </div>
            </div>
            <!-- Paso 3: Creación de Usuario -->
            <div class="step" data-step="3">
              <div class="step-circle">
                <!-- Icono para configuración de usuario -->
                <i class="bi bi-person-gear"></i>
              </div>
            </div>
          </div>
        </div>
        <!-- Etiqueta que muestra el paso actual -->
        <div class="progress-label">Registro</div>
      </div>

      <!-- Contenedor de los formularios -->
      <div class="form-container">
        <!-- Sección 1: Registro Personal -->
        <div class="seccion seccion1 active">
          <h2 class="form-title">Registro Personal</h2>
          <form class="registration-form">
            <!-- Fila: Nombres y Apellidos, DNI -->
            <div class="form-row two-columns">
              <div class="form-group">
                <input type="text" name="nombre_apellidos" required />
                <label>Nombres y Apellidos</label>
              </div>
              <div class="form-group">
                <input type="number" name="dni" required />
                <label>DNI</label>
              </div>
            </div>

            <!-- Fila: Email, Confirmar Email -->
            <div class="form-row two-columns">
              <div class="form-group">
                <input type="email" name="EMAIL" id="email" required />
                <label>Email</label>
              </div>
              <div class="form-group">
                <input type="email" name="confirmar_email" id="confirmar_email" required />
                <label>Confirmar Email</label>
                <i class="bi bi-check-circle check-icon" style="display: none;"></i>
              </div>
            </div>

            <!-- Fila: Fecha de Nacimiento, Sexo, Estado Civil -->
            <div class="form-row three-columns">
              <div class="form-group">
                <input type="date" name="fecha_nacimiento" required />
                <label>Fecha de Nacimiento</label>
              </div>
              <div class="form-group">
                <select name="sexo" required>
                  <option value="" disabled selected>Seleccionar sexo</option>
                  <option value="Masculino">Masculino</option>
                  <option value="Femenino">Femenino</option>
                </select>
                <label>Sexo</label>
              </div>
              <div class="form-group">
                <select name="estado_civil" required>
                  <option value="" disabled selected>Estado civil</option>
                  <option value="soltero">Soltero(a)</option>
                  <option value="casado">Casado(a)</option>
                  <option value="divorciado">Divorciado(a)</option>
                  <option value="viudo">Viudo(a)</option>
                </select>
                <label>Estado Civil</label>
              </div>
            </div>

            <!-- Fila: Celular -->
            <div class="form-row">
              <div class="form-group">
                <input type="number" name="celular" required />
                <label>Celular</label>
              </div>
            </div>

            <!-- Botón para pasar a la siguiente sección -->
            <button type="button" class="btn siguiente">Siguiente</button>
          </form>
        </div>

        <!-- Sección 2: Ubicación -->
        <div class="seccion seccion2">
          <h2 class="form-title">Ubicación</h2>
          <form class="registration-form">
            <!-- Fila: Departamento, Provincia -->
            <div class="form-row two-columns">
              <div class="form-group">
                <input type="text" name="departamento" required />
                <label>Departamento</label>
              </div>
              <div class="form-group">
                <input type="text" name="provincia" required />
                <label>Provincia</label>
              </div>
            </div>

            <!-- Fila: Distrito, Dirección -->
            <div class="form-row two-columns">
              <div class="form-group">
                <input type="text" name="distrito" required />
                <label>Distrito</label>
              </div>
              <div class="form-group">
                <input type="text" name="direccion" required />
                <label>Dirección</label>
              </div>
            </div>

            <!-- Botones de navegación -->
            <div class="button-group">
              <button type="button" class="btn anterior">Anterior</button>
              <button type="button" class="btn siguiente">Siguiente</button>
            </div>
          </form>
        </div>

        <!-- Sección 3: Crear Usuario -->
        <div class="seccion seccion3">
          <h2 class="form-title">Crear Usuario</h2>
          <form class="registration-form">
            <!-- Campo de Usuario con generador de alias -->
            <div class="alias-section">
              <div class="input-container">
                <input
                  type="text"
                  name="usuario"
                  id="usuario"
                  class="form-control"
                  placeholder="Escribe o genera un alias"
                />
                <button
                  type="button"
                  id="generar-alias"
                  class="generate-btn"
                >
                  Generar
                </button>
              </div>
              
              <!-- Contenedor para mostrar el alias generado -->
              <div id="alias-container" class="alias-result">
                <span>Alias generado: </span>
                <strong id="alias-creado"></strong>
                <button type="button" id="copiar-alias" class="copy-btn" title="Copiar alias">
                  <i class="bi bi-clipboard"></i>
                </button>
              </div>
            </div>

            <!-- Campo de Contraseña -->
            <div class="form-group password-group">
              <input type="password" name="contrasena" id="contrasena" required />
              <label>Contraseña</label>
              <button type="button" class="toggle-password" title="Mostrar/Ocultar contraseña">
                <i class="bi bi-eye"></i>
              </button>
            </div>

            <!-- Términos y condiciones -->
            <div class="terms-container">
              <input type="checkbox" name="terminos_condiciones" id="terminos_condiciones"/>
              <label for="terminos_condiciones">
                Acepto los
                <a href="/terminos/terminos-condiciones" target="_blank">
                  términos y condiciones
                </a>
              </label>
            </div>

            <!-- Botones de navegación -->
            <div class="button-group">
              <button type="button" class="btn anterior">Anterior</button>
              <button type="submit" class="btn finalizar">Registrado</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ICONOS BOOSTRAP -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet" />
<!-- BOOTSRAP -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<!-- DISEÑO REGISTRO -->
<link rel="stylesheet" href="/css/registro/registro.css" />

<!-- SWEET ALERT -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<!-- SCRIPT REGISTRO -->
<script type="module" src="/js/componentes/script_formulario.js"> </script>

<!-- SCRIPT VALIDACION DE DATOS -->
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const emailInput = document.getElementById('email');
    const confirmarEmailInput = document.getElementById('confirmar_email');
    const checkIcon = document.querySelector('.check-icon');
    const passwordInput = document.getElementById('contrasena');
    const togglePasswordBtn = document.querySelector('.toggle-password');

    // Función para verificar si los correos coinciden
    function verificarCorreos() {
      if (emailInput.value && confirmarEmailInput.value && emailInput.value === confirmarEmailInput.value) {
        checkIcon.style.display = 'inline-block';
      } else {
        checkIcon.style.display = 'none';
      }
    }

    // Event listeners para verificar correos
    emailInput.addEventListener('input', verificarCorreos);
    confirmarEmailInput.addEventListener('input', verificarCorreos);

    // Función para alternar la visibilidad de la contraseña
    togglePasswordBtn.addEventListener('click', function() {
      const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
      passwordInput.setAttribute('type', type);
      this.querySelector('i').classList.toggle('bi-eye');
      this.querySelector('i').classList.toggle('bi-eye-slash');
    });

    document
      .querySelector(".finalizar")
      .addEventListener("click", async (e) => {
        e.preventDefault();

        const datos = {
          nombre_apellidos: document
            .querySelector("[name='nombre_apellidos']")
            .value.trim(),
          correo: document.querySelector("[name='EMAIL']").value.trim(),
          confirmar_correo: document
            .querySelector("[name='confirmar_email']")
            .value.trim(),
          estado_civil: document.querySelector("[name='estado_civil']")
            .value,
          fecha_nacimiento: document.querySelector(
            "[name='fecha_nacimiento']"
          ).value,
          sexo: document.querySelector("[name='sexo']").value,
          dni: document.querySelector("[name='dni']").value.trim(),
          celular: document
            .querySelector("[name='celular']")
            .value.trim(),
          departamento: document
            .querySelector("[name='departamento']")
            .value.trim(),
          provincia: document
            .querySelector("[name='provincia']")
            .value.trim(),
          distrito: document
            .querySelector("[name='distrito']")
            .value.trim(),
          direccion: document
            .querySelector("[name='direccion']")
            .value.trim(),
          usuario: document
            .querySelector("[name='usuario']")
            .value.trim(),
          contrasena: document.querySelector("[name='contrasena']")
            .value,
          terminos_condiciones: document.querySelector(
            "[name='terminos_condiciones']"
          ).checked,
        };

        // Validar campos obligatorios
        const camposVacios = Object.entries(datos).filter(
          ([key, value]) => !value && key !== "confirmar_correo"
        );
        if (camposVacios.length > 0) {
          const mensaje = `Por favor, complete todos los campos: ${camposVacios
            .map(([key]) => key)
            .join(", ")}`;
          return Swal.fire({
            title: "Faltan campos obligatorios",
            text: mensaje,
            icon: "warning",
          });
        }

        try {
          const response = await fetch("/auth/register", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify(datos),
          });

          const result = await response.json();

          if (response.ok) {
            Swal.fire({
              title: "¡Registro exitoso!",
              text: "¡Bienvenido a REMAJUD!",
              icon: "success",
              confirmButtonText: "Iniciar sesión",
            }).then(() => {
              window.location.href = "/auth/login";
            });
          } else {
            Swal.fire({
              title: "Error en el registro",
              text: result.message,
              icon: "error",
            });
          }
        } catch (error) {
          console.error("Error al enviar el formulario:", error);
          Swal.fire({
            title: "Error interno",
            text: "Hubo un problema al procesar tu registro. Intenta nuevamente.",
            icon: "error",
          });
        }
      });
  });
</script>