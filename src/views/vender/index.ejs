<link rel="stylesheet" href="/css/vender/vender.css">
<!-- Espacio para Header -->
<div class="espacio_cabecera_temporal"></div>

<main>
    <!-- Sección Hero -->
    <section class="contenedor_pagina_principal">
        <div class="seccion_hero_comercial">
            <div class="contenido_hero_izquierda">
                <h1 class="titulo_hero_principal">¿Cómo comprar en nuestra plataforma?</h1>
                <p class="descripcion_hero_detallada">
                    Para comenzar, puede registrarse haciendo clic en el botón a continuación. En la página de
                    registro, complete los campos con sus datos, valide su cuenta a través de su correo electrónico
                    y espere la confirmación para comenzar a ofertar.
                </p>
                <button class="boton_registro_destacado">REGISTRARME</button>
            </div>
            <div>
                <img src="/img/socioyjefe.jpg" alt="Negociación comercial" class="imagen_hero_derecha">
            </div>
        </div>
    </section>

    <!-- Sección Selección de Productos -->
    <section class="contenedor_pagina_principal">
        <div class="seccion_seleccion_productos">
            <div>
                <h2 class="titulo_modalidades_principal">Elige el producto de tu interés</h2>
                <p class="descripcion_hero_detallada">
                    En nuestra plataforma, podrás encontrar cientos de productos en diferentes categorías como
                    autos, maquinaria de construcción, minería e industrial, camiones, equipos electrónicos,
                    inmuebles y mucho más. Puedes usar el menú superior/lateral para seleccionar la categoría y
                    sub-categoría de tu interés o escribir en la búsqueda superior el nombre del activo que deseas
                    comprar.
                </p>
            </div>
            <ul class="lista_caracteristicas_productos">
                <li class="item_caracteristica_producto">Más de 100 sub-categorías de productos disponibles</li>
                <li class="item_caracteristica_producto">Nuevos eventos publicados todas las semanas</li>
                <li class="item_caracteristica_producto">Recibimos eventos en territorio nacional</li>
                <li class="item_caracteristica_producto">Desde 1999 transformando la re-utilización en oportunidades
                </li>
            </ul>
        </div>
    </section>

    <!-- Sección Modalidades de Compra -->
    <section class="contenedor_pagina_principal seccion_modalidades_compra">
        <h2 class="titulo_modalidades_principal">Conoce las modalidades de compra disponibles</h2>
        <div class="contenedor_tarjetas_modalidades">
            <div class="tarjeta_modalidad_individual">
                <img src="/img/Primer plano El martillo del juez se coloca sobre una.jpg" alt="Subasta"
                    class="imagen_modalidad_compra">
                <h3 class="titulo_modalidad_compra">Subasta</h3>
                <ol class="lista_pasos_modalidad">
                    <li class="paso_modalidad_individual">Lee atentamente la condiciones de venta y pago, y solicita
                        la habilitación.</li>
                    <li class="paso_modalidad_individual">Deposita tu garantía de seriedad de oferta y envía tu
                        comprobante.</li>
                    <li class="paso_modalidad_individual">Envía tus ofertas por los lotes de tu interés, sigue
                        atentamente la subasta.</li>
                    <li class="paso_modalidad_individual">En caso de que seas el mejor postor, nos pondremos en
                        contacto vía email.</li>
                </ol>
                <a href="#" class="enlace_mas_informacion">Más información →</a>
            </div>

            <div class="tarjeta_modalidad_individual">
                <img src="/img/chico-laptop.jpg" alt="Venta directa" class="imagen_modalidad_compra">
                <h3 class="titulo_modalidad_compra">Venta directa</h3>
                <ol class="lista_pasos_modalidad">
                    <li class="paso_modalidad_individual">Haz clic en el botón "Comprar"</li>
                    <li class="paso_modalidad_individual">Completa los campos, lee y acepta las condiciones.</li>
                    <li class="paso_modalidad_individual">Deposita tu garantía de seriedad de oferta.</li>
                    <li class="paso_modalidad_individual">Envía tu oferta por el valor que aparece en la web.</li>
                    <li class="paso_modalidad_individual">Analizaremos tu oferta y nos pondremos en contacto.</li>
                </ol>
                <a href="#" class="enlace_mas_informacion">Más información →</a>
            </div>

            <div class="tarjeta_modalidad_individual">
                <img src="/img/Menina com celular em casa _ Foto Grátis.jpg" alt="Propuesta"
                    class="imagen_modalidad_compra">
                <h3 class="titulo_modalidad_compra">Propuesta</h3>
                <ol class="lista_pasos_modalidad">
                    <li class="paso_modalidad_individual">Haz clic en el botón "Envía tu propuesta"</li>
                    <li class="paso_modalidad_individual">Completa los campos y acepta las condiciones.</li>
                    <li class="paso_modalidad_individual">Deposita tu garantía de seriedad de oferta.</li>
                    <li class="paso_modalidad_individual">Envía tu propuesta.</li>
                    <li class="paso_modalidad_individual">Analizaremos las propuestas recibidas.</li>
                </ol>
                <a href="#" class="enlace_mas_informacion">Más información →</a>
            </div>
        </div>
    </section>

    <!-- Sección Beneficios -->
    <section class="seccion_beneficios_plataforma">
        <div class="contenedor_pagina_principal">
            <h2 class="titulo_modalidades_principal">¿Por qué comprar en nuestra plataforma?</h2>
            <div class="contenedor_tarjetas_beneficios">
                <div class="tarjeta_beneficio_individual">
                    <svg class="icono_beneficio" viewBox="0 0 24 24" fill="none" stroke="#f31818" stroke-width="2">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                    </svg>
                    <h3 class="titulo_beneficio">Seguridad</h3>
                    <p class="descripcion_beneficio">Tus datos están protegidos por uno de los más avanzados
                        sistemas de seguridad de información.</p>
                </div>

                <div class="tarjeta_beneficio_individual">
                    <svg class="icono_beneficio" viewBox="0 0 24 24" fill="none" stroke="#f31818" stroke-width="2">
                        <path d="M12 1v22M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
                    </svg>
                    <h3 class="titulo_beneficio">Ahorro</h3>
                    <p class="descripcion_beneficio">Además de la procedencia de los activos en venta, los valores
                        son competitivos con el mercado.</p>
                </div>

                <div class="tarjeta_beneficio_individual">
                    <svg class="icono_beneficio" viewBox="0 0 24 24" fill="none" stroke="#f31818" stroke-width="2">
                        <path
                            d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
                    </svg>
                    <h3 class="titulo_beneficio">Variedad</h3>
                    <p class="descripcion_beneficio">Cientos de productos de diferentes categorías para tu negocio u
                        hogar.</p>
                </div>

                <div class="tarjeta_beneficio_individual">
                    <svg class="icono_beneficio" viewBox="0 0 24 24" fill="none" stroke="#f31818" stroke-width="2">
                        <path d="M18 8h1a4 4 0 0 1 0 8h-1" />
                        <path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z" />
                        <line x1="6" y1="1" x2="6" y2="4" />
                        <line x1="10" y1="1" x2="10" y2="4" />
                        <line x1="14" y1="1" x2="14" y2="4" />
                    </svg>
                    <h3 class="titulo_beneficio">Transparencia</h3>
                    <p class="descripcion_beneficio">El proceso no tiene interferencia humana, todos los
                        participantes tienen igualdad de condiciones.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Sección CTA Final -->
    <section class="seccion_cta_final contenedor_pagina_principal">
        <h2 class="titulo_modalidades_principal">¡No pierdas esta oportunidad!</h2>
        <p class="descripcion_hero_detallada">Regístrate y accede a las mejores ofertas, al mejor precio en nuestra
            plataforma</p>
        <button class="boton_registro_destacado">REGISTRARME</button>
    </section>
</main>