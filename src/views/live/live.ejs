<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>
  <link rel="stylesheet" href="/css/live/live.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <!-- CDN DE ICONOS REMIX -->
  <link href="https://cdn.jsdelivr.net/npm/remixicon@4.5.0/fonts/remixicon.css" rel="stylesheet" />
  <!-- ESTILOS GLOBALES -->
  <link rel="stylesheet" href="/css/globales/globales.css">
</head>

<body>

  <!-- COMPONENTE HEADER -->
  <%- include('../partials/navbar') %>

  <canvas id="particleCanvas"></canvas>

  <!-- live_Tarjeta  -->
  <section class="property-container">
    <div class="property-grid">
      <% liveData.forEach((auction, index) => { %>
      <div class="property-card">
        <div class="property-image-container">
          <img src="data:image/png;base64,<%= auction.imagen %>" alt="Imagen de propiedad" class="property-image">
        </div>
        <div class="property-info">
          <h2><%= auction.ubicacion %></h2>
          <p>USD$ <%= auction.precios %></p>
          <div class="property-stats">
            <span>Baños: <%= auction.N_baños %></span>
            <span>Habitaciones: <%= auction.N_habitacion %></span>
          </div>
          <div class="property-actions">
            <button class="card-button" data-action="tracking">
              <a href="en_vivo/seguimiento/<%= auction.seguimiento %>"></a>
              <p>Seguimiento</p>
            </button>
            <button class="card-button" data-action="open-details">
              <a href="en_vivo/detalles/<%= auction.detalles %>"></a>
              <p>Detalles</p>
            </button>
            <button class="card-button" data-action="notice">
              <a href=""></a>
              <p>Aviso</p>
            </button>
          </div>
        </div>
      </div>
      <% }); %>
    </div>
  </section>



  <!-- Modal de detalles -->
  <div id="detailsModal" class="modal">
    <div class="modal-content">
      <button class="close-button">&times;</button>

      <div class="tabs">
        <button class="tab-button active" data-tab="detalles">
          <p>Detalles</p>
        </button>
        <button class="tab-button" data-tab="inmuebles">
          <p>Inmuebles</p>
        </button>
        <button class="tab-button" data-tab="cronograma">
          <p>Cronograma</p>
        </button>
      </div>

      <!-- Pestaña de detalles -->
      <div id="detalles" class="tab-content active">
        <div class="details-container">
          <% liveData.forEach((auction) => { %>
          <% if (auction.detalles && auction.detalles.length > 0) { %>
          <% auction.detalles.forEach(detalle => { %>
          <div class="details-column">
            <div class="detail-row"><strong>Expediente:</strong> <%= detalle.expediente %></div>
            <div class="detail-row"><strong>Distrito Judicial:</strong> <%= detalle.distrito_judicial %></div>
            <div class="detail-row"><strong>Órgano Jurisdiccional:</strong> <%= detalle.organo_juridiccional %></div>
            <div class="detail-row"><strong>Instancia:</strong> <%= detalle.instancia %></div>
            <div class="detail-row"><strong>Juez:</strong> <%= detalle.juez %></div>
            <div class="detail-row"><strong>Especialista:</strong> <%= detalle.especialista %></div>
            <div class="detail-row"><strong>Materia:</strong> <%= detalle.materia %></div>
            <div class="detail-row"><strong>Resolución:</strong> <%= detalle.resolucion %></div>
            <div class="detail-row"><strong>Fecha Resolución:</strong> <%= detalle.fecha_resolucion %></div>
            <div class="detail-row"><strong>Archivo:</strong> <%= detalle.archivo %></div>
         </div>
            <div class="detail-row"><strong>Convocatoria:</strong> <%= detalle.convocatoria %></div>
            <div class="detail-row"><strong>Tipo Cambio:</strong> <%= detalle.tipo_cambio%></div>
            <div class="detail-row"><strong>Tasación:</strong> <%= detalle.tasacion %></div>
            <div class="detail-row"><strong>Precio Base:</strong> <%= detalle.precio_base %></div>
            <div class="detail-row"><strong>Incremento entre ofertas:</strong> <%= detalle.incremento_ofertas %></div>
            <div class="detail-row"><strong>Arancel:</strong> <%= detalle.arancel %></div>
            <div class="detail-row"><strong>Oblaje:</strong> <%= detalle.oblaje %></div>
            <div class="detail-row"><strong>Descripción:</strong> <%= detalle.descripcion %></div>
            <div class="detail-row"><strong>N inscritos:</strong> <%= detalle.n_inscritos %></div>
          <% }); %>
          <% } else { %>
          <p>No hay detalles disponibles para esta subasta.</p>
          <% } %>
          <% }); %>
        </div>
      </div>



      <!-- Pestaña de Inmuebles -->
      <div id="inmuebles" class="tab-content">
        <div class="board">
          <div class="board-header">
            <h2>Inmuebles del Remate</h2>
          </div>
          <div class="board-table">
            <table>
              <thead>
                <tr>
                  <th>PARTIDA REGISTRAL</th>
                  <th>TIPO INMUEBLE</th>
                  <th>DIRECCIÓN</th>
                  <th>CARGA Y/O GRAVAMEN</th>
                  <th>PORCENTAJE A REMATAR</th>
                </tr>
              </thead>
              <tbody>
                <% liveData.forEach(auction => { %>
                <% if (auction.inmuebles && auction.inmuebles.length > 0) { %>
                <% auction.inmuebles.forEach(inmueble => { %>
                <tr>
                  <td><%= inmueble.partida_registral %></td>
                  <td><%= inmueble.tipo_inmueble %></td>
                  <td><%= inmueble.direccion %></td>
                  <td><%= inmueble.carga_ogravamen %></td>
                  <td><%= inmueble.porcentaje_rematar %>%</td>
                </tr>
                <% }); %>
                <% } else { %>
                <tr>
                  <td colspan="5">No hay inmuebles para este remate.</td>
                </tr>
                <% } %>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>
      </div>



      <!-- Pestaña de Cronograma -->
      <div id="cronograma" class="tab-content">
        <div class="board">
          <div class="board-header">
            <h2>Cronograma del Remate</h2>
          </div>
          <div class="board-table">
            <table>
              <thead>
                <tr>
                  <th>N°</th>
                  <th>FASE</th>
                  <th>FECHA INICIO</th>
                  <th>FECHA FIN</th>
                </tr>
              </thead>
              <tbody>
                <% liveData.forEach(auction => { %>
                <% auction.cronograma.forEach((fase, index) => { %>
                <tr>
                  <td><%= index + 1 %></td>
                  <td><%= fase.actividad %></td>
                  <td><%= fase.fecha_actividad %></td>
                  <td><%= fase.fecha_actividad %></td>
                </tr>
                <% }); %>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>

<!-- Modal de Seguimiento -->
<div id="trackingModal" class="modal">
  <div class="modal-content">
    <button class="close-button">&times;</button>
    <% liveData.forEach((auction) => { %>
      <% if (auction.seguimiento && auction.seguimiento.length > 0) { %>
        <% auction.seguimiento.forEach(detalle => { %>
          <div class="tracking-section">
            <h3><span class="red-dot"></span>DETALLE DE EXPEDIENTE</h3>
            <div class="tracking-row"><strong>N° Expediente:</strong> <%= detalle.n_expediente %></div>
            <div class="tracking-row"><strong>Distrito judicial:</strong> <%= detalle.didstrito_judicial %></div>
            <div class="tracking-row"><strong>Instancia:</strong> <%= detalle.instancia %></div>
            <div class="tracking-row"><strong>Especialidad:</strong> <%= detalle.especialidad %></div>
          </div>

          <div class="tracking-section">
            <h3><span class="red-dot"></span>DETALLE DE SEGUIMIENTO</h3>
            <div class="tracking-row"><strong>N° Convocatoria:</strong> <%= detalle.n_covocatoria %></div>
            <div class="tracking-row"><strong>Fecha de registro:</strong> <%= detalle.fecha_registro %></div>
            <div class="tracking-row"><strong>Procesado por:</strong> <%= detalle.procesado %></div>
            <div class="tracking-row"><strong>Fase convocatoria:</strong> <%= detalle.fase_convocatoria %></div>
            <div class="tracking-row"><strong>Estado convocatoria:</strong> <%= detalle.estado_convocatoria %></div>
            <div class="tracking-row"><strong>¿Reanudado?:</strong> <%= detalle.reanudado %></div>
          </div>
        <% }); %>
      <% } else { %>
        <p>No hay detalles disponibles para esta subasta.</p>
      <% } %>
    <% }); %>
  </div>
</div>


  <!-- Diseño live -->
  <link rel="stylesheet" href="/css/live/live.css">


  <script type="module">
    import { NetworkAnimationL } from '../../js/componentes/network.live.js';
  
    // Asegúrate de que el canvas exista antes de interactuar con él
    const canvas = document.getElementById('particleCanvas');
    if (canvas) {
      // Configuración inicial del canvas
      const resizeCanvas = () => {
        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;
      };
  
      // Redimensionar el canvas al tamaño de la ventana
      window.addEventListener('resize', resizeCanvas);
      resizeCanvas(); // Llamada inicial para establecer el tamaño
  
      // Crear la animación de la red
      const networkAnimationL = new NetworkAnimationL(canvas);
  
      // Inicializar y empezar la animación
      function animate() {
        networkAnimationL.update(); // Actualiza la animación
        networkAnimationL.render(); // Renderiza la animación
        requestAnimationFrame(animate); // Solicita el siguiente frame de animación
      }
  
      animate(); // Inicia la animación
    } else {
      console.error('No se encontró el canvas con el id "particleCanvas".');
    }
  </script>
  
  <!-- nabvar -->
  <script>
    let lastScrollTop = 0; // Posición previa del scroll
    const header = document.getElementById('header'); // Encabezado
    const propertyContainer = document.querySelector('.property-container'); // Contenedor de propiedades

    window.addEventListener('scroll', () => {
      const currentScrollTop = window.scrollY || document.documentElement.scrollTop;

      // Desaparece al bajar el scroll
      if (currentScrollTop > lastScrollTop && currentScrollTop > propertyContainer.offsetTop) {
        header.style.transform = 'translateY(-100%)'; // Desliza hacia arriba
        header.style.opacity = '0'; // Desvanece
      } else {
        // Aparece al subir el scroll
        header.style.transform = 'translateY(0)'; // Vuelve a su posición
        header.style.opacity = '1'; // Reaparece
      }

      lastScrollTop = currentScrollTop <= 0 ? 0 : currentScrollTop; // Evita valores negativos
    });
  </script>


  <!-- script live -->
  <script src="/js/script_live.js"></script>

</body>

</html>