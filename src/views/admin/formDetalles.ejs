<% remates.forEach(function(remate) { %>
  <div id="tarjetaDetalles" class="tarjeta_formulario_detalles" style="display: none">
    <h2 class="titulo_formulario_detalles">Detalles de Remate</h2>
    <form method="post" action="/admin/crear-detalles" id="formulario_detalles">
      <input type="hidden" name="remate_id" value="<%= remate.id %>">
  
      <!-- Expediente -->
      <div class="fila_campos_formulario_detalles">
        <div class="columna_campo_formulario_detalles">
          <div class="grupo_campo_formulario_detalles">
            <label for="expediente" class="etiqueta_campo_formulario_detalles">Expediente</label>
            <input type="text" id="expediente" name="expediente" class="entrada_texto_formulario_detalles" required>
          </div>
        </div>
  
        <!-- Distrito Judicial -->
        <div class="columna_campo_formulario_detalles">
          <div class="grupo_campo_formulario_detalles">
            <label for="distrito_judicial" class="etiqueta_campo_formulario_detalles">Distrito Judicial</label>
            <input type="text" id="distrito_judicial" name="distrito_judicial" class="entrada_texto_formulario_detalles" required>
          </div>
        </div>
      </div>
  
      <!-- Organo Jurisdiccional -->
      <div class="fila_campos_formulario_detalles">
        <div class="columna_campo_formulario_detalles">
          <div class="grupo_campo_formulario_detalles">
            <label for="organo_juridiccional" class="etiqueta_campo_formulario_detalles">Órgano Jurisdiccional</label>
            <input type="text" id="organo_juridiccional" name="organo_juridiccional" class="entrada_texto_formulario_detalles" required>
          </div>
        </div>
  
        <!-- Instancia -->
        <div class="columna_campo_formulario_detalles">
          <div class="grupo_campo_formulario_detalles">
            <label for="instancia" class="etiqueta_campo_formulario_detalles">Instancia</label>
            <input type="text" id="instancia" name="instancia" class="entrada_texto_formulario_detalles" required>
          </div>
        </div>
      </div>
  
      <!-- Juez -->
      <div class="fila_campos_formulario_detalles">
        <div class="columna_campo_formulario_detalles">
          <div class="grupo_campo_formulario_detalles">
            <label for="juez" class="etiqueta_campo_formulario_detalles">Juez</label>
            <input type="text" id="juez" name="juez" class="entrada_texto_formulario_detalles" required>
          </div>
        </div>
  
        <!-- Especialista -->
        <div class="columna_campo_formulario_detalles">
          <div class="grupo_campo_formulario_detalles">
            <label for="especialista" class="etiqueta_campo_formulario_detalles">Especialista</label>
            <input type="text" id="especialista" name="especialista" class="entrada_texto_formulario_detalles" required>
          </div>
        </div>
      </div>
  
      <!-- Materia -->
      <div class="fila_campos_formulario_detalles">
        <div class="columna_campo_formulario_detalles">
          <div class="grupo_campo_formulario_detalles">
            <label for="materia" class="etiqueta_campo_formulario_detalles">Materia</label>
            <input type="text" id="materia" name="materia" class="entrada_texto_formulario_detalles" required>
          </div>
        </div>
  
        <!-- Resolución -->
        <div class="columna_campo_formulario_detalles">
          <div class="grupo_campo_formulario_detalles">
            <label for="resolucion" class="etiqueta_campo_formulario_detalles">Resolución</label>
            <textarea id="resolucion" name="resolucion" class="entrada_texto_formulario_detalles" required></textarea>
          </div>
        </div>
      </div>
  
      <!-- Fecha Resolución -->
      <div class="fila_campos_formulario_detalles">
        <div class="columna_campo_formulario_detalles">
          <div class="grupo_campo_formulario_detalles">
            <label for="fecha_resolucion" class="etiqueta_campo_formulario_detalles">Fecha Resolución</label>
            <input type="date" id="fecha_resolucion" name="fecha_resolucion" class="entrada_fecha_formulario_detalles" required>
          </div>
        </div>
  
        <!-- Enlace PDF -->
        <div class="columna_campo_formulario_detalles">
          <div class="grupo_campo_formulario_detalles">
            <label for="archivo" class="etiqueta_campo_formulario_detalles">Enlace PDF</label>
            <input type="text" id="archivo" name="archivo" class="entrada_texto_formulario_detalles" required>
          </div>
        </div>
      </div>
  
      <!-- Convocatoria -->
      <div class="fila_campos_formulario_detalles">
        <div class="columna_campo_formulario_detalles">
          <div class="grupo_campo_formulario_detalles">
            <label for="nro_convocatoria" class="etiqueta_campo_formulario_detalles">Convocatoria</label>
            <input type="text" id="nro_convocatoria" name="nro_convocatoria" class="entrada_texto_formulario_detalles" required>
          </div>
        </div>
  
        <!-- Tipo Cambio -->
        <div class="columna_campo_formulario_detalles">
          <div class="grupo_campo_formulario_detalles">
            <label for="tipo_cambio" class="etiqueta_campo_formulario_detalles">Tipo Cambio</label>
            <input type="number" id="tipo_cambio" name="tipo_cambio" step="0.0001" class="entrada_numero_formulario_detalles" required>
          </div>
        </div>
      </div>
  
      <!-- Tasación -->
      <div class="fila_campos_formulario_detalles">
        <div class="columna_campo_formulario_detalles">
          <div class="grupo_campo_formulario_detalles">
            <label for="tasacion" class="etiqueta_campo_formulario_detalles">Tasación</label>
            <input type="number" id="tasacion" name="tasacion" step="0.01" class="entrada_numero_formulario_detalles" required>
          </div>
        </div>
  
        <!-- Precio Base -->
        <div class="columna_campo_formulario_detalles">
          <div class="grupo_campo_formulario_detalles">
            <label for="precio_base" class="etiqueta_campo_formulario_detalles">Precio Base</label>
            <input type="number" id="precio_base" name="precio_base" step="0.01" class="entrada_numero_formulario_detalles" required>
          </div>
        </div>
      </div>
  
      <!-- Incremento entre Ofertas -->
      <div class="fila_campos_formulario_detalles">
        <div class="columna_campo_formulario_detalles">
          <div class="grupo_campo_formulario_detalles">
            <label for="incremento_ofertas" class="etiqueta_campo_formulario_detalles">Incremento entre ofertas</label>
            <input type="number" id="incremento_ofertas" name="incremento_ofertas" step="0.01" class="entrada_numero_formulario_detalles" required>
          </div>
        </div>
  
        <!-- Arancel -->
        <div class="columna_campo_formulario_detalles">
          <div class="grupo_campo_formulario_detalles">
            <label for="arancel" class="etiqueta_campo_formulario_detalles">Arancel</label>
            <input type="number" id="arancel" name="arancel" step="0.01" class="entrada_numero_formulario_detalles" required>
          </div>
        </div>
      </div>
  
      <!-- Oblaje -->
      <div class="fila_campos_formulario_detalles">
        <div class="columna_campo_formulario_detalles">
          <div class="grupo_campo_formulario_detalles">
            <label for="oblaje" class="etiqueta_campo_formulario_detalles">Oblaje</label>
            <input type="number" id="oblaje" name="oblaje" step="0.01" class="entrada_numero_formulario_detalles" required>
          </div>
        </div>
  
        <!-- Descripción de Detalles -->
        <div class="columna_campo_formulario_detalles">
          <div class="grupo_campo_formulario_detalles">
            <label for="descripcion_de_detalles" class="etiqueta_campo_formulario_detalles">Descripción de Detalles</label>
            <textarea id="descripcion_de_detalles" name="descripcion_de_detalles" class="entrada_texto_formulario_detalles" required></textarea>
          </div>
        </div>
      </div>
  
      <!-- Botones -->
      <div class="contenedor_botones_formulario_detalles">
        <button type="button" class="boton_formulario_detalles boton_cancelar_formulario_detalles" onclick="cerrarModales()">Cancelar Registro</button>
        <button type="submit" class="boton_formulario_detalles boton_guardar_formulario_detalles">Guardar Detalles</button>
      </div>
    </form>
  </div>
  <% }); %>
  