<!-- Contenedor para el modal de método de pago -->
<div class="payment-modal-overlay" id="paymentModalOverlay">
  <div class="payment-modal-content">
    <%- include('../layouts/Metodopago') %>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const btnUnirse = document.getElementById('unirse');
    const chat = document.getElementById('auction-chat');
    const enCurso = document.getElementById('en_curso');
    const paymentModalOverlay = document.getElementById('paymentModalOverlay');
    const tabs = document.querySelectorAll('.active-tab');
    const contentSections = document.querySelectorAll('.active-content-section');

    function showDepositAlert() {
      return Swal.fire({
        title: 'Depósito requerido',
        text: 'Debes depositar 500 dólares para participar en 10 subastas.',
        showCancelButton: true,
        confirmButtonText: 'Ya deposité',
        cancelButtonText: 'No deposité',
        allowOutsideClick: false,
        allowEscapeKey: false,
      });
    }

    function checkOpportunities() {
      return fetch('/auctions/check-opportunities', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({ auctionId: '<%= auction.id %>' }),
      }).then(response => response.json())
        .catch(error => {
          console.error('Error al verificar validación:', error);
          Swal.fire({
            title: 'Error',
            text: 'Error al verificar validación',
            icon: 'error',
            allowOutsideClick: false,
            allowEscapeKey: false,
          });
        });
    }

    function handleDepositConfirmation(result) {
      if (result.isConfirmed) {
        checkOpportunities().then(data => {
          if (data.success) {
            enCurso.style.display = 'none';
            chat.style.display = 'block';
          } else {
            Swal.fire({
              title: 'Error',
              text: data.message,
              icon: 'error',
              allowOutsideClick: false,
              allowEscapeKey: false,
            }).then(() => {
              if (data.message === 'No estás validado para este remate') {
                paymentModalOverlay.style.display = 'flex';
              }
            });
          }
        });
      } else if (result.dismiss === Swal.DismissReason.cancel) {
        paymentModalOverlay.style.display = 'flex';
      }
    }

    btnUnirse.addEventListener('click', () => {
      Swal.fire({
        title: 'Términos y condiciones',
        html: `
          <input type="checkbox" id="termsCheckbox">
          <label for="termsCheckbox">He leído y acepto los términos y condiciones</label>
        `,
        showCancelButton: true,
        confirmButtonText: 'Continuar',
        cancelButtonText: 'Cancelar',
        allowOutsideClick: false,
        allowEscapeKey: false,
        preConfirm: () => {
          const termsCheckbox = document.getElementById('termsCheckbox');
          if (!termsCheckbox.checked) {
            Swal.showValidationMessage('Debes marcar la casilla de los términos y condiciones');
            return false;
          }
          return true;
        }
      }).then((result) => {
        if (result.isConfirmed) {
          showDepositAlert().then(handleDepositConfirmation);
        }
      });
    });

    const btnRetroceder = document.getElementById('retroceder');
    btnRetroceder.addEventListener('click', () => {
      paymentModalOverlay.style.display = 'none';
      Swal.fire({
        title: 'Términos y condiciones',
        html: `
          <input type="checkbox" id="termsCheckbox">
          <label for="termsCheckbox">He leído y acepto los términos y condiciones</label>
        `,
        showCancelButton: true,
        confirmButtonText: 'Continuar',
        cancelButtonText: 'Cancelar',
        allowOutsideClick: false,
        allowEscapeKey: false,
        preConfirm: () => {
          const termsCheckbox = document.getElementById('termsCheckbox');
          if (!termsCheckbox.checked) {
            Swal.showValidationMessage('Debes marcar la casilla de los términos y condiciones');
            return false;
          }
          return true;
        }
      }).then((result) => {
        if (result.isConfirmed) {
          showDepositAlert().then(handleDepositConfirmation);
        }
      });
    });

    function closePaymentModal() {
      paymentModalOverlay.style.display = 'none';
    }

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const tabId = tab.getAttribute('data-tab');
        tabs.forEach(t => t.classList.remove('active'));
        contentSections.forEach(cs => cs.classList.remove('active'));
        tab.classList.add('active');
        document.getElementById(tabId).classList.add('active');
      });
    });

    // Fetch top bids and update the classification table
    const auctionId = '<%= auction.id %>';
    fetch(`/auctions/${auctionId}/top-bids`)
      .then(response => response.json())
      .then(data => {
        const bidsTableBody = document.getElementById('bids-table-body');
        bidsTableBody.innerHTML = '';
        data.forEach((bid, index) => {
          const row = document.createElement('tr');
          let positionEmoji = '';
          if (index === 0) {
            positionEmoji = '👑';
          } else if (index === 1) {
            positionEmoji = '🥈';
          } else if (index === 2) {
            positionEmoji = '🥉';
          } else {
            positionEmoji = `${index + 1}`;
          }
          row.innerHTML = `
            <td class="position">${positionEmoji}</td>
            <td>${bid.usuario}</td>
            <td class="amount">USD$ ${bid.monto}</td>
          `;
          bidsTableBody.appendChild(row);
        });
      })
      .catch(error => {
        console.error('Error al obtener las mejores ofertas:', error);
      });
  });
</script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.1/moment.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script type="module">
  import { io } from "https://cdn.socket.io/4.3.2/socket.io.esm.min.js";

  const socket = io();
  const timerDisplay = document.getElementById("countdown-timer");
  const formBid = document.getElementById("form-bid");
  const inputBid = document.getElementById("input-bid");
  const recommendedInput = document.getElementById("recommended-bid");
  const recommendedButton = document.getElementById("recommended-submit-btn");
  const messages = document.getElementById("messages");
  const submitButton = document.getElementById("submit-btn");
  const auctionChat = document.getElementById("auction-chat1");

  let highestAmount = 0;
  const auctionId = <%- auction.id %>;
  const userId = "<%- user?.id || '0' %>";
  const userName = "<%- user?.usuario || 'Anónimo' %>";
  let auctionStartTime = null;

  // Unirse a la subasta
  socket.emit("join-auction", auctionId);

  // Cargar mensajes del historial
  socket.on("load-messages", (loadedMessages) => {
    messages.innerHTML = "";
    loadedMessages.forEach(({ monto, usuario }) => {
      addMessageToDOM(usuario, monto);
    });
    updateRecommendedAmount(); // Actualizar monto recomendado al cargar
    scrollToBottom();
  });

  // Actualización del temporizador
  socket.on("timer-update", (remaining) => {
    const hours = Math.floor(remaining / 3600);
    const minutes = Math.floor((remaining % 3600) / 60);
    const seconds = remaining % 60;

    timerDisplay.textContent = `${hours.toString().padStart(2, "0")}:${minutes
      .toString()
      .padStart(2, "0")}:${seconds.toString().padStart(2, "0")}`;

    if (remaining > 0) {
      auctionChat.style.display = "block";
      submitButton.disabled = false;
      recommendedButton.disabled = false;
    } else {
      auctionChat.style.display = "none";
      submitButton.disabled = true;
      recommendedButton.disabled = true;
    }

    // Comparar con la hora de inicio del remate
    const now = new Date();
    if (auctionStartTime && now < auctionStartTime) {
      timerDisplay.classList.add("countdown-red");
    } else {
      timerDisplay.classList.remove("countdown-red");
    }
  });

  // Escuchar nuevos mensajes del chat
  socket.on("chat-message", ({ monto, usuario, remates_id }) => {
    if (remates_id === auctionId) {
      addMessageToDOM(usuario, monto);
      updateRecommendedAmount(); // Actualizar monto recomendado
      scrollToBottom();
    }
  });

  // Formatear el número mientras el usuario escribe
  inputBid.addEventListener("input", (e) => {
    const value = e.target.value.replace(/,/g, "");
    if (!isNaN(value) && value !== "") {
      e.target.value = parseInt(value, 10).toLocaleString();
    } else {
      e.target.value = "";
    }
  });

  // Enviar oferta
  formBid.addEventListener("submit", async (e) => {
    e.preventDefault();
    const amount = Number.parseInt(inputBid.value.replace(/,/g, ""), 10);

    if (isNaN(amount) || amount <= 0) {
      showError("Entrada inválida", "Por favor, ingresa un monto válido.");
      return;
    }

    const minAmount = Math.max(highestAmount + 100, 0);
    if (amount < minAmount) {
      showError(
        "Oferta inválida",
        `La oferta debe ser mayor o igual a USD$${minAmount.toLocaleString()}.`
      );
      return;
    }

    Swal.fire({
      title: "¿Estás seguro?",
      text: `Estás a punto de ofertar USD$${amount.toLocaleString()}.`,
      icon: "warning",
      showCancelButton: true,
      confirmButtonColor: "#3085d6",
      cancelButtonColor: "#d33",
      confirmButtonText: "Sí, ofertar",
      cancelButtonText: "Cancelar",
    }).then((result) => {
      if (result.isConfirmed) {
        socket.emit("chat-message", {
          monto: amount,
          usuarios_id: userId,
          remates_id: auctionId,
        });
        inputBid.value = ""; // Limpiar el campo de entrada
      }
    });
  });

  // Actualizar monto recomendado
  function updateRecommendedAmount() {
    const recommendedAmount = Math.ceil(highestAmount + 100);
    recommendedInput.value = `USD$${recommendedAmount.toLocaleString()}`;
  }

  // Manejar botón de recomendación
  recommendedButton.addEventListener("click", () => {
    const recommendedAmount = recommendedInput.value.replace("USD$", "").replace(/,/g, "");
    inputBid.value = recommendedAmount;

    // Simular el envío del formulario
    const event = new Event('submit', { bubbles: true, cancelable: true });
    formBid.dispatchEvent(event);
  });

  // Agregar mensajes al DOM
  function addMessageToDOM(usuario, monto) {
    const isCurrentUser = usuario === userName;
    const messageClass = isCurrentUser ? "sent" : "received";
    messages.insertAdjacentHTML(
      "beforeend",
      `<li class="${messageClass}"><strong>${usuario}:</strong> USD$${parseInt(
        monto,
        10
      ).toLocaleString()}</li>`
    );
    if (monto > highestAmount) {
      highestAmount = monto;
      updateRecommendedAmount(); // Actualizar el monto recomendado
    }
  }

  // Mostrar errores con SweetAlert
  function showError(title, text) {
    Swal.fire({
      title,
      text,
      icon: "error",
      confirmButtonColor: "#3085d6",
      confirmButtonText: "Entendido",
    });
    submitButton.disabled = true;
    recommendedButton.disabled = true;
  }

  // Scroll automático al final del chat
  function scrollToBottom() {
    messages.scrollTop = messages.scrollHeight;
  }

  // Configurar la hora de inicio del remate
  socket.on("auction-start-time", (startTime) => {
    auctionStartTime = new Date(startTime);
  });
</script>



  
  





