<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Remates en Vivo</title>
  <!-- ESTILOS EN_VIVO -->
  <link rel="stylesheet" href="/css/en_vivo/en_vivo.css" />

  <!-- ICONOS -->
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/remixicon@4.5.0/fonts/remixicon.css" rel="stylesheet" />

  <!-- ESTILOS HEADER Y FOOTER  -->
  <link rel="stylesheet" href="/css/globales/globales.css" />
</head>

<body>
  <!-- HEADER -->
  <%- include('../partials/navbar.ejs') %>

  <!-- CANVAS -->
  <!--   <canvas id="background-canvas"></canvas> -->

  <!-- CONTENIDO PRINCIPAL -->
  <section class="property-container">
    <div class="auction-grid">
      <% if (enVivoData && enVivoData.length > 0) { %>
      <% enVivoData.forEach((auction) => { %>

      <div class="parent">
        <div class="div1 content_imagen_megusta">
          <div class="auction-image">
            <p class="auction-number">Remate N° <%= auction.id %></p>
            <img src="data:image/jpeg;base64,<%= auction.imagen %>" alt="Imagen no disponible" class="property-image" />
          </div>
        </div>
        <div class="div2 content_info_megusta">
          <div class="auction-content">
            <div class="auction-details">
              <p class="tipo_remate"><strong>TIPO DE REMATE:</strong> Judicial</p>
              <p class="lugar"><strong>LUGAR:</strong> <%= auction.ubicacion %> Perú</p>
            </div>

            <div class="auction-info">
              <h3>Presentación de Ofertas</h3>
              <p class="hora_remate">
                <i class="ri-calendar-line"></i>
                <%= new Date(auction.fecha_remate).toLocaleDateString('es-PE', {
                day: '2-digit',
                month: '2-digit',
                year: 'numeric'
                }) %>
              </p>
              <p class="hora_remate">
                <i class="ri-time-line"></i>
                <%= auction.hora_remate %>
              </p>
            </div>

            <div class="description-section">
              <h6>Descripción</h6>
              <p class="description-text"><%= auction.descripcion %></p>
            </div>

            <div class="price-section">
              <span class="price-label">Precio Base:</span>
              <p class="price-value">USD$ <%= auction.precios %></p>
            </div>
          </div>
        </div>

        <div class="div3 content_estado_megusta">
          <% if (auction.estado == 'finalizado') { %>
          <div class="contenedor-estado" style="background-color: red; color:white;">
            <div class="estadoActualSubasta <%= auction.clase %> text-light">
              <p class="text-uppercase fs-5"><strong><%= auction.estado %></strong></p>
              <p><%= auction.texto %></p>
            </div>
          </div>
          <% } else { %>
          <div class="contenedor-estado en-curso" style="background-color: green; color:white;">
            <div class="estadoActualSubasta <%= auction.clase %> text-light">
              <p class="text-uppercase fs-5"><strong><%= auction.estado %></strong></p>
              <p><%= auction.texto %></p>
            </div>
          </div>
          <% } %>
        </div>
        <!-- area botones -->
         <div class="contenedor-botones">
        <div class="div4 content_btn_chat">
          <a href="/auctions/<%= auction.id %>" class="action-btn">
            <i class="fas fa-sign-in-alt"></i> Ingresar
          </a>
        </div>
        <div class="div5 content_btn_bases_remate">
          <button type="button" class="action-btn seguimiento">
            <i class="fas fa-file-alt"></i> Bases de remate
          </button>
        </div>
        <div class="div6 content_btn_detalles">
          <a href="/en_vivo/detalles/<%= auction.id %>" class="action-btn detalles">
            <i class="fas fa-search-plus"></i> Detalles
          </a>
        </div>
        <div class="div7 content_btn_aviso">
          <a href="<%= auction.anexo || '#' %>"
            class="action-btn aviso <%= auction.anexo ? '' : 'disabled' %>" target="_blank">
            <i class="fas fa-bullhorn"></i> Aviso
          </a>
        </div>
        </div>
      </div>

      <% }); %>
      <% } else { %>
      <div class="no-results">
        <p>No se encontraron subastas en vivo.</p>
      </div>
      <% } %>
    </div>
  </section>

 <!-- Modal -->
 <div id="infoModal" class="modal">
  <div class="modal-content">
    <span class="close">&times;</span>

    <!-- Página 1 -->
    <div class="modal-page" data-page="1">
      <h2>Información del Remate</h2>
      <div class="section-header">
        <i class="ri-book-open-line"></i>
        <h3>Definiciones</h3>
      </div>
      <div class="definitions">
        <p><strong>ADJUDICADO:</strong> Postor ganador del lote en atención a su mejor oferta.</p>
        <p><strong>LOTE:</strong> Bien inmueble en el remate virtual.</p>
        <p><strong>OFERTA:</strong> Propuesta(s) de compra ingresadas en el portal de REMAJUD.</p>
        <p><strong>VENDEDOR:</strong> Empresa dueña de los activos, contrata a REMAJUD para llevar a cabo el servicio de
          venta por el portal.</p>
        <p><strong>PARTICIPANTE Y/O POSTOR:</strong> Usuario (persona natural o jurídica) que acepta los Términos y
          Condiciones para el remate virtual y realiza una o más ofertas en la plataforma de remates de REMAJUD.</p>
        <p><strong>USUARIO:</strong> Persona Individual, Persona Jurídica y/o Extranjero debidamente registrada en el
          sistema de REMAJUD.</p>
        <p><strong>PRECIO BASE:</strong> Todo lote o bien mostrado en la web, iniciará con un valor que no implica la
          aceptación de venta por parte del vendedor (EXISTE UN PRECIO DE RESERVA).</p>
      </div>
    </div>

    <!-- Página 2 -->
    <div class="modal-page" data-page="2" style="display: none;">
      <h2>Información del Remate</h2>
      <div class="section-header">
        <i class="ri-auction-line"></i>
        <h3>Durante el Remate</h3>
      </div>
      <div class="durante-remate">
        <p>El remate tendrá una fecha y horario previsto de cierre que se indica en el portal de REMAJUD (para tal
          efecto, existe un reloj en el Portal REMAJUD). REMAJUD se reserva el derecho de anular y/o aplazar el remate
          por inconvenientes técnicos que se puedan suscitar.</p>
        <ul>
          <li>Se recomienda a los interesados ingresar su oferta con un mínimo de 20 segundos antes que el reloj llegue a
            cero.</li>
          <li>Los ofertantes no podrán solicitar eliminar ofertas una vez ejecutadas en nuestro sistema.</li>
        </ul>
      </div>
    </div>

    <!-- Página 3 -->
    <div class="modal-page" data-page="3" style="display: none;">
      <h2>Información del Remate</h2>
      <div class="section-header">
        <i class="ri-line-chart-line"></i>
        <h3>Desarrollo de la Oferta "En Vivo"</h3>
      </div>
      <div class="desarrollo-oferta">
        <p>Todo usuario interesado en participar en una oferta "En vivo", reconoce y acepta que:</p>
        <ol>
          <li>Una oferta "En Vivo" se activa en la fecha en la que esta es publicada en el Portal, solo pudiéndose
            recibir ofertas durante el proceso "En Vivo" en la sala.</li>
          <li>El acceso a sala se habilita 12 horas antes de la hora de inicio programada, la misma que se indica en el
            detalle de la oferta. Es responsabilidad de cada participante acceder oportunamente.</li>
          <li>Llegada la hora de inicio, se validará que la cuota mínima de participación se cumpla para iniciar el
            proceso "En Vivo".</li>
        </ol>
      </div>
    </div>

    <!-- Página 4 -->
    <div class="modal-page" data-page="4" style="display: none;">
      <h2>Información del Remate</h2>
      <div class="section-header">
        <i class="ri-bank-card-line"></i>
        <h3>Pagos</h3>
      </div>
      <div class="pagos">
        <p>En caso de que se acepte la oferta del Mejor Ofertante y posterior al pago de la totalidad a EL VENDEDOR,
          REMAJUD procederá a facturar el 3% de garantía retenida como concepto de comisión de intermediación de la
          venta.</p>
        <p>El precio final del bien deberá pagarse a EL VENDEDOR, a más tardar, 48 horas posterior a la comunicación de
          REMAJUD, vía correo electrónico registrado del usuario ganador.</p>
        <p>El pago será mediante depósito, transferencia bancaria o Cheque de Gerencia a las siguientes cuentas:</p>
        <ul>
          <li>Banco: BANCO DE CRÉDITO DEL PERÚ</li>
          <li>Cuenta Corriente Soles:</li>
          <li>Código de Cuenta Interbancaria:</li>
          <li>Cuenta Corriente Dólares:</li>
          <li>Código de Cuenta Interbancaria:</li>
          <li>Titular:</li>
          <li>RUC:</li>
        </ul>
      </div>
    </div>

    <!-- Página 5 -->
    <div class="modal-page" data-page="5" style="display: none;">
      <h2>Información del Remate</h2>
      <div class="section-header">
        <i class="ri-error-warning-line"></i>
        <h3>Incumplimiento</h3>
      </div>
      <div class="incumplimiento">
        <p>Si el adjudicatario o ganador del lote desiste de su oferta terminada el remate, será retenido el 100% de la
          garantía, no será devuelta y quedará en poder de REMAJUD como penalidad por los perjuicios que se ocasionan en
          virtud de la retractación.</p>
      </div>
    </div>

    <div class="modal-navigation">
      <button class="nav-btn prev" id="prevBtn">Anterior</button>
      <button class="nav-btn next" id="nextBtn">Siguiente</button>
    </div>
  </div>
</div>


  <!-- SCRIPTS -->
  <script src="/js/script_en_vivo.js"></script>
  <script src="/js/componentes/uvcanvas_envivo.js"></script>

  <!-- Script para el header scroll -->
  <script>
    let lastScrollTop = 0;
    const header = document.getElementById("header");

    window.addEventListener("scroll", () => {
      const currentScrollTop = window.scrollY || document.documentElement.scrollTop;

      if (currentScrollTop > lastScrollTop) {
        header.style.transform = "translateY(-100%)";
        header.style.opacity = "0";
      } else {
        header.style.transform = "translateY(0)";
        header.style.opacity = "1";
      }

      lastScrollTop = currentScrollTop <= 0 ? 0 : currentScrollTop;
    });
  </script>

  <!-- modal -->
<script>
  // Funcionalidad del Modal
document.addEventListener('DOMContentLoaded', function() {
  const modal = document.getElementById('infoModal');
  const closeBtn = document.querySelector('.close');
  const prevBtn = document.getElementById('prevBtn');
  const nextBtn = document.getElementById('nextBtn');
  const pages = document.querySelectorAll('.modal-page');
  let currentPage = 1;

  // Actualizar los enlaces de bases de remate para abrir el modal
  const basesLinks = document.querySelectorAll('.action-btn.seguimiento');
  basesLinks.forEach(link => {
    link.addEventListener('click', function(e) {
      e.preventDefault();
      openModal();
    });
  });

  function openModal() {
    modal.style.display = 'block';
    document.body.style.overflow = 'hidden';
    updateNavigation();
  }

  function closeModal() {
    modal.style.display = 'none';
    document.body.style.overflow = 'auto';
    currentPage = 1;
    showPage(currentPage);
  }

  function showPage(pageNum) {
    pages.forEach(page => {
      page.style.display = 'none';
    });
    document.querySelector(`[data-page="${pageNum}"]`).style.display = 'block';
    updateNavigation();
  }

  function updateNavigation() {
    prevBtn.disabled = currentPage === 1;
    nextBtn.disabled = currentPage === pages.length;
    
    if (currentPage === pages.length) {
      nextBtn.style.opacity = '0.5';
      nextBtn.style.cursor = 'not-allowed';
    } else {
      nextBtn.style.opacity = '1';
      nextBtn.style.cursor = 'pointer';
    }
  }

  // Event Listeners
  closeBtn.addEventListener('click', closeModal);

  modal.addEventListener('click', function(e) {
    if (e.target === modal) {
      closeModal();
    }
  });

  prevBtn.addEventListener('click', function() {
    if (currentPage > 1) {
      currentPage--;
      showPage(currentPage);
    }
  });

  nextBtn.addEventListener('click', function() {
    if (currentPage < pages.length) {
      currentPage++;
      showPage(currentPage);
    }
  });

  // Navegación con teclado
  document.addEventListener('keydown', function(e) {
    if (modal.style.display === 'block') {
      if (e.key === 'Escape') {
        closeModal();
      } else if (e.key === 'ArrowLeft' && currentPage > 1) {
        currentPage--;
        showPage(currentPage);
      } else if (e.key === 'ArrowRight' && currentPage < pages.length) {
        currentPage++;
        showPage(currentPage);
      }
    }
  });
});
</script>


</body>

</html>