<style>
    /* ... (estilos CSS anteriores sin cambios) ... */

    .botones-container {
        display: flex;
        justify-content: space-between;
        margin-top: 1rem;
    }

    .boton-enviar-comprobante {
        color: rgb(0, 0, 0);
        text-decoration: none;
        font-size: 18px;
        border: none;
        background: none;
        font-weight: 600;
        font-family: 'Poppins', sans-serif;
        cursor: pointer;
        transition: color 0.3s ease;
    }

    .boton-enviar-comprobante::before {
        margin-left: auto;
    }

    .boton-enviar-comprobante::after,
    .boton-enviar-comprobante::before {
        content: '';
        width: 0%;
        height: 2px;
        background: #4CAF50;
        display: block;
        transition: 0.5s;
    }

    .boton-enviar-comprobante:hover::after,
    .boton-enviar-comprobante:hover::before {
        width: 100%;
    }

    .boton-enviar-comprobante:hover {
        color: #4CAF50;
    }

    /* Ajuste para el botón de retroceder */
    .botonsalir {
        margin-bottom: 0;
    }
</style>

<div class="payment-container">
    <div class="payment-tabs">
        <div class="tab active" data-tab="card">
            <span>💳</span>
            Tarjeta débito/crédito
        </div>
        <div class="tab" data-tab="yape">
            <span>📱</span>
            Yape
        </div>
    </div>

    <div class="payment-content">
        <div class="form-section card-section active">
            <h3>Información de Cuentas</h3>
            <div class="account-info">
                <div class="bank-account">
                    <h4>BCP</h4>
                    <p>CCI: 00219400212345678901</p>
                </div>
                <div class="bank-account">
                    <h4>Interbank</h4>
                    <p>CCI: 00319400212345678902</p>
                </div>
                <div class="bank-account">
                    <h4>BBVA</h4>
                    <p>CCI: 00119400212345678903</p>
                </div>
                <div class="bank-account">
                    <h4>Scotiabank</h4>
                    <p>CCI: 00919400212345678904</p>
                </div>
            </div>
        </div>

        <div class="form-section yape-section">
            <h3>Escanea el código QR</h3>
            <div class="qr-placeholder">
                <img class="imagen-yape-qr" src="/img/yape.jpg" alt="">
            </div>
            <p>Yape a: Montano Quispe Cleofer</p>
            <p>Monto: S/ 5000.00</p>
        </div>
