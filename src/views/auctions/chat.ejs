<!-- Chat (inicialmente oculto) -->
<div id="auction-chat1" class="chat" style="display: none;">
  <section id="chat">
    <!-- Contenedor de la barra de progreso -->
    <p class="fecha-subasta" id="countdown1">
      <span id="countdown-timer">00:00:00</span>
    </p>
    <p class="texto_comple">Incremento mínimo: 100 USD</p>
    <ul id="messages"></ul>

    <!-- Formulario de oferta -->
    <form id="form-bid" class="message-form">
      <!-- Input principal -->
      <div class="input-container">
        <input
          type="text"
          id="input-bid"
          class="input-field"
          placeholder="Escribe un monto"
          autocomplete="off"
          value="<%= auction.precios %>"
          pattern="\d*"
          title="Por favor, ingresa solo números." />
        <button
          type="submit"
          class="send-btn"
          id="submit-btn">
          Enviar
        </button>
      </div>
      <!-- Input recomendado -->
      <div id="enviar2" class="input-container">
        <input
          type="text"
          id="recommended-bid"
          class="input-field"
          readonly
          value="USD$<%= (auction.precios + 100).toLocaleString() %>" />
        <button
          type="button"
          class="send-btn"
          id="recommended-submit-btn">
          Enviar
        </button>
      </div>
    </form>
    <p class="texto_comple">Esperar la fecha y hora para poder ofertar</p>
  </section>
</div>




