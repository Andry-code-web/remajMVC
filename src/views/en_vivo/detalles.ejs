<!-- ICONOS -->
<link href="https://cdn.jsdelivr.net/npm/remixicon@4.5.0/fonts/remixicon.css" rel="stylesheet" />

<!-- ESTILOS HEADER Y FOOTER -->
<link rel="stylesheet" href="/css/globales/globales.css" />

<!-- ESTILOS TAGS -->
<link rel="stylesheet" href="/css/tags/tags.css" />

<!-- HEADER -->
<%- include('../partials/navbar.ejs') %>

<!-- CANVAS -->
<!-- <canvas id="background-canvas"></canvas>
 -->
<main class="main-wrapper">
  <div class="detalles-container">
    <div class="navigation-tabs">
      <a href="/en_vivo/detalles/<%= auctionId %>" class="tab-link active">Detalles</a>
      <a href="/en_vivo/inmuebles/<%= auctionId %>" class="tab-link">Inmuebles</a>
      <a href="/en_vivo/cronograma/<%= auctionId %>" class="tab-link">Cronograma</a>
    </div>
    <% if (detalles && detalles.length > 0) { %> <% detalles.forEach(detalle =>
    { %>
    <div class="detalles-table">
      <table>
        <tbody>
          <tr>
            <td class="label">Partida Registral:</td>
            <td class="value"><%= detalle.N_de_partida_registral %></td>
            <td class="label">Ciudad:</td>
            <td class="value"><%= detalle.distrito_judicial %></td>
          </tr>
          <tr>
            <td class="label">Distrito:</td>
            <td class="value"><%= detalle.distrito %></td>
            <td class="label">Gravamenes:</td>
            <td class="value"><%= detalle.gravámenes %></td>
          </tr>
          <tr>
            <td class="label">Convocatoria:</td>
            <td class="value"><%= detalle.nro_convocatoria %></td>
            <td class="label">Garantia:</td>
            <td class="value">
              USD <%= parseFloat(detalle.garantía).toLocaleString('es-ES', { minimumFractionDigits: 0, maximumFractionDigits: 0}) %>
            </td>
          </tr>
          <tr>
            <td class="label">Tasación:</td>
            <td class="value">
              USD <%= parseFloat(detalle.tasacion).toLocaleString('es-ES', { minimumFractionDigits: 0, maximumFractionDigits: 0}) %>
            </td>
            <td class="label">Precio Base:</td>
            <td class="value">
              USD <%= parseFloat(detalle.precio_base).toLocaleString('es-ES', { minimumFractionDigits: 0, maximumFractionDigits: 0}) %>
            </td>
          </tr>
          <tr>
            <td class="label">Incremento entre ofertas:</td>
            <td class="value">
              USD <%= parseFloat(detalle.incremento_ofertas).toLocaleString('es-ES', { minimumFractionDigits: 0, maximumFractionDigits: 0}) %>
            </td>
            <td class="label">Remate:</td>
            <td class="value"><%= detalle.remate %> EXTRAJUDICIAL</td>
          </tr>
          <tr>
            <td class="label">M<sup>2</sup>:</td>
            <td class="value"><%= detalle.tamano_propiedad %></td>
            <td class="label">N° inscritos:</td>
            <td class="value"><%= detalle.n_inscritos %></td>
          </tr>
          <tr>
            <td class="label">Descripción:</td>
            <td class="value" colspan="3">
              <%= detalle.descripcion_de_detalles %>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
    <% }); %> <% } else { %>
    <p class="no-data">No hay detalles disponibles.</p>
    <% } %>
    <a href="/" class="back-button">Volver a Remates</a>
  </div>
</main>

<!-- COMPONENTE FOOTER -->
<%- include('../partials/footer') %>

<!-- SCRIPT CANVAS -->
<script src="/js/componentes/uvcanvas_envivo.js"></script>

<!-- SCRIPT HEADER SCROLLL -->
<script>
  let lastScrollTop = 0;
  const header = document.getElementById("header");
  const detallesContainer = document.querySelector(".detalles-container");

  window.addEventListener("scroll", () => {
    const currentScrollTop =
      window.scrollY || document.documentElement.scrollTop;

    if (
      currentScrollTop > lastScrollTop &&
      currentScrollTop > detallesContainer.offsetTop
    ) {
      header.style.transform = "translateY(-100%)";
      header.style.opacity = "0";
    } else {
      header.style.transform = "translateY(0)";
      header.style.opacity = "1";
    }

    lastScrollTop = currentScrollTop <= 0 ? 0 : currentScrollTop;
  });
</script>